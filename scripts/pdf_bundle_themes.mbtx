// Bundle asciidoctor-pdf's themes (its data/themes/*.yml) in the PDF
// backend: writes pdf/theme/bundled.mbt, the YAML text of each theme as a
// raw multiline string, which the theme loader serves from its virtual
// `themes_dir`.
//
// Usage: moon run --target native scripts/pdf_bundle_themes.mbtx
// (the gem is read from $ASCIIDOCTOR_PDF_GEMS, else .repos/gems-pdf; see
// pdf/docs/oracle.md)
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
}

///|
let out : String = "pdf/theme/bundled.mbt"

///|
async fn main {
  let gems = match @env.get_env_var("ASCIIDOCTOR_PDF_GEMS") {
    Some(d) if d != "" => d
    _ => ".repos/gems-pdf"
  }
  let themes = "\{gems}/gems/asciidoctor-pdf-2.3.27/data/themes"
  let names = @fs.readdir(themes).filter(n => n.has_suffix("-theme.yml"))
  names.sort()
  let sb = StringBuilder()
  sb.write_string(
    "///|\n// Generated by scripts/pdf_bundle_themes.mbtx from asciidoctor-pdf 2.3.27's\n// data/themes; do not edit.\n\n",
  )
  sb.write_string(
    "///|\n/// The bundled themes: file name, YAML text.\nlet bundled_themes : Array[(String, String)] = [\n",
  )
  for name in names {
    let text = @fs.read_file("\{themes}/\{name}").text()
    sb.write_string("  (\n    \"\{name}\",\n    (\n")
    let lines = text.split("\n").map(l => l.to_owned()).collect()
    // the text ends with a newline: the last (empty) line is dropped, and
    // restored by the empty line written after the others
    if lines.length() > 0 && lines[lines.length() - 1] == "" {
      ignore(lines.pop())
    }
    for line in lines {
      sb.write_string("      #|\{line}\n")
    }
    sb.write_string("      #|\n    ),\n  ),\n")
  }
  sb.write_string("]\n")
  @fs.write_file(out, sb.to_string(), create_mode=CreateOrTruncate)
  println("wrote \{out} (\{names.length()} themes)")
}
