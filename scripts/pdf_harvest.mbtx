// Harvests PDF goldens from Ruby asciidoctor-pdf's own RSpec suite: runs the
// suite of the pinned release with scripts/pdf_harvest/harvest.rb loaded,
// which records every PDF conversion the specs perform (input, effective
// options, theme overrides, files read, log messages) and Ruby's PDF.
//
//   tests/pdf_golden/<spec>.jsonl   one record per conversion (committed)
//   tests/pdf_golden/record_counts.txt
//                                    records per spec file; a harvest that
//                                    yields fewer fails (committed)
//   tests/pdf_golden/summary.txt    harvest statistics (committed)
//   _build/pdf-spec-cache/pdfs/     Ruby's reference PDFs (not committed;
//                                    regenerated by this script)
//
// Replay them through the acceptance gate with
//   moon run --target native scripts/pdf_compare.mbtx -- --spec-goldens
//
// Sets up what it needs (see pdf/docs/oracle.md): the oracle's runtime gems
// (asciidoctor-pdf 2.3.27 and its dependencies at pinned versions) in
// .repos/gems-pdf, a shallow clone of asciidoctor-pdf at the release tag
// (.repos/asciidoctor-pdf-2.3.27; the spec suite is not part of the gem, and
// .repos/asciidoctor-pdf stays at its own pinned commit for the corpus
// scripts) and the spec dependencies at pinned versions in
// .repos/gems-pdf-spec.
//
// The run writes into a staging area (_build/pdf-spec-cache/staging) and
// replaces the committed records and the reference PDFs only once it is
// validated: it fails, leaving them as they were, if the RSpec run fails
// other than on the known environmental failures below, or if a spec file
// yields fewer records than record_counts.txt says (pass --update-counts
// after an intended change).
//
// Usage: moon run --target native scripts/pdf_harvest.mbtx -- [options] [spec/xxx_spec.rb...]
//   --update-counts   accept the record counts of this harvest
//   --ruby RUBY       the Ruby to run (default $ASCIIDOCTOR_PDF_RUBY, else
//                     Homebrew's Ruby on macOS when installed, else `ruby`
//                     on PATH); gems are installed with the `gem` next to it
//   --gems DIR        the oracle's gem home (default $ASCIIDOCTOR_PDF_GEMS,
//                     else .repos/gems-pdf)
//   --spec-gems DIR   the spec dependencies' gem home (default
//                     $ASCIIDOCTOR_PDF_SPEC_GEMS, else .repos/gems-pdf-spec)
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
/// The Ruby that runs the specs (see `configure`).
let ruby : Ref[String] = { val: "ruby" }

///|
/// The `gem` command of that Ruby.
let gem_cmd : Ref[String] = { val: "gem" }

///|
/// Where Ruby is installed when it is not on PATH as `ruby` (Homebrew's,
/// Apple silicon and Intel).
let ruby_candidates : Array[String] = [
  "/opt/homebrew/opt/ruby/bin/ruby", "/usr/local/opt/ruby/bin/ruby",
]

///|
let spec_repo : String = ".repos/asciidoctor-pdf-2.3.27"

///|
let spec_url : String = "https://github.com/asciidoctor/asciidoctor-pdf"

///|
let spec_tag : String = "v2.3.27"

///|
/// The commit v2.3.27 points to (the gem in .repos/gems-pdf is this release;
/// its lib/ and data/ are identical to the checkout's)
let spec_commit : String = "39a97554fbd2c27cdd919bde3091dc048b174ce6"

///|
/// The oracle's gem home, absolute (see `configure`).
let runtime_gems : Ref[String] = { val: ".repos/gems-pdf" }

///|
/// The spec dependencies' gem home, absolute (see `configure`).
let spec_gems : Ref[String] = { val: ".repos/gems-pdf-spec" }

///|
/// The oracle: asciidoctor-pdf 2.3.27 and its runtime dependencies, at the
/// versions the gem home the goldens were harvested with has (installed
/// 2026-09-29), and the syntax highlighters it loads when a document asks
/// for them (`source-highlighter`): rouge and pygments.rb, at the versions
/// of the spec gems (added 2026-10-02), so that scripts/pdf_compare.mbtx
/// can convert highlighted documents with the oracle.
let runtime_pinned : Array[(String, String)] = [
  ("Ascii85", "2.0.1"),
  ("addressable", "2.9.0"),
  ("afm", "1.0.0"),
  ("asciidoctor", "2.0.26"),
  ("asciidoctor-pdf", "2.3.27"),
  ("base64", "0.3.0"),
  ("bigdecimal", "4.1.3"),
  ("concurrent-ruby", "1.3.8"),
  ("css_parser", "1.22.0"),
  ("hashery", "2.1.2"),
  ("logger", "1.7.0"),
  ("matrix", "0.4.3"),
  ("pdf-core", "0.9.0"),
  ("pdf-reader", "2.16.0"),
  ("polyglot", "0.3.5"),
  ("prawn", "2.4.0"),
  ("prawn-icon", "3.0.0"),
  ("prawn-svg", "0.34.2"),
  ("prawn-table", "0.2.2"),
  ("prawn-templates", "0.1.2"),
  ("public_suffix", "7.0.5"),
  ("pygments.rb", "2.4.1"),
  ("rexml", "3.4.4"),
  ("rouge", "3.30.0"),
  ("treetop", "1.6.18"),
  ("ttfunk", "1.7.0"),
]

///|
/// The development dependencies of asciidoctor-pdf.gemspec and the Gemfile
/// that the specs load (rspec ~> 3.12.0, pdf-inspector ~> 1.3.0,
/// chunky_png ~> 1.4.0, coderay ~> 1.1.0, rouge ~> 3.0, text-hyphen,
/// open-uri-cached ~> 1.0.0), pinned to the versions they resolved to on
/// 2026-10-01, with their dependencies, and pygments.rb, which
/// asciidoctor-pdf's CI adds to the Gemfile (PYGMENTS_VERSION '~> 2.0'; it
/// bundles Pygments 2.15.1 and runs it with the `python3` on PATH).
/// pdf-reader comes from the runtime gems (2.16.0, a prawn-templates
/// dependency). harvest.rb activates rouge, coderay and pygments.rb, as
/// Bundler would, so that the specs that need them run.
let pinned_gems : Array[(String, String)] = [
  ("diff-lcs", "1.6.2"),
  ("rspec-support", "3.12.2"),
  ("rspec-core", "3.12.3"),
  ("rspec-expectations", "3.12.4"),
  ("rspec-mocks", "3.12.7"),
  ("rspec", "3.12.0"),
  ("pdf-inspector", "1.3.0"),
  ("chunky_png", "1.4.0"),
  ("coderay", "1.1.3"),
  ("rouge", "3.30.0"),
  ("pygments.rb", "2.4.1"),
  ("text-hyphen", "1.5.0"),
  ("open-uri-cached", "1.0.0"),
]

///|
/// Examples that fail in this environment for reasons unrelated to the
/// converter: the CLI specs run bin/asciidoctor-pdf in a subprocess and
/// expect empty stderr, but RubyGems warns there that the bigdecimal in the
/// runtime gems has no built extension. Their conversions are not recorded
/// anyway (subprocesses are not harvested). The example conversions
/// (cli_spec.rb:93 and :102, defined only when rouge is activated) fail in
/// that subprocess too, on stderr or (chronicles) on the exit status.
let known_failures : Array[String] = [
  "./spec/cli_spec.rb:13", "./spec/cli_spec.rb:57", "./spec/cli_spec.rb:69", "./spec/cli_spec.rb:93",
  "./spec/cli_spec.rb:102", "./spec/cli_spec.rb:147", "./spec/cli_spec.rb:162",
]

///|
let source_date_epoch : String = "1700000000"

///|
let golden_dir : String = "tests/pdf_golden"

///|
let pdf_cache : String = "_build/pdf-spec-cache/pdfs"

///|
/// Where a harvest is written before it is validated: `jsonl/` and `pdfs/`.
let staging : String = "_build/pdf-spec-cache/staging"

///|
let record_counts_path : String = "tests/pdf_golden/record_counts.txt"

///|
async fn exists(path : String) -> Bool {
  @fs.exists(path) catch {
    _ => false
  }
}

///|
/// `path` from the working directory `root`, unless absolute.
fn absolute(path : String, root : String) -> String {
  if path.has_prefix("/") {
    path
  } else {
    "\{root}/\{path}"
  }
}

///|
/// Set the Ruby and the gem homes from the flags, else the environment,
/// else the defaults (see the usage above). Returns the arguments left.
async fn configure(args : Array[String], root : String) -> Array[String] {
  let flags : Map[String, String] = Map([])
  let rest = []
  let mut i = 0
  while i < args.length() {
    match args[i] {
      "--ruby" | "--gems" | "--spec-gems" as flag if i + 1 < args.length() => {
        flags[flag] = args[i + 1]
        i += 1
      }
      arg => rest.push(arg)
    }
    i += 1
  }
  let setting = (flag : String, name : String) => match flags.get(flag) {
    Some(v) => Some(v)
    None =>
      match @env.get_env_var(name) {
        Some(v) if v != "" => Some(v)
        _ => None
      }
  }
  match setting("--ruby", "ASCIIDOCTOR_PDF_RUBY") {
    Some(r) => ruby.val = r
    None =>
      for candidate in ruby_candidates {
        if exists(candidate) {
          ruby.val = candidate
          break
        }
      }
  }
  // the gem command that belongs to that Ruby
  gem_cmd.val = match ruby.val.rev_find("/") {
    Some(i) if exists(ruby.val[:i].to_owned() + "/gem") =>
      ruby.val[:i].to_owned() + "/gem"
    _ => "gem"
  }
  runtime_gems.val = absolute(
    setting("--gems", "ASCIIDOCTOR_PDF_GEMS").unwrap_or(".repos/gems-pdf"),
    root,
  )
  spec_gems.val = absolute(
    setting("--spec-gems", "ASCIIDOCTOR_PDF_SPEC_GEMS").unwrap_or(
      ".repos/gems-pdf-spec",
    ),
    root,
  )
  rest
}

///|
async fn git(args : Array[String]) -> String {
  let (code, out, err) = @process.collect_output("git", args)
  if code != 0 {
    fail("git \{args.join(" ")}: \{err.text()}")
  }
  out.text().trim().to_owned()
}

///|
async fn ensure_spec_repo() -> Unit {
  if !exists(spec_repo) {
    println("clone \{spec_url} \{spec_tag} into \{spec_repo}")
    git([
      "clone", "--quiet", "--depth", "1", "--branch", spec_tag, spec_url, spec_repo,
    ])
    |> ignore
  }
  let head = git(["-C", spec_repo, "rev-parse", "HEAD"])
  if head != spec_commit {
    fail("\{spec_repo} is at \{head}, expected \{spec_tag} (\{spec_commit})")
  }
}

///|
/// Install the `pinned` gems missing from the gem home `dir` (each at its
/// version, without resolving dependencies: the list is complete).
async fn ensure_gems(dir : String, pinned : Array[(String, String)]) -> Unit {
  let installed = @fs.readdir("\{dir}/specifications") catch { _ => [] }
  let env = { "GEM_HOME": dir, "GEM_PATH": dir }
  for g in pinned {
    let (name, version) = g
    if installed.contains("\{name}-\{version}.gemspec") {
      continue
    }
    println("gem install \{name} \{version} into \{dir}")
    let code = @process.run(
      gem_cmd.val,
      [
        "install", "--no-document", "--ignore-dependencies", "--install-dir", dir,
        name, "-v", version,
      ],
      extra_env=env,
    )
    if code != 0 {
      fail("gem install failed: \{name} \{version}")
    }
  }
}

///|
/// `rspec ./spec/x_spec.rb:12 # description` lines of a failed run
fn failed_examples(output : String) -> Array[String] {
  let out = []
  for line in output.split("\n") {
    if line.has_prefix("rspec ./spec/") {
      let rest = line[6:].to_owned()
      let end = rest.find(" ").unwrap_or(rest.length())
      out.push(rest[:end].to_owned())
    }
  }
  out
}

///|
async fn read_counts() -> Map[String, Int] {
  let counts : Map[String, Int] = Map([])
  let text = @fs.read_file(record_counts_path).text() catch { _ => return counts }
  for line in text.split("\n") {
    if line.has_prefix("#") || line.trim() == "" {
      continue
    }
    let parts = line.split("\t").map(s => s.to_owned()).collect()
    if parts.length() == 2 {
      counts[parts[1]] = @string.parse_int(parts[0]) catch { _ => 0 }
    }
  }
  counts
}

///|
fn field(j : Json, key : String) -> Json {
  match j {
    Object(m) => m.get(key).unwrap_or(Json::null())
    _ => Json::null()
  }
}

///|
fn text_of(j : Json) -> String {
  match j {
    String(s) => s
    _ => ""
  }
}

///|
fn bump(m : Map[String, Int], key : String) -> Unit {
  m[key] = m.get(key).unwrap_or(0) + 1
}

///|
/// Code point order (`String::compare` orders by length first).
fn lexical(a : String, b : String) -> Int {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  for i in 0..<n {
    if a[i] != b[i] {
      return a[i].compare(b[i])
    }
  }
  a.length().compare(b.length())
}

///|
fn sorted_counts(m : Map[String, Int]) -> Array[(String, Int)] {
  let a = m.iter().collect()
  a.sort_by((x, y) => if x.1 != y.1 { y.1.compare(x.1) } else { lexical(x.0, y.0) })
  a
}

///|
async fn main {
  let root = @fs.realpath(".")
  let args = configure(@env.args()[1:].to_array().filter(a => a != "--"), root)
  let update_counts = args.contains("--update-counts")
  let specs = args.filter(a => !a.has_prefix("--"))
  ensure_gems(runtime_gems.val, runtime_pinned)
  ensure_spec_repo()
  let spec_root = @fs.realpath(spec_repo)
  let env = {
    "GEM_HOME": spec_gems.val,
    "GEM_PATH": "\{spec_gems.val}:\{runtime_gems.val}",
    "TZ": "UTC",
    "LANG": "en_US.UTF-8",
    // fixed document and PDF dates, so that a harvest is reproducible
    // (the specs that need other dates set their own)
    "SOURCE_DATE_EPOCH": source_date_epoch,
  }
  ensure_gems(spec_gems.val, pinned_gems)
  // everything goes to the staging area first; the committed records and
  // the reference PDFs are replaced once the harvest is validated
  let out_dir = "\{root}/\{staging}/jsonl"
  let staged_pdfs = "\{root}/\{staging}/pdfs"
  ignore(@process.run("rm", ["-rf", "\{root}/\{staging}"]))
  ignore(@process.run("mkdir", ["-p", out_dir, staged_pdfs]))
  let harvest_env = env.copy()
  harvest_env["PDF_HARVEST_SPEC_ROOT"] = spec_root
  harvest_env["PDF_HARVEST_OUT"] = out_dir
  harvest_env["PDF_HARVEST_PDFS"] = staged_pdfs
  harvest_env["PDF_HARVEST_GEMS"] = "\{@fs.realpath(runtime_gems.val)}:\{@fs.realpath(spec_gems.val)}"
  let rspec_args = [
    "\{spec_gems.val}/bin/rspec", "--require", "\{root}/scripts/pdf_harvest/harvest.rb",
    "--format", "progress", ..specs,
  ]
  println("$ rspec \{specs.join(" ")} (in \{spec_repo}, with \{ruby.val})")
  let (code, out) = @process.collect_output_merged(
    ruby.val,
    rspec_args,
    cwd=spec_root,
    extra_env=harvest_env,
  )
  let text = out.text()
  for line in text.split("\n") {
    if line.has_suffix("failures") || line.contains("failure,") ||
      line.contains("examples, ") ||
      line.has_prefix("Finished in") {
      println("  \{line}")
    }
  }
  if code != 0 {
    let failed = failed_examples(text)
    let unexpected = failed.filter(f => !known_failures.contains(f))
    if failed.is_empty() || !unexpected.is_empty() {
      println(text)
      fail(
        "rspec failed unexpectedly (exit \{code}): \{unexpected.join(" ")}; \{golden_dir} and \{pdf_cache} are unchanged",
      )
    }
    println("  \{failed.length()} known environmental failure(s) (cli_spec)")
  }
  // tally the staged records
  let run_info = @json.parse(@fs.read_file("\{out_dir}/.run.json").text())
  let files = @fs.readdir(out_dir, sort=true).filter(f => f.has_suffix(".jsonl"))
  let staged : Map[String, String] = Map([])
  let counts : Map[String, Int] = Map([])
  let skipped : Map[String, Int] = Map([])
  let vias : Map[String, Int] = Map([])
  let mut records = 0
  let mut themed = 0
  let mut replayable = 0
  let mut pdf_bytes = 0
  let mut ephemeral = 0
  for f in files {
    let data = @fs.read_file("\{out_dir}/\{f}").text()
    staged[f] = data
    let mut n = 0
    for line in data.split("\n") {
      if line.trim() == "" {
        continue
      }
      n += 1
      let rec = @json.parse(line.to_owned())
      let via = text_of(field(rec, "via"))
      bump(vias, via)
      match field(rec, "pdf") {
        Object(_) as p => pdf_bytes += (field(p, "size").as_number().unwrap_or(0.0)).to_int()
        _ => ()
      }
      let attrs = field(field(rec, "options"), "attributes")
      let theme = field(rec, "pdf_theme") != Json::null() ||
        field(attrs, "pdf-theme") != Json::null() ||
        field(attrs, "pdf-themesdir") != Json::null()
      if field(rec, "files") is Object(fs) &&
        fs.iter().any(kv => kv.1 is Object(e) && e.contains("content_base64")) {
        ephemeral += 1
      }
      match field(rec, "skip") {
        String(reason) => bump(skipped, reason)
        _ =>
          if theme {
            themed += 1
          } else {
            replayable += 1
          }
      }
    }
    records += n
    counts["\{golden_dir}/\{f}"] = n
  }
  // record-count guard, before anything is replaced
  let previous = read_counts()
  let shrunk = []
  for name, n in previous {
    // tests/pdf_golden/x_spec.jsonl holds the records of spec/x_spec.rb
    let spec_name = name.replace(old="\{golden_dir}/", new="").replace(old=".jsonl", new=".rb")
    let ran = specs.is_empty() || specs.iter().any(s => s.contains(spec_name))
    let now = counts.get(name).unwrap_or(0)
    if ran && now < n {
      shrunk.push("\{name}: \{now} < \{n}")
    }
  }
  if !shrunk.is_empty() && !update_counts && !previous.is_empty() {
    fail(
      "records disappeared: \{shrunk.join(", ")}; \{golden_dir} and \{pdf_cache} are unchanged (the harvest is in \{staging})",
    )
  }
  if records == 0 {
    fail("the harvest recorded nothing; \{golden_dir} and \{pdf_cache} are unchanged")
  }
  // validated: replace the records (a full run drops those of spec files
  // that no longer yield any) and the reference PDFs
  if specs.is_empty() {
    for f in (@fs.readdir(golden_dir) catch { _ => [] }) {
      if f.has_suffix(".jsonl") && !staged.contains(f) {
        @fs.remove("\{golden_dir}/\{f}")
      }
    }
  }
  for f, data in staged {
    @fs.write_file("\{golden_dir}/\{f}", data, create_mode=CreateOrTruncate)
  }
  if specs.is_empty() {
    ignore(@process.run("rm", ["-rf", pdf_cache]))
    ignore(@process.run("mkdir", ["-p", "_build/pdf-spec-cache"]))
    if @process.run("mv", [staged_pdfs, pdf_cache]) != 0 {
      fail("could not move \{staged_pdfs} to \{pdf_cache}")
    }
  } else {
    ignore(@process.run("mkdir", ["-p", pdf_cache]))
    for f in @fs.readdir(staged_pdfs) {
      if @process.run("mv", ["-f", "\{staged_pdfs}/\{f}", "\{pdf_cache}/\{f}"]) != 0 {
        fail("could not move \{staged_pdfs}/\{f} to \{pdf_cache}")
      }
    }
  }
  if update_counts || previous.is_empty() {
    // a full harvest replaces the counts, so a spec that lost all its
    // records drops out; a partial one merges into them
    let merged = if specs.is_empty() {
      Map([])
    } else {
      previous.copy()
    }
    for k, v in counts {
      merged[k] = v
    }
    let keys = merged.keys().collect()
    keys.sort_by(lexical)
    let lines = [
      "# Number of records in each PDF golden file; scripts/pdf_harvest.mbtx fails",
      "# if a harvest yields fewer. Refresh with `-- --update-counts`.",
    ]
    for k in keys {
      lines.push("\{merged.get(k).unwrap_or(0)}\t\{k}")
    }
    @fs.write_file(record_counts_path, lines.join("\n") + "\n", create_mode=CreateOrTruncate)
    println("wrote \{record_counts_path}")
  }
  let num = fn(key : String) { field(run_info, key).as_number().unwrap_or(0.0).to_int() }
  if specs.is_empty() {
    let lines = [
      "# PDF golden harvest of asciidoctor-pdf \{spec_tag} (\{spec_commit}) spec suite",
      "# Generated by scripts/pdf_harvest.mbtx; do not edit.",
      "",
      "spec examples run: \{num("examples")} (passed \{num("passed")}, failed \{num("failed")}, pending \{num("pending")})",
      "conversions recorded: \{records} in \{files.length()} spec files",
      "  expressible as input + options: \{replayable + themed}",
      "    of which with a pdf_theme option or pdf-theme/pdf-themesdir attribute: \{themed} (the replay also counts pdf-fontsdir and media=print/prepress as theme-dependent)",
      "  skipped (cannot be expressed as input + options): \{records - replayable - themed}",
      "records with spec-created files inlined: \{ephemeral}",
      "reference PDFs: \{pdf_bytes} bytes in \{pdf_cache} (not committed)",
      "",
      "skipped by reason:",
    ]
    for e in sorted_counts(skipped) {
      lines.push("  \{e.1}\t\{e.0}")
    }
    lines.push("")
    lines.push("conversions by entry point:")
    for e in sorted_counts(vias) {
      lines.push("  \{e.1}\t\{e.0}")
    }
    @fs.write_file("\{golden_dir}/summary.txt", lines.join("\n") + "\n", create_mode=CreateOrTruncate)
    println(lines.join("\n"))
  } else {
    println("\{records} conversions recorded (\{replayable} replayable, \{themed} theme-dependent)")
  }
  ignore(@process.run("rm", ["-rf", "\{root}/\{staging}"]))
}
