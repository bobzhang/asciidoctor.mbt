// Harvest the behavior of Ruby asciidoctor-pdf 2.3.27's theme loader as
// MoonBit tests for pdf/theme: runs scripts/pdf_theme/harvest.rb (every
// loader call of asciidoctor-pdf's spec/theme_loader_spec.rb, every bundled
// theme, every theme fixture of the spec and the YAML files of
// pdf/theme/testdata) and writes pdf/theme/harvest_test.mbt, one test per
// recorded call: the theme files it read, and the loaded theme's canonical
// dump (or that loading failed) and warnings, which the MoonBit loader must
// reproduce.
//
// Usage: moon run --target native scripts/pdf_theme_harvest.mbtx
//
// Ruby is $ASCIIDOCTOR_PDF_RUBY, else Homebrew's Ruby on macOS when
// installed, else `ruby` on PATH; the gems are $ASCIIDOCTOR_PDF_GEMS, else
// .repos/gems-pdf (scripts/pdf_harvest.mbtx installs them; see
// pdf/docs/oracle.md).
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
/// The Ruby that runs the oracle.
async fn ruby() -> String {
  match @env.get_env_var("ASCIIDOCTOR_PDF_RUBY") {
    Some(r) if r != "" => return r
    _ => ()
  }
  for candidate in [
    "/opt/homebrew/opt/ruby/bin/ruby", "/usr/local/opt/ruby/bin/ruby",
  ] {
    if (@fs.exists(candidate) catch { _ => false }) {
      return candidate
    }
  }
  "ruby"
}

///|
/// The gem home of the oracle, absolute.
async fn gems() -> String {
  let dir = match @env.get_env_var("ASCIIDOCTOR_PDF_GEMS") {
    Some(d) if d != "" => d
    _ => ".repos/gems-pdf"
  }
  @fs.realpath(dir) catch {
    _ => fail("no gems in \{dir}: run scripts/pdf_harvest.mbtx first")
  }
}

///|
let spec_dir : String = ".repos/asciidoctor-pdf/spec"

///|
let testdata : String = "pdf/theme/testdata"

///|
let jsonl : String = "_build/theme/harvest.jsonl"

///|
let out : String = "pdf/theme/harvest_test.mbt"

///|
/// A MoonBit string literal.
fn lit(s : String) -> String {
  let sb = StringBuilder()
  sb.write_char('"')
  for c in s {
    match c {
      '"' => sb.write_string("\\\"")
      '\\' => sb.write_string("\\\\")
      '\n' => sb.write_string("\\n")
      '\r' => sb.write_string("\\r")
      '\t' => sb.write_string("\\t")
      c if c.to_int() < 0x20 || c.to_int() == 0x7F =>
        sb.write_string("\\u{\{c.to_int().to_string(radix=16)}}")
      c => sb.write_char(c)
    }
  }
  sb.write_char('"')
  sb.to_string()
}

///|
fn str(j : Json) -> String? {
  match j {
    String(s) => Some(s)
    _ => None
  }
}

///|
fn field(j : Json, key : String) -> Json {
  match j {
    Object(m) => m.get(key).unwrap_or(Json::null())
    _ => Json::null()
  }
}

///|
/// The theming guide of asciidoctor-pdf, whose YAML examples are loaded too.
let docs : String = ".repos/asciidoctor-pdf/docs/modules/theme/pages"

///|
let docs_out : String = "_build/theme/docs"

///|
/// Write the YAML examples of the theming guide (`[,yaml]` listings, not
/// those with attribute substitutions) to `docs_out`, one theme file each
/// (`<page>-<n>-theme.yml`), callout marks removed; returns their paths.
async fn extract_doc_examples() -> Array[String] {
  ignore(@process.collect_output("rm", ["-rf", docs_out]))
  ignore(@process.collect_output("mkdir", ["-p", docs_out]))
  let paths = []
  let pages = @fs.readdir(docs).filter(n => n.has_suffix(".adoc"))
  pages.sort()
  for page in pages {
    let lines = @fs.read_file("\{docs}/\{page}").text().split("\n").map(l => l.to_owned()).collect()
    let mut n = 0
    let mut i = 0
    while i + 1 < lines.length() {
      if lines[i] == "[,yaml]" && lines[i + 1] == "----" {
        let body = []
        let mut j = i + 2
        while j < lines.length() && lines[j] != "----" {
          let mut line = lines[j]
          // a trailing callout: ` <1>`
          match line.rev_find(" <") {
            Some(k) if line.has_suffix(">") &&
              line[k + 2:line.length() - 1].iter().all(c => c >= '0' && c <= '9') =>
              line = line[:k].to_owned()
            _ => ()
          }
          body.push(line)
          j += 1
        }
        n += 1
        let path = "\{docs_out}/\{page[:page.length() - 5]}-\{n}-theme.yml"
        @fs.write_file(path, body.join("\n") + "\n", create_mode=CreateOrTruncate)
        paths.push(path)
        i = j
      }
      i += 1
    }
  }
  paths
}

///|
async fn main {
  ignore(@process.collect_output("mkdir", ["-p", "_build/theme"]))
  let extras = @fs
    .readdir(testdata)
    .filter(n => n.has_suffix(".yml"))
    .map(n => "\{testdata}/\{n}")
  extras.sort()
  extras.append(extract_doc_examples())
  let gems = gems()
  let env = { "GEM_HOME": gems, "GEM_PATH": gems }
  let args = ["scripts/pdf_theme/harvest.rb", spec_dir, jsonl]
  args.append(extras)
  let (code, stdout, stderr) = @process.collect_output(ruby(), args, extra_env=env)
  if code != 0 {
    println(stdout.text() + stderr.text())
    fail("harvest.rb failed (exit \{code})")
  }
  let lines = @fs.read_file(jsonl).text().split("\n").map(l => l.to_owned())
  let sb = StringBuilder()
  sb.write_string(
    "///|\n// Generated by scripts/pdf_theme_harvest.mbtx from Ruby asciidoctor-pdf\n// 2.3.27's theme loader (scripts/pdf_theme/harvest.rb); do not edit.\n",
  )
  let seen : Map[String, Int] = Map([])
  let mut count = 0
  for line in lines {
    if line.trim() == "" {
      continue
    }
    let record = @json.parse(line)
    let mut name = str(field(record, "name")).unwrap_or("?")
    let n = seen.get(name).unwrap_or(0)
    seen[name] = n + 1
    if n > 0 {
      name = "\{name} (\{n + 1})"
    }
    let kind = str(field(record, "kind")).unwrap_or("?")
    let call_args = match field(record, "args") {
      Array(items) =>
        items.map(a => match str(a) {
          Some(s) => "Some(\{lit(s)})"
          None => "None"
        })
      _ => []
    }
    let files = match field(record, "files") {
      Object(m) => {
        let parts = []
        for k, v in m {
          parts.push("(\{lit(k)}, \{lit(str(v).unwrap_or(""))})")
        }
        parts
      }
      _ => []
    }
    let expected = match str(field(record, "dump")) {
      Some(d) => "Some(\{lit(d)})"
      None => "None"
    }
    let warnings = match field(record, "warnings") {
      Array(items) => items.map(w => lit(str(w).unwrap_or("")))
      _ => []
    }
    sb.write_string("\n///|\ntest \{lit("ruby: " + name)} {\n")
    sb.write_string("  check_case(\n")
    sb.write_string("    \{lit(kind)},\n")
    sb.write_string("    [\{call_args.join(", ")}],\n")
    sb.write_string("    [\{files.join(", ")}],\n")
    sb.write_string("    \{expected},\n")
    sb.write_string("    [\{warnings.join(", ")}],\n")
    sb.write_string("  )\n}\n")
    count += 1
  }
  @fs.write_file(out, sb.to_string(), create_mode=CreateOrTruncate)
  println("wrote \{out} (\{count} cases)")
}
