// Regenerates the golden fixtures in tests/golden/ by running the upstream
// Ruby test suite with scripts/harvest/harvest.rb loaded.
// Requires Ruby with minitest and nokogiri (and python3 for pygments.rb);
// installs rouge/coderay/asciimath, pygments.rb
// and the template engines used by converter_test.rb (tilt/haml/slim/erubi)
// into .repos/gems on first use.
//
// Fails if an upstream test file fails (non-zero exit) under the harvester.
// After harvesting, refresh tests/golden/record_counts.txt with
// `_build/native/debug/build/cmd/golden/golden.exe --update-counts`.
//
// Usage: moon run --target native scripts/harvest.mbtx -- [test/xxx_test.rb...]
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/core/env",
}

///|
let gems : Array[(String, String)] = [
  ("rouge-", "rouge:~>3.0"),
  ("coderay-", "coderay:~>1.1.0"),
  ("asciimath-", "asciimath:~>2.0"),
  ("tilt-", "tilt:~>2.6.0"),
  ("haml-", "haml:~>6.3.0"),
  ("slim-", "slim:~>5.2.1"),
  ("erubi-", "erubi:~>1.10"),
  ("concurrent-ruby-", "concurrent-ruby:~>1.1"),
  ("open-uri-cached-", "open-uri-cached:~>1.0.0"),
]

///|
/// pygments.rb for the Pygments tests (they only run when PYGMENTS_VERSION is
/// set). 5.0.0 is the latest release; it vendors Python Pygments 2.20.0 and
/// runs `python3` (>= 3.9). Installed with --force because its gemspec asks
/// for Ruby >= 2.7 while it works on the Ruby 2.6 that macOS ships.
let pygments_rb_version : String = "5.0.0"

///|
/// The Python Pygments release bobzhang/pygments ports. It is installed from
/// PyPI into .repos/python and used instead of the vendored copy (see
/// scripts/harvest/pygments_path.rb), so the oracle runs exactly the ported
/// release (2.21 renders quotes literally and changed the monokai colors).
let python_pygments_version : String = "2.21.0"

///|
/// Installs Python Pygments for pygments.rb if needed and returns the
/// directory to use as PYGMENTS_PATH.
async fn install_python_pygments(root : String) -> String {
  let dir = "\{root}/.repos/python/pygments-\{python_pygments_version}"
  if !(@fs.exists("\{dir}/pygments") catch { _ => false }) {
    let code = @process.run("python3", [
      "-m", "pip", "install", "--no-deps", "--target", dir, "pygments==\{python_pygments_version}",
    ])
    if code != 0 {
      fail("pip install failed: pygments==\{python_pygments_version}")
    }
  }
  dir
}

///|
/// Upstream tests that fail with current Pygments releases because they
/// assert the output of older ones (whitespace tokens, the table layout of
/// line numbers, colors of the default style, escaped quotes). The documents
/// are recorded all the same; Ruby's output is the oracle.
let known_upstream_failures : Array[String] = [
  "TestPygments#test_should_not_hardcode_inline_styles_on_lineno_div_and_pre_elements_when_linenums_are_enabled_in_table_mode",
  "TestPygments#test_should_restore_callout_marks_to_correct_lines_if_table_line_numbering_is_enabled",
  "TestPygments#test_should_gracefully_fallback_to_default_style_if_specified_style_not_recognized",
  "TestPygments#test_should_restore_isolated_callout_mark_on_last_line_of_source",
  "TestPygments#test_should_line_highlight_specified_lines",
]

///|
/// The failed or errored tests of a minitest run (`Class#test_name`, without
/// the enclosing modules).
fn failed_tests(output : String) -> Array[String] {
  let lines = output.split("\n").map(l => l.to_owned()).collect()
  let names = []
  for i, line in lines {
    if (line.has_suffix(") Failure:") || line.has_suffix(") Error:")) &&
      i + 1 < lines.length() {
      let next = lines[i + 1]
      let end = next.find(" [").unwrap_or(next.length())
      let full = next.unsafe_substring(start=0, end~)
      let start = match full.rev_find("::") {
        Some(j) => j + 2
        None => 0
      }
      names.push(full.unsafe_substring(start~, end=full.length()))
    }
  }
  names
}

///|
async fn main {
  let root = @fs.realpath(".")
  let up = @fs.realpath("\{root}/.repos/asciidoctor")
  let gem_home = "\{root}/.repos/gems"
  let (_, gempath, _) = @process.collect_output("gem", ["env", "gempath"])
  let env = {
    "GEM_HOME": gem_home,
    "GEM_PATH": "\{gem_home}:\{gempath.text().trim().to_owned()}",
    "SOURCE_DATE_EPOCH": "1700000000",
    "TZ": "UTC",
    "PYGMENTS_VERSION": pygments_rb_version,
    "ORACLE_PYGMENTS_PATH": install_python_pygments(root),
  }
  let installed = @fs.readdir("\{gem_home}/gems") catch { _ => [] }
  let missing = gems
    .filter(g => !installed.iter().any(i => i.has_prefix(g.0)))
    .map(g => g.1)
  if !missing.is_empty() {
    let code = @process.run(
      "gem",
      ["install", "--no-document", ..missing],
      extra_env=env,
    )
    if code != 0 {
      fail("gem install failed: \{missing.join(" ")}")
    }
  }
  if !installed.contains("pygments.rb-\{pygments_rb_version}") {
    let code = @process.run(
      "gem",
      [
        "install", "--no-document", "--force", "pygments.rb", "-v", pygments_rb_version,
      ],
      extra_env=env,
    )
    if code != 0 {
      fail("gem install failed: pygments.rb \{pygments_rb_version}")
    }
  }
  @fs.mkdir("\{root}/tests/golden", recursive=true, allow_exist=true)
  let args = @env.args()[1:].to_owned().filter(a => a != "--")
  let tests = if args.is_empty() {
    @fs.readdir("\{up}/test", sort=true).filter(n => n.has_suffix("_test.rb")).map(n => "test/\{n}")
  } else {
    args
  }
  let failed = []
  for t in tests {
    let name = t.rev_find("/").map(i => t.unsafe_substring(start=i + 1, end=t.length())).unwrap_or(t)
    let name = name.unsafe_substring(start=0, end=name.length() - "_test.rb".length())
    let test_env = env.copy()
    test_env["HARVEST_OUT"] = "\{root}/tests/golden/\{name}.jsonl"
    let (code, out) = @process.collect_output_merged(
      "ruby",
      ["-Ilib", "-Itest", "-r\{root}/scripts/harvest/harvest.rb", t],
      cwd=up,
      extra_env=test_env,
    )
    let text = out.text()
    let summary = text.split("\n").filter(l => l.contains("runs,")).map(l => l.to_owned()).collect()
    println("\{name}: \{summary.join(" ")}")
    if code != 0 {
      let failures = failed_tests(text)
      let unknown = failures.filter(f => !known_upstream_failures.contains(f))
      if failures.is_empty() || !unknown.is_empty() {
        println(text)
        failed.push("\{name} (exit \{code})")
      } else {
        println(
          "\{name}: \{failures.length()} known upstream failure(s) (Pygments version)",
        )
      }
    }
  }
  if !failed.is_empty() {
    fail("upstream tests failed under the harvester: \{failed.join(", ")}")
  }
}
