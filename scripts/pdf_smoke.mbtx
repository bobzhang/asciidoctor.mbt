// Smoke test of the asciidoctor-pdf commands (CI): converts sample documents
// with the native release build and the wasm release build (run with
// moonrun, as moonx does), with no font directory, and checks that each
// output is a well-formed PDF (header, trailer, cross-reference offset,
// page count) — and, when poppler's pdfinfo is installed, that pdfinfo
// accepts it. Also checks `--version` against pdf/moon.mod, `-o -`, standard
// input, the exit code of a bad option, and source highlighting with Rouge
// (both commands) and Pygments (cmd/asciidoctor-pdf-pygments only), down to
// the colour and font of a keyword.
//
// Usage (after `moon -C pdf build --release --target native` and
// `--target wasm`):
//   moon run --target native scripts/pdf_smoke.mbtx [-- --native-only]
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/core/env",
  "moonbitlang/core/cmp",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/pdflite@0.3.1",
}

///|
/// The PDF with its streams decompressed (the page content readable), or
/// None when pdflite cannot read it.
fn decompressed(data : Bytes) -> Bytes? {
  let document = @pdflite.pdf_read_document_from_bytes(data).decompress() catch {
    _ => return None
  }
  let bytes = @pdflite.pdf_write_document(document) catch {
    _ => return None
  }
  Some(bytes)
}

///|
/// Whether the PDF of `file` sets text in `font` (a face it embeds) and
/// fills with `color` (a page content `r g b rg` operator, decompressed);
/// the problem, if any.
async fn token_style_problem(
  file : String,
  font : String,
  color : String,
) -> String? {
  let data = @fs.read_file(file).binary() catch {
    _ => return Some("no output")
  }
  guard find(data, "+\{font}") is Some(_) else {
    return Some("no \{font} font")
  }
  guard decompressed(data) is Some(content) else {
    return Some("pdflite cannot read it")
  }
  guard find(content, "\{color} rg") is Some(_) else {
    return Some("no \{color} rg fill")
  }
  None
}

///|
/// The native executable of a command (`asciidoctor-pdf`, or
/// `asciidoctor-pdf-pygments`, the command with Pygments).
fn bin(command : String) -> String {
  "pdf/_build/native/release/build/bobzhang/asciidoctor-pdf/cmd/\{command}/\{command}.exe"
}

///|
/// The wasm module of a command.
fn wasm_file(command : String) -> String {
  "pdf/_build/wasm/release/build/bobzhang/asciidoctor-pdf/cmd/\{command}/\{command}.wasm"
}

///|
let out_dir : String = "_build/pdf-smoke"

///|
let failures : Array[String] = []

///|
fn check(what : String, ok : Bool, detail? : String = "") -> Unit {
  if ok {
    println("ok    \{what}")
  } else {
    println("FAIL  \{what} \{detail}")
    failures.push(what)
  }
}

///|
fn find(data : Bytes, needle : String) -> Int? {
  let n = needle.length()
  for i in 0..<(data.length() - n + 1) {
    let mut j = 0
    while j < n && data[i + j].to_int() == needle[j].to_int() {
      j += 1
    }
    if j == n {
      return Some(i)
    }
  }
  None
}

///|
fn rfind(data : Bytes, needle : String) -> Int? {
  let n = needle.length()
  for i = data.length() - n; i >= 0; i = i - 1 {
    let mut j = 0
    while j < n && data[i + j].to_int() == needle[j].to_int() {
      j += 1
    }
    if j == n {
      return Some(i)
    }
  }
  None
}

///|
/// Whether the bytes are a well-formed PDF: `%PDF-` header, `%%EOF`
/// trailer, a `startxref` offset that points at the cross-reference table
/// or stream, and at least one page. Returns the problem, if any.
fn pdf_problem(data : Bytes) -> String? {
  if data.length() < 64 || find(data[:8].to_owned(), "%PDF-") is None {
    return Some("no %PDF- header")
  }
  guard rfind(data, "%%EOF") is Some(_) else { return Some("no %%EOF") }
  guard rfind(data, "startxref") is Some(s) else {
    return Some("no startxref")
  }
  let mut i = s + 9
  while i < data.length() && (data[i] == b'\n' || data[i] == b'\r') {
    i += 1
  }
  let mut offset = 0
  while i < data.length() && data[i] >= b'0' && data[i] <= b'9' {
    offset = offset * 10 + (data[i].to_int() - '0'.to_int())
    i += 1
  }
  guard offset > 0 && offset < data.length() else {
    return Some("startxref offset \{offset} out of range")
  }
  let at = data[offset:@cmp.minimum(offset + 32, data.length())].to_owned()
  // a classic table (`xref`) or a stream object (`N 0 obj`)
  if find(at, "xref") is None && find(at, " obj") is None {
    return Some("startxref does not point at a cross-reference section")
  }
  if find(data, "/Type /Page") is None && find(data, "/Type/Page") is None {
    return Some("no page")
  }
  None
}

///|
async fn pdfinfo_available() -> Bool {
  let (code, _, _) = @process.collect_output("pdfinfo", ["-v"]) catch {
    _ => return false
  }
  code == 0
}

///|
/// Runs the command (`wasm`: through moonrun) and returns its exit code,
/// stdout and stderr.
async fn run_cli(
  args : Array[String],
  wasm~ : Bool,
  command? : String = "asciidoctor-pdf",
  stdin? : String,
) -> (Int, Bytes, String) {
  let (cmd, argv) = if wasm {
    ("moonrun", [wasm_file(command), "--", ..args])
  } else {
    (bin(command), args)
  }
  let (code, out, err) = match stdin {
    Some(file) => @process.collect_output(cmd, argv, stdin=@process.redirect_from_file(file))
    None => @process.collect_output(cmd, argv)
  }
  (code, out.binary(), err.text())
}

///|
async fn convert(
  label : String,
  args : Array[String],
  output : String,
  wasm~ : Bool,
  check_pdfinfo~ : Bool,
  command? : String = "asciidoctor-pdf",
) -> Unit {
  let (code, _, err) = run_cli(["-o", output, ..args], wasm~, command~)
  check("\{label}: exit 0", code == 0, detail=err)
  let data = @fs.read_file(output).binary() catch {
    _ => {
      check("\{label}: output written", false)
      return
    }
  }
  let problem = pdf_problem(data)
  check("\{label}: valid PDF (\{data.length()} bytes)", problem is None, detail=problem.unwrap_or(""))
  if check_pdfinfo {
    let (code, out, err) = @process.collect_output("pdfinfo", [output])
    check("\{label}: pdfinfo accepts it", code == 0, detail=err.text() + out.text())
  }
}

///|
/// The `version` of pdf/moon.mod.
async fn module_version() -> String {
  for line in @fs.read_file("pdf/moon.mod").text().split("\n") {
    let line = line.trim()
    if line.has_prefix("version") {
      match line.find("\"") {
        Some(i) => {
          let rest = line[i + 1:]
          match rest.find("\"") {
            Some(j) => return rest[:j].to_owned()
            None => ()
          }
        }
        None => ()
      }
    }
  }
  ""
}

///|
async fn main {
  let native_only = @env.args().contains("--native-only")
  @fs.mkdir(out_dir, recursive=true) catch {
    _ => ()
  }
  let check_pdfinfo = pdfinfo_available()
  println("pdfinfo: \{if check_pdfinfo { "available" } else { "not installed" }}")
  let small = "\{out_dir}/small.adoc"
  @fs.write_file(
    small,
    "= Smoke Test\n:icons: font\n\nHello, *PDF*. icon:heart[]\n\nNOTE: Fonts are bundled.\n",
    create_mode=CreateOrTruncate,
  )
  let version = module_version()
  for wasm in [false, true] {
    if wasm && native_only {
      continue
    }
    let tag = if wasm { "wasm" } else { "native" }
    let (code, out, _) = run_cli(["--version"], wasm~)
    let text = @utf8.decode_lossy(out)
    check(
      "\{tag}: --version names \{version}",
      code == 0 && text.has_prefix("Asciidoctor PDF \{version} "),
      detail=text,
    )
    let (code, _, err) = run_cli(["--no-such-option"], wasm~)
    check(
      "\{tag}: a bad option exits 1",
      code == 1 && err.contains("invalid option"),
      detail=err,
    )
    convert(
      "\{tag} sampler",
      ["pdf/tests/sampler.adoc"],
      "\{out_dir}/\{tag}-sampler.pdf",
      wasm~,
      check_pdfinfo~,
    )
    convert(
      "\{tag} icons=font",
      [small],
      "\{out_dir}/\{tag}-small.pdf",
      wasm~,
      check_pdfinfo~,
    )
    convert(
      "\{tag} default-sans",
      ["--theme", "default-sans", small],
      "\{out_dir}/\{tag}-sans.pdf",
      wasm~,
      check_pdfinfo~,
    )
    convert(
      "\{tag} default-with-font-fallbacks",
      ["--theme", "default-with-font-fallbacks", "pdf/tests/theme-fallbacks.adoc"],
      "\{out_dir}/\{tag}-fallbacks.pdf",
      wasm~,
      check_pdfinfo~,
    )
    // source highlighting: Rouge in both commands, Pygments in the one with
    // Pygments (the other sets those listings as they are, and says so)
    convert(
      "\{tag} rouge",
      ["pdf/tests/source-rouge.adoc"],
      "\{out_dir}/\{tag}-rouge.pdf",
      wasm~,
      check_pdfinfo~,
    )
    let (code, _, err) = run_cli(
      ["-o", "\{out_dir}/\{tag}-no-pygments.pdf", "pdf/tests/source-pygments.adoc"],
      wasm~,
    )
    check(
      "\{tag} pygments without Pygments: converted, reported unsupported",
      code == 0 && err.contains("UNSUPPORTED attribute source-highlighter=pygments"),
      detail=err,
    )
    let pygments = "asciidoctor-pdf-pygments"
    let (code, out, _) = run_cli(["--version"], wasm~, command=pygments)
    let text = @utf8.decode_lossy(out)
    check(
      "\{tag} \{pygments}: --version names \{version}",
      code == 0 && text.has_prefix("Asciidoctor PDF \{version} "),
      detail=text,
    )
    convert(
      "\{tag} \{pygments}",
      ["pdf/tests/source-pygments.adoc"],
      "\{out_dir}/\{tag}-pygments.pdf",
      wasm~,
      check_pdfinfo~,
      command=pygments,
    )
    let (_, _, err) = run_cli(
      ["-o", "\{out_dir}/\{tag}-pygments-2.pdf", "pdf/tests/source-pygments.adoc"],
      wasm~,
      command=pygments,
    )
    check(
      "\{tag} \{pygments}: Pygments highlights",
      !err.contains("UNSUPPORTED"),
      detail=err,
    )
    // a keyword (`def`, `public`) in the friendly style: #007020, bold;
    // without Pygments, neither
    let keyword = "0 0.439215686275 0.125490196078"
    let problem = token_style_problem(
      "\{out_dir}/\{tag}-pygments.pdf",
      "mplus1mn-bold",
      keyword,
    )
    check(
      "\{tag} \{pygments}: keywords bold, in #007020",
      problem is None,
      detail=problem.unwrap_or(""),
    )
    check(
      "\{tag} pygments without Pygments: no keyword style",
      token_style_problem(
        "\{out_dir}/\{tag}-no-pygments.pdf",
        "mplus1mn-bold",
        keyword,
      )
      is Some(_),
    )
    // Rouge in the command with Pygments: a keyword in asciidoctor-pdf's
    // Rouge style, #008800, bold
    convert(
      "\{tag} \{pygments} rouge",
      ["pdf/tests/source-rouge.adoc"],
      "\{out_dir}/\{tag}-pygments-rouge.pdf",
      wasm~,
      check_pdfinfo~,
      command=pygments,
    )
    for file in ["\{tag}-rouge.pdf", "\{tag}-pygments-rouge.pdf"] {
      let problem = token_style_problem(
        "\{out_dir}/\{file}",
        "mplus1mn-bold",
        "0 0.533333333333 0",
      )
      check(
        "\{file}: Rouge keywords bold, in #008800",
        problem is None,
        detail=problem.unwrap_or(""),
      )
    }
    // standard input to standard output
    let (code, out, err) = run_cli(["-"], wasm~, stdin=small)
    check("\{tag} stdin to stdout: exit 0", code == 0, detail=err)
    let problem = pdf_problem(out)
    check(
      "\{tag} stdin to stdout: valid PDF (\{out.length()} bytes)",
      problem is None,
      detail=problem.unwrap_or(""),
    )
  }
  if failures.is_empty() {
    println("smoke test passed")
  } else {
    println("smoke test failed: \{failures.length()} checks")
    fail("smoke test failed")
  }
}
