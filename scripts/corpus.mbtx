// Byte-for-byte comparison with Ruby Asciidoctor over AsciiDoc corpora
// (output and warnings), for one or more backends.
//
// Usage: moon run --target native scripts/corpus.mbtx -- [options] [DIR...]
//   -b BACKEND     html5, docbook5 or manpage (repeatable; default: all three)
//   --standalone   compare standalone documents instead of embedded output
//   --pygments     highlight source blocks with Pygments (-a
//                  source-highlighter=pygments; Ruby runs pygments.rb from
//                  .repos/gems with Python Pygments 2.21, see harvest.mbtx)
//   -a ATTR        pass an attribute to both sides (repeatable)
//   -v             print the name of each differing file
// Differences listed in tests/corpus_known_diffs.txt ("BACKEND<TAB>PATH",
// where BACKEND is suffixed with "+pygments" in Pygments mode; paths relative
// to the repository root) are tolerated; any other difference makes the
// script fail.
// Without DIR, every corpus found under .repos/ is used.
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/core/env",
}

///|
let known_corpora : Array[String] = [
  ".repos/asciidoctor/docs", ".repos/asciidoctor-pdf", ".repos/asciidoctor-diagram",
  ".repos/asciidoctor-epub3", ".repos/asciidoctorj", ".repos/progit2", ".repos/git",
  ".repos/quarkus", ".repos/spring-boot", ".repos/hibernate-orm", ".repos/debezium",
  ".repos/asciidoc-lang",
]

///|
async fn collect_adoc(dir : String, out : Array[String]) -> Unit {
  let entries = @fs.readdir(dir, sort=true) catch { _ => return }
  for name in entries {
    let path = "\{dir}/\{name}"
    match (@fs.kind(path) catch { _ => continue }) {
      Directory => collect_adoc(path, out)
      Regular => if name.has_suffix(".adoc") || name.has_suffix(".asc") || name.has_suffix(".asciidoc") {
        out.push(path)
      }
      _ => ()
    }
  }
}

///|
fn dirname(path : String) -> String {
  match path.rev_find("/") {
    Some(i) => path.unsafe_substring(start=0, end=i)
    None => "."
  }
}

///|
async fn run_one(
  cmd : String,
  args : Array[String],
  cwd : String,
  env : Map[String, String],
) -> (Int, String, String) {
  let (code, out, err) = @process.collect_output(cmd, args, cwd~, extra_env=env)
  (code, out.text(), err.text())
}

///|
/// The Python Pygments release bobzhang/pygments ports, which pygments.rb
/// runs for the Ruby side with --pygments (installed by scripts/harvest.mbtx).
let oracle_pygments : String = ".repos/python/pygments-2.21.0"

///|
async fn main {
  let args = @env.args()
  let backends = []
  let dirs = []
  let mut standalone = false
  let mut pygments = false
  let attrs = []
  let mut verbose = false
  let mut i = 1
  while i < args.length() {
    match args[i] {
      "-b" => {
        i += 1
        backends.push(args[i])
      }
      "--standalone" => standalone = true
      "--pygments" => pygments = true
      "-a" => {
        i += 1
        attrs.push(args[i])
      }
      "-v" => verbose = true
      "--" => ()
      a => dirs.push(a)
    }
    i += 1
  }
  if backends.is_empty() {
    backends.push_iter(["html5", "docbook5", "manpage"].iter())
  }
  let root = @fs.realpath(".")
  if dirs.is_empty() {
    for d in known_corpora {
      if (@fs.exists(d) catch { _ => false }) {
        dirs.push(d)
      }
    }
  }
  let (code, _, _) = @process.collect_output("moon", ["build", "--target", "native", "cmd/asciidoctor"])
  if code != 0 {
    fail("build failed")
  }
  let bin = "\{root}/_build/native/debug/build/cmd/asciidoctor/asciidoctor.exe"
  let ruby_lib = "\{root}/.repos/asciidoctor/lib"
  let ruby_bin = "\{root}/.repos/asciidoctor/bin/asciidoctor"
  let env = { "SOURCE_DATE_EPOCH": "1700000000", "TZ": "UTC" }
  let ruby_env = env.copy()
  let ruby_args = ["-I", ruby_lib]
  let attr_args = []
  for a in attrs {
    attr_args.push_iter(["-a", a].iter())
  }
  if pygments {
    // pygments.rb (in .repos/gems) running Python Pygments 2.21
    if !(@fs.exists("\{root}/\{oracle_pygments}/pygments") catch { _ => false }) {
      fail(
        "\{oracle_pygments} is missing: run scripts/harvest.mbtx, which installs pygments.rb and Pygments",
      )
    }
    let (_, gempath, _) = @process.collect_output("gem", ["env", "gempath"])
    ruby_env["GEM_PATH"] = "\{root}/.repos/gems:\{gempath.text().trim()}"
    ruby_env["ORACLE_PYGMENTS_PATH"] = "\{root}/\{oracle_pygments}"
    ruby_args.push_iter(["-r", "\{root}/scripts/harvest/pygments_path.rb"].iter())
    attr_args.push_iter(["-a", "source-highlighter=pygments"].iter())
  }
  ruby_args.push(ruby_bin)
  // the label of the configuration in tests/corpus_known_diffs.txt
  let mode = if pygments { "+pygments" } else { "" }
  let known : Set[String] = Set([])
  let known_text = @fs.read_file("tests/corpus_known_diffs.txt").text() catch {
    _ => ""
  }
  for line in known_text.split("\n") {
    if line != "" && !line.has_prefix("#") {
      known.add(line.to_owned())
    }
  }
  let unexpected = []
  for backend in backends {
    for dir in dirs {
      let files = []
      // report paths under DIR as given (.repos may be a symlink in a worktree)
      let real_dir = @fs.realpath(dir)
      collect_adoc(real_dir, files)
      let mut same = 0
      let diffs = []
      // convert files concurrently in small batches
      let batch = 8
      let mut start = 0
      while start < files.length() {
        let end = if start + batch < files.length() { start + batch } else { files.length() }
        let results : Array[(String, Bool)] = []
        @async.with_task_group(group => {
          for f in files[start:end] {
            group.spawn_bg(() => {
              let common = ["-S", "safe", "-b", backend, "-o", "-", ..attr_args]
              let opts = if standalone { common } else { common + ["-s"] }
              let rb = run_one("ruby", [..ruby_args, ..opts, f], dirname(f), ruby_env)
              let mbt = run_one(bin, [..opts, f], dirname(f), env)
              results.push((f, rb == mbt))
            })
          }
        })
        for r in results {
          if r.1 {
            same += 1
          } else {
            diffs.push(relative(root, dir + r.0.unsafe_substring(start=real_dir.length(), end=r.0.length())))
          }
        }
        start = end
      }
      println("\{backend}\{mode}\t\{dir}\tidentical: \{same} / \{files.length()}")
      for d in diffs {
        let is_known = known.contains("\{backend}\{mode}\t\{d}")
        if !is_known {
          unexpected.push("\{backend}\{mode}\t\{d}")
        }
        if verbose || !is_known {
          println("  DIFF \{d}\{if is_known { " (known)" } else { "" }}")
        }
      }
    }
  }
  if !unexpected.is_empty() {
    fail("\{unexpected.length()} unexpected corpus differences")
  }
}

///|
fn relative(root : String, path : String) -> String {
  if path.has_prefix(root + "/") {
    path.unsafe_substring(start=root.length() + 1, end=path.length())
  } else {
    path
  }
}
