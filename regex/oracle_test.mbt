///|
fn oracle_cases() -> Array[(String, String, String, Array[Int]?, Array[Int])] {
  [
    ..oracle_chunk_0(),
    ..oracle_chunk_1(),
    ..oracle_chunk_2(),
    ..oracle_chunk_3(),
    ..oracle_chunk_4(),
    ..oracle_chunk_5(),
    ..oracle_chunk_6(),
    ..oracle_chunk_7(),
    ..oracle_chunk_8(),
    ..oracle_chunk_9(),
    ..oracle_chunk_10(),
    ..oracle_chunk_11(),
    ..oracle_chunk_12(),
    ..oracle_chunk_13(),
    ..oracle_chunk_14(),
    ..oracle_chunk_15(),
    ..oracle_chunk_16(),
    ..oracle_chunk_17(),
    ..oracle_chunk_18(),
    ..oracle_chunk_19(),
  ]
}

///|
test "regex oracle: agrees with Ruby on Asciidoctor patterns" {
  let failures = []
  let mut last_src = ""
  let mut last_re : @regex.Regex? = None
  let oracle_cases = oracle_cases()
  for c in oracle_cases {
    let (src, flags, input, expected, expected_all) = c
    if src != last_src {
      last_src = src
      last_re = Some(@regex.compile(src, flags~))
    }
    guard! last_re is Some(re)
    let actual = match re.find(input) {
      Some(m) =>
        Some(
          Array::makei(m.size() * 2, i => {
            if i % 2 == 0 {
              m.begin(i=i / 2)
            } else {
              m.end(i=i / 2)
            }
          }),
        )
      None => None
    }
    let all = []
    for m in re.find_all(input) {
      for i in 0..<m.size() {
        all.push(m.begin(i~))
        all.push(m.end(i~))
      }
      all.push(-2)
    }
    if all != expected_all {
      failures.push(
        "scan /\{src}/\{flags} on \{input.escape()}: expected \{Repr(expected_all)}, got \{Repr(all)}",
      )
    }
    if actual != expected {
      failures.push(
        "/\{src}/\{flags} on \{input.escape()}: expected \{Repr(expected)}, got \{Repr(actual)}",
      )
    }
  }
  let hits = oracle_cases.filter(c => c.3 is Some(_)).length()
  assert_true(hits > 1000)
  if failures.length() > 0 {
    fail(
      "\{failures.length()} / \{oracle_cases.length()} failures:\n" +
      failures[:@cmp.minimum(40, failures.length())].join("\n"),
    )
  }
}
