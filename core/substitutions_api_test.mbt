}

///|
test "Quotes: single-line constrained monospaced string" {
  let b1 = block_from_string("`a few <{monospaced}> words`", attributes=[
    ("monospaced", Str("monospaced")),
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.apply_subs("`a few <{monospaced}> words`", @core.normal_subs),
    content="<code>a few &lt;{monospaced}&gt; words</code>",
  )
  let b2 = block_from_string("`a few <{monospaced}> words`", attributes=[
    ("monospaced", Str("monospaced")),
  ])
  inspect(
    b2.apply_subs("`a few <{monospaced}> words`", @core.normal_subs),
    content="<code>a few &lt;monospaced&gt; words</code>",
  )
}

///|
test "Quotes: single-line constrained monospaced string with role" {
  let b1 = block_from_string("[input]`a few <{monospaced}> words`", attributes=[
    ("monospaced", Str("monospaced")),
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.apply_subs("[input]`a few <{monospaced}> words`", @core.normal_subs),
    content="<code class=\"input\">a few &lt;{monospaced}&gt; words</code>",
  )
  let b2 = block_from_string("[input]`a few <{monospaced}> words`", attributes=[
    ("monospaced", Str("monospaced")),
  ])
  inspect(
    b2.apply_subs("[input]`a few <{monospaced}> words`", @core.normal_subs),
    content="<code class=\"input\">a few &lt;monospaced&gt; words</code>",
  )
}

///|
test "Quotes: escaped single-line constrained monospaced string" {
  let b1 = block_from_string("\\`a few <monospaced> words`", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.apply_subs("\\`a few <monospaced> words`", @core.normal_subs),
    content="`a few &lt;monospaced&gt; words`",
  )
  let b2 = block_from_string("\\`a few <monospaced> words`")
  inspect(
    b2.apply_subs("\\`a few <monospaced> words`", @core.normal_subs),
    content="`a few &lt;monospaced&gt; words`",
  )
}

///|
test "Quotes: escaped single-line constrained monospaced string with role" {
  let b1 = block_from_string("[input]\\`a few <monospaced> words`", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.apply_subs("[input]\\`a few <monospaced> words`", @core.normal_subs),
    content="[input]`a few &lt;monospaced&gt; words`",
  )
  let b2 = block_from_string("[input]\\`a few <monospaced> words`")
  inspect(
    b2.apply_subs("[input]\\`a few <monospaced> words`", @core.normal_subs),
    content="[input]`a few &lt;monospaced&gt; words`",
  )
}

///|
test "Quotes: escaped role on single-line constrained monospaced string" {
  let b1 = block_from_string("\\[input]`a few <monospaced> words`", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.apply_subs("\\[input]`a few <monospaced> words`", @core.normal_subs),
    content="[input]<code>a few &lt;monospaced&gt; words</code>",
  )
  let b2 = block_from_string("\\[input]`a few <monospaced> words`")
  inspect(
    b2.apply_subs("\\[input]`a few <monospaced> words`", @core.normal_subs),
    content="[input]<code>a few &lt;monospaced&gt; words</code>",
  )
}

///|
test "Quotes: escaped role on escaped single-line constrained monospaced string" {
  let b1 = block_from_string("\\[input]\\`a few <monospaced> words`", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.apply_subs("\\[input]\\`a few <monospaced> words`", @core.normal_subs),
    content="\\[input]`a few &lt;monospaced&gt; words`",
  )
  let b2 = block_from_string("\\[input]\\`a few <monospaced> words`")
  inspect(
    b2.apply_subs("\\[input]\\`a few <monospaced> words`", @core.normal_subs),
    content="\\[input]`a few &lt;monospaced&gt; words`",
  )
}

///|
test "Quotes: should ignore role that ends with transitional role on constrained monospace span" {
  let b1 = block_from_string("[foox-]`leave it alone`")
  inspect(
    b1.apply_subs("[foox-]`leave it alone`", @core.normal_subs),
    content="<code class=\"foox-\">leave it alone</code>",
  )
}

///|
test "Quotes: escaped single-line constrained monospace string with forced compat role" {
  let b1 = block_from_string("[x-]\\`leave it alone`")
  inspect(
    b1.apply_subs("[x-]\\`leave it alone`", @core.normal_subs),
    content="[x-]`leave it alone`",
  )
}

///|
test "Quotes: escaped forced compat role on single-line constrained monospace string" {
  let b1 = block_from_string("\\[x-]`just *mono*`")
  inspect(
    b1.apply_subs("\\[x-]`just *mono*`", @core.normal_subs),
    content="[x-]<code>just <strong>mono</strong></code>",
  )
}

///|
test "Quotes: multi-line constrained monospaced string" {
  let b1 = block_from_string(
    (
      #|`a few
      #|<{monospaced}> words`
    ),
    attributes=[("monospaced", Str("monospaced")), ("compat-mode", Str(""))],
  )
  inspect(
    b1.apply_subs(
      (
        #|`a few
        #|<{monospaced}> words`
      ),
      @core.normal_subs,
    ),
    content=(
      #|<code>a few
      #|&lt;{monospaced}&gt; words</code>
    ),
  )
  let b2 = block_from_string(
    (
      #|`a few
      #|<{monospaced}> words`
    ),
    attributes=[("monospaced", Str("monospaced"))],
  )
  inspect(
    b2.apply_subs(
      (
        #|`a few
        #|<{monospaced}> words`
      ),
      @core.normal_subs,
    ),
    content=(
      #|<code>a few
      #|&lt;monospaced&gt; words</code>
    ),
  )
}

///|
test "Quotes: single-line unconstrained strong chars" {
  let b1 = block_from_string("**Git**Hub")
  inspect(b1.sub_quotes("**Git**Hub"), content="<strong>Git</strong>Hub")
}

///|
test "Quotes: escaped single-line unconstrained strong chars" {
  let b1 = block_from_string("\\**Git**Hub")
  inspect(b1.sub_quotes("\\**Git**Hub"), content="<strong>*Git</strong>*Hub")
}

///|
test "Quotes: multi-line unconstrained strong chars" {
  let b1 = block_from_string(
    (
      #|**G
      #|i
      #|t
      #|**Hub
    ),
  )
  inspect(
    b1.sub_quotes(
      (
        #|**G
        #|i
        #|t
        #|**Hub
      ),
    ),
    content=(
      #|<strong>G
      #|i
      #|t
      #|</strong>Hub
    ),
  )
}

///|
test "Quotes: unconstrained strong chars with inline asterisk" {
  let b1 = block_from_string("**bl*ck**-eye")
  inspect(b1.sub_quotes("**bl*ck**-eye"), content="<strong>bl*ck</strong>-eye")
}

///|
test "Quotes: unconstrained strong chars with role" {
  let b1 = block_from_string("Git[blue]**Hub**")
  inspect(
    b1.sub_quotes("Git[blue]**Hub**"),
    content="Git<strong class=\"blue\">Hub</strong>",
  )
}

///|
test "Quotes: escaped unconstrained strong chars with role" {
  let b1 = block_from_string("Git\\[blue]**Hub**")
  inspect(
    b1.sub_quotes("Git\\[blue]**Hub**"),
    content="Git[blue]<strong>*Hub</strong>*",
  )
}

///|
test "Quotes: single-line unconstrained emphasized chars" {
  let b1 = block_from_string("__Git__Hub")
  inspect(b1.sub_quotes("__Git__Hub"), content="<em>Git</em>Hub")
}

///|
test "Quotes: escaped single-line unconstrained emphasized chars" {
  let b1 = block_from_string("\\__Git__Hub")
  inspect(b1.sub_quotes("\\__Git__Hub"), content="__Git__Hub")
}

///|
test "Quotes: escaped single-line unconstrained emphasized chars around word" {
  let b1 = block_from_string("\\\\__GitHub__")
  inspect(b1.sub_quotes("\\\\__GitHub__"), content="__GitHub__")
}

///|
test "Quotes: multi-line unconstrained emphasized chars" {
  let b1 = block_from_string(
    (
      #|__G
      #|i
      #|t
      #|__Hub
    ),
  )
  inspect(
    b1.sub_quotes(
      (
        #|__G
        #|i
        #|t
        #|__Hub
      ),
    ),
    content=(
      #|<em>G
      #|i
      #|t
      #|</em>Hub
    ),
  )
}

///|
test "Quotes: unconstrained emphasis chars with role" {
  let b1 = block_from_string("[gray]__Git__Hub")
  inspect(
    b1.sub_quotes("[gray]__Git__Hub"),
    content="<em class=\"gray\">Git</em>Hub",
  )
}

///|
test "Quotes: escaped unconstrained emphasis chars with role" {
  let b1 = block_from_string("\\[gray]__Git__Hub")
  inspect(b1.sub_quotes("\\[gray]__Git__Hub"), content="[gray]__Git__Hub")
}

///|
test "Quotes: single-line constrained monospaced chars" {
  let b1 = block_from_string("call +save()+ to persist the changes", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.sub_quotes("call +save()+ to persist the changes"),
    content="call <code>save()</code> to persist the changes",
  )
  let b2 = block_from_string("call [x-]+save()+ to persist the changes")
  inspect(
    b2.apply_subs("call [x-]+save()+ to persist the changes", @core.normal_subs),
    content="call <code>save()</code> to persist the changes",
  )
  let b3 = block_from_string("call `save()` to persist the changes")
  inspect(
    b3.sub_quotes("call `save()` to persist the changes"),
    content="call <code>save()</code> to persist the changes",
  )
}

///|
test "Quotes: single-line constrained monospaced chars with role" {
  let b1 = block_from_string("call [method]+save()+ to persist the changes", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.sub_quotes("call [method]+save()+ to persist the changes"),
    content="call <code class=\"method\">save()</code> to persist the changes",
  )
  let b2 = block_from_string("call [method x-]+save()+ to persist the changes")
  inspect(
    b2.apply_subs(
      "call [method x-]+save()+ to persist the changes", @core.normal_subs,
    ),
    content="call <code class=\"method\">save()</code> to persist the changes",
  )
  let b3 = block_from_string("call [method]`save()` to persist the changes")
  inspect(
    b3.sub_quotes("call [method]`save()` to persist the changes"),
    content="call <code class=\"method\">save()</code> to persist the changes",
  )
}

///|
test "Quotes: escaped single-line constrained monospaced chars" {
  let b1 = block_from_string("call \\+save()+ to persist the changes", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.sub_quotes("call \\+save()+ to persist the changes"),
    content="call +save()+ to persist the changes",
  )
  let b2 = block_from_string("call \\`save()` to persist the changes")
  inspect(
    b2.sub_quotes("call \\`save()` to persist the changes"),
    content="call `save()` to persist the changes",
  )
}

///|
test "Quotes: escaped single-line constrained monospaced chars with role" {
  let b1 = block_from_string("call [method]\\+save()+ to persist the changes", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.sub_quotes("call [method]\\+save()+ to persist the changes"),
    content="call [method]+save()+ to persist the changes",
  )
  let b2 = block_from_string("call [method]\\`save()` to persist the changes")
  inspect(
    b2.sub_quotes("call [method]\\`save()` to persist the changes"),
    content="call [method]`save()` to persist the changes",
  )
}

///|
test "Quotes: escaped role on single-line constrained monospaced chars" {
  let b1 = block_from_string("call \\[method]+save()+ to persist the changes", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.sub_quotes("call \\[method]+save()+ to persist the changes"),
    content="call [method]<code>save()</code> to persist the changes",
  )
  let b2 = block_from_string("call \\[method]`save()` to persist the changes")
  inspect(
    b2.sub_quotes("call \\[method]`save()` to persist the changes"),
    content="call [method]<code>save()</code> to persist the changes",
  )
}

///|
test "Quotes: escaped role on escaped single-line constrained monospaced chars" {
  let b1 = block_from_string(
    "call \\[method]\\+save()+ to persist the changes",
    attributes=[("compat-mode", Str(""))],
  )
  inspect(
    b1.sub_quotes("call \\[method]\\+save()+ to persist the changes"),
    content="call \\[method]+save()+ to persist the changes",
  )
  let b2 = block_from_string("call \\[method]\\`save()` to persist the changes")
  inspect(
    b2.sub_quotes("call \\[method]\\`save()` to persist the changes"),
    content="call \\[method]`save()` to persist the changes",
  )
}

///|
test "Quotes: escaped single-line constrained passthrough string with forced compat role" {
  let b1 = block_from_string("[x-]\\+leave it alone+")
  inspect(
    b1.apply_subs("[x-]\\+leave it alone+", @core.normal_subs),
    content="[x-]+leave it alone+",
  )
}

///|
test "Quotes: single-line unconstrained monospaced chars" {
  let b1 = block_from_string("Git++Hub++", attributes=[("compat-mode", Str(""))])
  inspect(b1.sub_quotes("Git++Hub++"), content="Git<code>Hub</code>")
  let b2 = block_from_string("Git[x-]++Hub++")
  inspect(
    b2.apply_subs("Git[x-]++Hub++", @core.normal_subs),
    content="Git<code>Hub</code>",
  )
  let b3 = block_from_string("Git``Hub``")
  inspect(b3.sub_quotes("Git``Hub``"), content="Git<code>Hub</code>")
}

///|
test "Quotes: escaped single-line unconstrained monospaced chars" {
  let b1 = block_from_string("Git\\++Hub++", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(b1.sub_quotes("Git\\++Hub++"), content="Git+<code>Hub</code>+")
  let b2 = block_from_string("Git\\\\++Hub++", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(b2.sub_quotes("Git\\\\++Hub++"), content="Git++Hub++")
  let b3 = block_from_string("Git\\``Hub``")
  inspect(b3.sub_quotes("Git\\``Hub``"), content="Git``Hub``")
}

///|
test "Quotes: multi-line unconstrained monospaced chars" {
  let b1 = block_from_string(
    (
      #|Git++
      #|H
      #|u
      #|b++
    ),
    attributes=[("compat-mode", Str(""))],
  )
  inspect(
    b1.sub_quotes(
      (
        #|Git++
        #|H
        #|u
        #|b++
      ),
    ),
    content=(
      #|Git<code>
      #|H
      #|u
      #|b</code>
    ),
  )
  let b2 = block_from_string(
    (
      #|Git[x-]++
      #|H
      #|u
      #|b++
    ),
  )
  inspect(
    b2.apply_subs(
      (
        #|Git[x-]++
        #|H
        #|u
        #|b++
      ),
      @core.normal_subs,
    ),
    content=(
      #|Git<code>
      #|H
      #|u
      #|b</code>
    ),
  )
  let b3 = block_from_string(
    (
      #|Git``
      #|H
      #|u
      #|b``
    ),
  )
  inspect(
    b3.sub_quotes(
      (
        #|Git``
        #|H
        #|u
        #|b``
      ),
    ),
    content=(
      #|Git<code>
      #|H
      #|u
      #|b</code>
    ),
  )
}

///|
test "Quotes: single-line superscript chars" {
  let b1 = block_from_string(
    "x^2^ = x * x, e = mc^2^, there's a 1^st^ time for everything",
  )
  inspect(
    b1.sub_quotes(
      "x^2^ = x * x, e = mc^2^, there's a 1^st^ time for everything",
    ),
    content="x<sup>2</sup> = x * x, e = mc<sup>2</sup>, there's a 1<sup>st</sup> time for everything",
  )
}

///|
test "Quotes: escaped single-line superscript chars" {
  let b1 = block_from_string("x\\^2^ = x * x")
  inspect(b1.sub_quotes("x\\^2^ = x * x"), content="x^2^ = x * x")
}

///|
test "Quotes: does not match superscript across whitespace" {
  let b1 = block_from_string(
    (
      #|x^(n
      #|-
      #|1)^
    ),
  )
  inspect(
    b1.sub_quotes(
      (
        #|x^(n
        #|-
        #|1)^
      ),
    ),
    content=(
      #|x^(n
      #|-
      #|1)^
    ),
  )
}

///|
test "Quotes: allow spaces in superscript if spaces are inserted using an attribute reference" {
  let b1 = block_from_string("Night ^A{sp}poem{sp}by{sp}Jane{sp}Kondo^.")
  inspect(
    b1.apply_subs(
      "Night ^A{sp}poem{sp}by{sp}Jane{sp}Kondo^.", @core.normal_subs,
    ),
    content="Night <sup>A poem by Jane Kondo</sup>.",
  )
}

///|
test "Quotes: allow spaces in superscript if text is wrapped in a passthrough" {
  let b1 = block_from_string("Night ^+A poem by Jane Kondo+^.")
  inspect(
    b1.apply_subs("Night ^+A poem by Jane Kondo+^.", @core.normal_subs),
    content="Night <sup>A poem by Jane Kondo</sup>.",
  )
}

///|
test "Quotes: does not match adjacent superscript chars" {
  let b1 = block_from_string("a ^^ b")
  inspect(b1.sub_quotes("a ^^ b"), content="a ^^ b")
}

///|
test "Quotes: single-line subscript chars" {
  let b1 = block_from_string("H~2~O")
  inspect(b1.sub_quotes("H~2~O"), content="H<sub>2</sub>O")
}

///|
test "Quotes: escaped single-line subscript chars" {
  let b1 = block_from_string("H\\~2~O")
  inspect(b1.sub_quotes("H\\~2~O"), content="H~2~O")
}

///|
test "Quotes: does not match subscript across whitespace" {
  let b1 = block_from_string(
    (
      #|project~ view
      #|on
      #|GitHub~
    ),
  )
  inspect(
    b1.sub_quotes(
      (
        #|project~ view
        #|on
        #|GitHub~
      ),
    ),
    content=(
      #|project~ view
      #|on
      #|GitHub~
    ),
  )
}

///|
test "Quotes: does not match adjacent subscript chars" {
  let b1 = block_from_string("a ~~ b")
  inspect(b1.sub_quotes("a ~~ b"), content="a ~~ b")
}

///|
test "Quotes: does not match subscript across distinct URLs" {
  let b1 = block_from_string(
    "http://www.abc.com/~def[DEF] and http://www.abc.com/~ghi[GHI]",
  )
  inspect(
    b1.sub_quotes(
      "http://www.abc.com/~def[DEF] and http://www.abc.com/~ghi[GHI]",
    ),
    content="http://www.abc.com/~def[DEF] and http://www.abc.com/~ghi[GHI]",
  )
}

///|
test "Quotes: quoted text with role shorthand" {
  let b1 = block_from_string("[.white.red-background]#alert#")
  inspect(
    b1.sub_quotes("[.white.red-background]#alert#"),
    content="<span class=\"white red-background\">alert</span>",
  )
}

///|
test "Quotes: quoted text with id shorthand" {
  let b1 = block_from_string("[#bond]#007#")
  inspect(b1.sub_quotes("[#bond]#007#"), content="<span id=\"bond\">007</span>")
}

///|
test "Quotes: quoted text with id and role shorthand" {
  let b1 = block_from_string("[#bond.white.red-background]#007#")
  inspect(
    b1.sub_quotes("[#bond.white.red-background]#007#"),
    content="<span id=\"bond\" class=\"white red-background\">007</span>",
  )
}

///|
test "Quotes: quoted text with id and role shorthand with roles before id" {
  let b1 = block_from_string("[.white.red-background#bond]#007#")
  inspect(
    b1.sub_quotes("[.white.red-background#bond]#007#"),
    content="<span id=\"bond\" class=\"white red-background\">007</span>",
  )
}

///|
test "Quotes: quoted text with id and role shorthand with roles around id" {
  let b1 = block_from_string("[.white#bond.red-background]#007#")
  inspect(
    b1.sub_quotes("[.white#bond.red-background]#007#"),
    content="<span id=\"bond\" class=\"white red-background\">007</span>",
  )
}

///|
test "Quotes: quoted text with id and role shorthand using docbook backend" {
  let b1 = block_from_string(
    "[#bond.white.red-background]#007#",
    backend="docbook",
  )
  inspect(
    b1.sub_quotes("[#bond.white.red-background]#007#"),
    content="<anchor xml:id=\"bond\"/><phrase role=\"white red-background\">007</phrase>",
  )
}

///|
test "Quotes: should ignore attributes after comma" {
  let b1 = block_from_string("[red, foobar]#alert#")
  inspect(
    b1.sub_quotes("[red, foobar]#alert#"),
    content="<span class=\"red\">alert</span>",
  )
}

///|
test "Quotes: should remove leading and trailing spaces around role after ignoring attributes after comma" {
  let b1 = block_from_string("[ red , foobar]#alert#")
  inspect(
    b1.sub_quotes("[ red , foobar]#alert#"),
    content="<span class=\"red\">alert</span>",
  )
}

///|
test "Quotes: should not assign role if value before comma is empty" {
  let b1 = block_from_string("[,]#anonymous#")
  inspect(b1.sub_quotes("[,]#anonymous#"), content="anonymous")
}

///|
test "Macros: a single-line link macro should be interpreted as a link" {
  let b1 = block_from_string("link:/home.html[]")
  inspect(
    b1.sub_macros("link:/home.html[]"),
    content="<a href=\"/home.html\" class=\"bare\">/home.html</a>",
  )
}

///|
test "Macros: a single-line link macro with text should be interpreted as a link" {
  let b1 = block_from_string("link:/home.html[Home]")
  inspect(
    b1.sub_macros("link:/home.html[Home]"),
    content="<a href=\"/home.html\">Home</a>",
  )
}

///|
test "Macros: a mailto macro should be interpreted as a mailto link" {
  let b1 = block_from_string("mailto:doc.writer@asciidoc.org[]")
  inspect(
    b1.sub_macros("mailto:doc.writer@asciidoc.org[]"),
    content="<a href=\"mailto:doc.writer@asciidoc.org\">doc.writer@asciidoc.org</a>",
  )
}

///|
test "Macros: a mailto macro with text should be interpreted as a mailto link" {
  let b1 = block_from_string("mailto:doc.writer@asciidoc.org[Doc Writer]")
  inspect(
    b1.sub_macros("mailto:doc.writer@asciidoc.org[Doc Writer]"),
    content="<a href=\"mailto:doc.writer@asciidoc.org\">Doc Writer</a>",
  )
}

///|
test "Macros: a mailto macro with text and subject should be interpreted as a mailto link" {
  let b1 = block_from_string(
    "mailto:doc.writer@asciidoc.org[Doc Writer, Pull request]",
  )
  inspect(
    b1.sub_macros("mailto:doc.writer@asciidoc.org[Doc Writer, Pull request]"),
    content="<a href=\"mailto:doc.writer@asciidoc.org?subject=Pull%20request\">Doc Writer</a>",
  )
}

///|
test "Macros: a mailto macro with text, subject and body should be interpreted as a mailto link" {
  let b1 = block_from_string(
    "mailto:doc.writer@asciidoc.org[Doc Writer, Pull request, Please accept my pull request]",
  )
  inspect(
    b1.sub_macros(
      "mailto:doc.writer@asciidoc.org[Doc Writer, Pull request, Please accept my pull request]",
    ),
    content="<a href=\"mailto:doc.writer@asciidoc.org?subject=Pull%20request&amp;body=Please%20accept%20my%20pull%20request\">Doc Writer</a>",
  )
}

///|
test "Macros: a mailto macro with subject and body only should use e-mail as text" {
  let b1 = block_from_string(
    "mailto:doc.writer@asciidoc.org[,Pull request,Please accept my pull request]",
  )
  inspect(
    b1.sub_macros(
      "mailto:doc.writer@asciidoc.org[,Pull request,Please accept my pull request]",
    ),
    content="<a href=\"mailto:doc.writer@asciidoc.org?subject=Pull%20request&amp;body=Please%20accept%20my%20pull%20request\">doc.writer@asciidoc.org</a>",
  )
}

///|
test "Macros: a mailto macro supports id and role attributes" {
  let b1 = block_from_string(
    "mailto:doc.writer@asciidoc.org[,id=contact,role=icon]",
  )
  inspect(
    b1.sub_macros("mailto:doc.writer@asciidoc.org[,id=contact,role=icon]"),
    content="<a href=\"mailto:doc.writer@asciidoc.org\" id=\"contact\" class=\"icon\">doc.writer@asciidoc.org</a>",
  )
}

///|
test "Macros: should recognize inline email addresses" {
  let b1 = block_from_string("doc.writer@asciidoc.org")
  inspect(
    b1.sub_macros("doc.writer@asciidoc.org"),
    content="<a href=\"mailto:doc.writer@asciidoc.org\">doc.writer@asciidoc.org</a>",
  )
  let b2 = block_from_string("author+website@4fs.no")
  inspect(
    b2.sub_macros("author+website@4fs.no"),
    content="<a href=\"mailto:author+website@4fs.no\">author+website@4fs.no</a>",
  )
  let b3 = block_from_string("john@domain.uk.co")
  inspect(
    b3.sub_macros("john@domain.uk.co"),
    content="<a href=\"mailto:john@domain.uk.co\">john@domain.uk.co</a>",
  )
  let b4 = block_from_string("name@somewhere.else.com")
  inspect(
    b4.sub_macros("name@somewhere.else.com"),
    content="<a href=\"mailto:name@somewhere.else.com\">name@somewhere.else.com</a>",
  )
  let b5 = block_from_string("joe_bloggs@mail_server.com")
  inspect(
    b5.sub_macros("joe_bloggs@mail_server.com"),
    content="<a href=\"mailto:joe_bloggs@mail_server.com\">joe_bloggs@mail_server.com</a>",
  )
  let b6 = block_from_string("joe-bloggs@mail-server.com")
  inspect(
    b6.sub_macros("joe-bloggs@mail-server.com"),
    content="<a href=\"mailto:joe-bloggs@mail-server.com\">joe-bloggs@mail-server.com</a>",
  )
  let b7 = block_from_string("joe.bloggs@mail.server.com")
  inspect(
    b7.sub_macros("joe.bloggs@mail.server.com"),
    content="<a href=\"mailto:joe.bloggs@mail.server.com\">joe.bloggs@mail.server.com</a>",
  )
  let b8 = block_from_string("FOO@BAR.COM")
  inspect(
    b8.sub_macros("FOO@BAR.COM"),
    content="<a href=\"mailto:FOO@BAR.COM\">FOO@BAR.COM</a>",
  )
  let b9 = block_from_string("docs@writing.ninja")
  inspect(
    b9.sub_macros("docs@writing.ninja"),
    content="<a href=\"mailto:docs@writing.ninja\">docs@writing.ninja</a>",
  )
}

///|
test "Macros: should recognize inline email address containing an ampersand" {
  let b1 = block_from_string("bert&ernie@sesamestreet.com")
  inspect(
    b1.apply_subs("bert&ernie@sesamestreet.com", @core.normal_subs),
    content="<a href=\"mailto:bert&amp;ernie@sesamestreet.com\">bert&amp;ernie@sesamestreet.com</a>",
  )
}

///|
test "Macros: should recognize inline email address surrounded by angle brackets" {
  let b1 = block_from_string("<doc.writer@asciidoc.org>")
  inspect(
    b1.apply_subs("<doc.writer@asciidoc.org>", @core.normal_subs),
    content="&lt;<a href=\"mailto:doc.writer@asciidoc.org\">doc.writer@asciidoc.org</a>&gt;",
  )
}

///|
test "Macros: should ignore escaped inline email address" {
  let b1 = block_from_string("\\doc.writer@asciidoc.org")
  inspect(
    b1.sub_macros("\\doc.writer@asciidoc.org"),
    content="doc.writer@asciidoc.org",
  )
}

///|
test "Macros: a single-line raw url should be interpreted as a link" {
  let b1 = block_from_string("http://google.com")
  inspect(
    b1.sub_macros("http://google.com"),
    content="<a href=\"http://google.com\" class=\"bare\">http://google.com</a>",
  )
}

///|
test "Macros: a single-line raw url with text should be interpreted as a link" {
  let b1 = block_from_string("http://google.com[Google]")
  inspect(
    b1.sub_macros("http://google.com[Google]"),
    content="<a href=\"http://google.com\">Google</a>",
  )
}

///|
test "Macros: a multi-line raw url with text should be interpreted as a link" {
  let b1 = block_from_string(
    (
      #|http://google.com[Google
      #|Homepage]
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|http://google.com[Google
        #|Homepage]
      ),
    ),
    content=(
      #|<a href="http://google.com">Google
      #|Homepage</a>
    ),
  )
}

///|
test "Macros: a single-line raw url with attribute as text should be interpreted as a link with resolved attribute" {
  let b1 = block_from_string("http://google.com[{google_homepage}]")
  b1.document().attributes.set("google_homepage", Str("Google Homepage"))
  inspect(
    b1.sub_attributes("http://google.com[{google_homepage}]"),
    content="http://google.com[Google Homepage]",
  )
  inspect(
    b1.sub_macros("http://google.com[Google Homepage]"),
    content="<a href=\"http://google.com\">Google Homepage</a>",
  )
}

///|
test "Macros: should not resolve an escaped attribute in link text" {
  let b1 = block_from_string("http://google.com[\\{google_homepage}]")
  b1.document().attributes.set("google_homepage", Str("Google Homepage"))
  inspect(
    b1.sub_attributes("http://google.com[\\{google_homepage}]"),
    content="http://google.com[{google_homepage}]",
  )
  inspect(
    b1.sub_macros("http://google.com[{google_homepage}]"),
    content="<a href=\"http://google.com\">{google_homepage}</a>",
  )
  let b2 = block_from_string("link:http://google.com?q=,[\\{google_homepage}]")
  b2.document().attributes.set("google_homepage", Str("Google Homepage"))
  inspect(
    b2.sub_attributes("link:http://google.com?q=,[\\{google_homepage}]"),
    content="link:http://google.com?q=,[{google_homepage}]",
  )
  inspect(
    b2.sub_macros("link:http://google.com?q=,[{google_homepage}]"),
    content="<a href=\"http://google.com?q=,\">{google_homepage}</a>",
  )
}

///|
test "Macros: a single-line escaped raw url should not be interpreted as a link" {
  let b1 = block_from_string("\\http://google.com")
  inspect(b1.sub_macros("\\http://google.com"), content="http://google.com")
}

///|
test "Macros: a comma separated list of links should not include commas in links" {
  let b1 = block_from_string(
    "http://foo.com, http://bar.com, http://example.org",
  )
  inspect(
    b1.sub_macros("http://foo.com, http://bar.com, http://example.org"),
    content="<a href=\"http://foo.com\" class=\"bare\">http://foo.com</a>, <a href=\"http://bar.com\" class=\"bare\">http://bar.com</a>, <a href=\"http://example.org\" class=\"bare\">http://example.org</a>",
  )
}

///|
test "Macros: a single-line image macro should be interpreted as an image" {
  let b1 = block_from_string("image:tiger.png[]")
  inspect(
    b1.sub_macros("image:tiger.png[]"),
    content="<span class=\"image\"><img src=\"tiger.png\" alt=\"tiger\"></span>",
  )
}

///|
test "Macros: should replace underscore and hyphen with space in generated alt text for an inline image" {
  let b1 = block_from_string("image:tiger-with-family_1.png[]")
  inspect(
    b1.sub_macros("image:tiger-with-family_1.png[]"),
    content="<span class=\"image\"><img src=\"tiger-with-family_1.png\" alt=\"tiger with family 1\"></span>",
  )
}

///|
test "Macros: a single-line image macro with text should be interpreted as an image with alt text" {
  let b1 = block_from_string("image:tiger.png[Tiger]")
  inspect(
    b1.sub_macros("image:tiger.png[Tiger]"),
    content="<span class=\"image\"><img src=\"tiger.png\" alt=\"Tiger\"></span>",
  )
}

///|
test "Macros: an image macro with SVG image and text should be interpreted as an image with alt text" {
  let b1 = block_from_string("image:tiger.svg[Tiger]")
  inspect(
    b1.sub_macros("image:tiger.svg[Tiger]"),
    content="<span class=\"image\"><img src=\"tiger.svg\" alt=\"Tiger\"></span>",
  )
}

///|
test "Macros: an image macro with an interactive SVG image and alt text should be converted to an object element" {
  let b1 = block_from_string(
    "image:tiger.svg[Tiger,opts=interactive]",
    safe=10,
    attributes=[("imagesdir", Str("images"))],
  )
  inspect(
    b1.sub_macros("image:tiger.svg[Tiger,opts=interactive]"),
    content="<span class=\"image\"><object type=\"image/svg+xml\" data=\"images/tiger.svg\"><span class=\"alt\">Tiger</span></object></span>",
  )
}

///|
test "Macros: an image macro with an interactive SVG image, fallback and alt text should be converted to an object element" {
  let b1 = block_from_string(
    "image:tiger.svg[Tiger,fallback=tiger.png,opts=interactive]",
    safe=10,
    attributes=[("imagesdir", Str("images"))],
  )
  inspect(
    b1.sub_macros("image:tiger.svg[Tiger,fallback=tiger.png,opts=interactive]"),
    content="<span class=\"image\"><object type=\"image/svg+xml\" data=\"images/tiger.svg\"><img src=\"images/tiger.png\" alt=\"Tiger\"></object></span>",
  )
}

///|
test "Macros: an image macro with an inline SVG image should be converted to an svg element" {
  let b1 = block_from_string(
    "image:circle.svg[Tiger,100,opts=inline]",
    safe=10,
    attributes=[("imagesdir", Str("fixtures")), ("docdir", Str("/test"))],
    vfs=fixture_vfs(),
  )
  inspect(
    b1.sub_macros("image:circle.svg[Tiger,100,opts=inline]"),
    content=(
      #|<span class="image"><svg
      #|viewBox="0 0 120 120" version="1.1"
      #|xmlns="http://www.w3.org/2000/svg" width="100">
      #|  <circle cx="60" cy="60" r="50"/>
      #|</svg></span>
    ),
  )
}

///|
test "Macros: should ignore link attribute if value is self and image target is inline SVG" {
  let b1 = block_from_string(
    "image:circle.svg[Tiger,100,opts=inline,link=self]",
    safe=10,
    attributes=[("imagesdir", Str("fixtures")), ("docdir", Str("/test"))],
    vfs=fixture_vfs(),
  )
  inspect(
    b1.sub_macros("image:circle.svg[Tiger,100,opts=inline,link=self]"),
    content=(
      #|<span class="image"><svg
      #|viewBox="0 0 120 120" version="1.1"
      #|xmlns="http://www.w3.org/2000/svg" width="100">
      #|  <circle cx="60" cy="60" r="50"/>
      #|</svg></span>
    ),
  )
}

///|
test "Macros: an image macro with an inline SVG image should be converted to an svg element even when data-uri is set" {
  let b1 = block_from_string(
    "image:circle.svg[Tiger,100,opts=inline]",
    safe=10,
    attributes=[
      ("data-uri", Str("")),
      ("imagesdir", Str("fixtures")),
      ("docdir", Str("/test")),
    ],
    vfs=fixture_vfs(),
  )
  inspect(
    b1.sub_macros("image:circle.svg[Tiger,100,opts=inline]"),
    content=(
      #|<span class="image"><svg
      #|viewBox="0 0 120 120" version="1.1"
      #|xmlns="http://www.w3.org/2000/svg" width="100">
      #|  <circle cx="60" cy="60" r="50"/>
      #|</svg></span>
    ),
  )
}

///|
test "Macros: an image macro with an SVG image should not use an object element when safe mode is secure" {
  let b1 = block_from_string("image:tiger.svg[Tiger,opts=interactive]", attributes=[
    ("imagesdir", Str("images")),
  ])
  inspect(
    b1.sub_macros("image:tiger.svg[Tiger,opts=interactive]"),
    content="<span class=\"image\"><img src=\"images/tiger.svg\" alt=\"Tiger\"></span>",
  )
}

///|
test "Macros: a single-line image macro with text containing escaped square bracket should be interpreted as an image with alt text" {
  let b1 = block_from_string("image:tiger.png[[Another\\] Tiger]")
  inspect(
    b1.sub_macros("image:tiger.png[[Another\\] Tiger]"),
    content="<span class=\"image\"><img src=\"tiger.png\" alt=\"[Another] Tiger\"></span>",
  )
}

///|
test "Macros: a single-line image macro with text and dimensions should be interpreted as an image with alt text and dimensions" {
  let b1 = block_from_string("image:tiger.png[Tiger, 200, 100]")
  inspect(
    b1.sub_macros("image:tiger.png[Tiger, 200, 100]"),
    content="<span class=\"image\"><img src=\"tiger.png\" alt=\"Tiger\" width=\"200\" height=\"100\"></span>",
  )
}

///|
test "Macros: a single-line image macro with text and dimensions should be interpreted as an image with alt text and dimensions in docbook" {
  let b1 = block_from_string(
    "image:tiger.png[Tiger, 200, 100]",
    backend="docbook",
  )
  inspect(
    b1.sub_macros("image:tiger.png[Tiger, 200, 100]"),
    content=(
      #|<inlinemediaobject>
      #|<imageobject>
      #|<imagedata fileref="tiger.png" contentwidth="200" contentdepth="100"/>
      #|</imageobject>
      #|<textobject><phrase>Tiger</phrase></textobject>
      #|</inlinemediaobject>
    ),
  )
}

///|
test "Macros: a single-line image macro with scaledwidth attribute should be supported in docbook" {
  let b1 = block_from_string(
    "image:tiger.png[Tiger,scaledwidth=25%]",
    backend="docbook",
  )
  inspect(
    b1.sub_macros("image:tiger.png[Tiger,scaledwidth=25%]"),
    content=(
      #|<inlinemediaobject>
      #|<imageobject>
      #|<imagedata fileref="tiger.png" width="25%"/>
      #|</imageobject>
      #|<textobject><phrase>Tiger</phrase></textobject>
      #|</inlinemediaobject>
    ),
  )
}

///|
test "Macros: a single-line image macro with scaled attribute should be supported in docbook" {
  let b1 = block_from_string(
    "image:tiger.png[Tiger,scale=200]",
    backend="docbook",
  )
  inspect(
    b1.sub_macros("image:tiger.png[Tiger,scale=200]"),
    content=(
      #|<inlinemediaobject>
      #|<imageobject>
      #|<imagedata fileref="tiger.png" scale="200"/>
      #|</imageobject>
      #|<textobject><phrase>Tiger</phrase></textobject>
      #|</inlinemediaobject>
    ),
  )
}

///|
test "Macros: should pass through role on image macro to DocBook output" {
  let b1 = block_from_string(
    "image:tiger.png[Tiger,200,role=animal]",
    backend="docbook",
  )
  inspect(
    b1.sub_macros("image:tiger.png[Tiger,200,role=animal]"),
    content=(
      #|<inlinemediaobject role="animal">
      #|<imageobject>
      #|<imagedata fileref="tiger.png" contentwidth="200"/>
      #|</imageobject>
      #|<textobject><phrase>Tiger</phrase></textobject>
      #|</inlinemediaobject>
    ),
  )
}

///|
test "Macros: a single-line image macro with text and link should be interpreted as a linked image with alt text" {
  let b1 = block_from_string(
    "image:tiger.png[Tiger, link=\"http://en.wikipedia.org/wiki/Tiger\"]",
  )
  inspect(
    b1.sub_macros(
      "image:tiger.png[Tiger, link=\"http://en.wikipedia.org/wiki/Tiger\"]",
    ),
    content="<span class=\"image\"><a class=\"image\" href=\"http://en.wikipedia.org/wiki/Tiger\"><img src=\"tiger.png\" alt=\"Tiger\"></a></span>",
  )
}

///|
test "Macros: an inline image macro with link should be interpreted as a linked image in docbook" {
  let b1 = block_from_string(
    "image:apache license 2_0.png[Apache License 2.0,link=http://www.apache.org/licenses/LICENSE-2.0]",
    backend="docbook",
  )
  inspect(
    b1.sub_macros(
      "image:apache license 2_0.png[Apache License 2.0,link=http://www.apache.org/licenses/LICENSE-2.0]",
    ),
    content=(
      #|<link xl:href="http://www.apache.org/licenses/LICENSE-2.0"><inlinemediaobject>
      #|<imageobject>
      #|<imagedata fileref="apache%20license%202_0.png"/>
      #|</imageobject>
      #|<textobject><phrase>Apache License 2.0</phrase></textobject>
      #|</inlinemediaobject></link>
    ),
  )
}

///|
test "Macros: a single-line image macro with text and link to self should be interpreted as a self-referencing image with alt text" {
  let b1 = block_from_string("image:tiger.png[Tiger, link=self]", attributes=[
    ("imagesdir", Str("img")),
  ])
  inspect(
    b1.sub_macros("image:tiger.png[Tiger, link=self]"),
    content="<span class=\"image\"><a class=\"image\" href=\"img/tiger.png\"><img src=\"img/tiger.png\" alt=\"Tiger\"></a></span>",
  )
}

///|
test "Macros: an inline image macro with text and link to self should be interpreted as a self-referencing image in docbook" {
  let b1 = block_from_string(
    "image:tiger.png[Tiger,link=self]",
    attributes=[("imagesdir", Str("img"))],
    backend="docbook",
  )
  inspect(
    b1.sub_macros("image:tiger.png[Tiger,link=self]"),
    content=(
      #|<link xl:href="img/tiger.png"><inlinemediaobject>
      #|<imageobject>
      #|<imagedata fileref="img/tiger.png"/>
      #|</imageobject>
      #|<textobject><phrase>Tiger</phrase></textobject>
      #|</inlinemediaobject></link>
    ),
  )
}

///|
test "Macros: should link to data URI if value of link attribute is self and inline image is embedded" {
  let b1 = block_from_string(
    "image:circle.svg[Tiger,100,link=self]",
    safe=10,
    attributes=[
      ("data-uri", Str("")),
      ("imagesdir", Str("fixtures")),
      ("docdir", Str("/test")),
    ],
    vfs=fixture_vfs(),
  )
  inspect(
    b1.sub_macros("image:circle.svg[Tiger,100,link=self]"),
    content="<span class=\"image\"><a class=\"image\" href=\"data:image/svg+xml;base64,\"><img src=\"data:image/svg+xml;base64,\" alt=\"Tiger\" width=\"100\"></a></span>",
  )
}

///|
test "Macros: rel=noopener should be added to an image with a link that targets the _blank window" {
  let b1 = block_from_string(
    "image:tiger.png[Tiger,link=http://en.wikipedia.org/wiki/Tiger,window=_blank]",
  )
  inspect(
    b1.sub_macros(
      "image:tiger.png[Tiger,link=http://en.wikipedia.org/wiki/Tiger,window=_blank]",
    ),
    content="<span class=\"image\"><a class=\"image\" href=\"http://en.wikipedia.org/wiki/Tiger\" target=\"_blank\" rel=\"noopener\"><img src=\"tiger.png\" alt=\"Tiger\"></a></span>",
  )
}

///|
test "Macros: rel=noopener should be added to an image with a link that targets a named window when the noopener option is set" {
  let b1 = block_from_string(
    "image:tiger.png[Tiger,link=http://en.wikipedia.org/wiki/Tiger,window=name,opts=noopener]",
  )
  inspect(
    b1.sub_macros(
      "image:tiger.png[Tiger,link=http://en.wikipedia.org/wiki/Tiger,window=name,opts=noopener]",
    ),
    content="<span class=\"image\"><a class=\"image\" href=\"http://en.wikipedia.org/wiki/Tiger\" target=\"name\" rel=\"noopener\"><img src=\"tiger.png\" alt=\"Tiger\"></a></span>",
  )
}

///|
test "Macros: rel=nofollow should be added to an image with a link when the nofollow option is set" {
  let b1 = block_from_string(
    "image:tiger.png[Tiger,link=http://en.wikipedia.org/wiki/Tiger,opts=nofollow]",
  )
  inspect(
    b1.sub_macros(
      "image:tiger.png[Tiger,link=http://en.wikipedia.org/wiki/Tiger,opts=nofollow]",
    ),
    content="<span class=\"image\"><a class=\"image\" href=\"http://en.wikipedia.org/wiki/Tiger\" rel=\"nofollow\"><img src=\"tiger.png\" alt=\"Tiger\"></a></span>",
  )
}

///|
test "Macros: a multi-line image macro with text and dimensions should be interpreted as an image with alt text and dimensions" {
  let b1 = block_from_string(
    (
      #|image:tiger.png[Another
      #|Awesome
      #|Tiger, 200,
      #|100]
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|image:tiger.png[Another
        #|Awesome
        #|Tiger, 200,
        #|100]
      ),
    ),
    content="<span class=\"image\"><img src=\"tiger.png\" alt=\"Another Awesome Tiger\" width=\"200\" height=\"100\"></span>",
  )
}

///|
test "Macros: an inline image macro with a url target should be interpreted as an image" {
  let b1 = block_from_string(
    "Beware of the image:http://example.com/images/tiger.png[tiger].",
  )
  inspect(
    b1.sub_macros(
      "Beware of the image:http://example.com/images/tiger.png[tiger].",
    ),
    content="Beware of the <span class=\"image\"><img src=\"http://example.com/images/tiger.png\" alt=\"tiger\"></span>.",
  )
}

///|
test "Macros: an inline image macro with a float attribute should be interpreted as a floating image" {
  let b1 = block_from_string(
    "image:http://example.com/images/tiger.png[tiger, float=\"right\"] Beware of the tigers!",
  )
  inspect(
    b1.sub_macros(
      "image:http://example.com/images/tiger.png[tiger, float=\"right\"] Beware of the tigers!",
    ),
    content="<span class=\"image right\"><img src=\"http://example.com/images/tiger.png\" alt=\"tiger\"></span> Beware of the tigers!",
  )
}

///|
test "Macros: should propagate id attribute on inline image" {
  let b1 = block_from_string(
    "image:ruby.png[Ruby logo,id=ruby-logo] is the Ruby logo",
  )
  inspect(
    b1.sub_macros("image:ruby.png[Ruby logo,id=ruby-logo] is the Ruby logo"),
    content="<span id=\"ruby-logo\" class=\"image\"><img src=\"ruby.png\" alt=\"Ruby logo\"></span> is the Ruby logo",
  )
}

///|
test "Macros: should propagate id attribute on inline image and use alt text as reftext when converting to DocBook" {
  let b1 = block_from_string(
    "image:ruby.png[Ruby logo,id=ruby-logo] is the Ruby logo",
    backend="docbook",
  )
  inspect(
    b1.sub_macros("image:ruby.png[Ruby logo,id=ruby-logo] is the Ruby logo"),
    content=(
      #|<inlinemediaobject xml:id="ruby-logo">
      #|<imageobject>
      #|<imagedata fileref="ruby.png"/>
      #|</imageobject>
      #|<textobject><phrase>Ruby logo</phrase></textobject>
      #|</inlinemediaobject> is the Ruby logo
    ),
  )
}

///|
test "Macros: should prepend value of imagesdir attribute to inline image target if target is relative path" {
  let b1 = block_from_string("Beware of the image:tiger.png[tiger].", attributes=[
    ("imagesdir", Str("./images")),
  ])
  inspect(
    b1.sub_macros("Beware of the image:tiger.png[tiger]."),
    content="Beware of the <span class=\"image\"><img src=\"./images/tiger.png\" alt=\"tiger\"></span>.",
  )
}

///|
test "Macros: should not prepend value of imagesdir attribute to inline image target if target is absolute path" {
  let b1 = block_from_string("Beware of the image:/tiger.png[tiger].", attributes=[
    ("imagesdir", Str("./images")),
  ])
  inspect(
    b1.sub_macros("Beware of the image:/tiger.png[tiger]."),
    content="Beware of the <span class=\"image\"><img src=\"/tiger.png\" alt=\"tiger\"></span>.",
  )
}

///|
test "Macros: should not prepend value of imagesdir attribute to inline image target if target is url" {
  let b1 = block_from_string(
    "Beware of the image:http://example.com/images/tiger.png[tiger].",
    attributes=[("imagesdir", Str("./images"))],
  )
  inspect(
    b1.sub_macros(
      "Beware of the image:http://example.com/images/tiger.png[tiger].",
    ),
    content="Beware of the <span class=\"image\"><img src=\"http://example.com/images/tiger.png\" alt=\"tiger\"></span>.",
  )
}

///|
test "Macros: should match an inline image macro if target contains a space character" {
  let b1 = block_from_string("Beware of the image:big cats.png[] around here.")
  inspect(
    b1.sub_macros("Beware of the image:big cats.png[] around here."),
    content="Beware of the <span class=\"image\"><img src=\"big%20cats.png\" alt=\"big cats\"></span> around here.",
  )
}

///|
test "Macros: should not match an inline image macro if target contains a newline character" {
  let b1 = block_from_string(
    (
      #|Fear not. There are no image:big
      #|cats.png[] around here.
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|Fear not. There are no image:big
        #|cats.png[] around here.
      ),
    ),
    content=(
      #|Fear not. There are no image:big
      #|cats.png[] around here.
    ),
  )
}

///|
test "Macros: should not match an inline image macro if target begins or ends with space character" {
  let b1 = block_from_string(
    "Fear not. There are no image: big cats.png[] around here.",
  )
  inspect(
    b1.sub_macros("Fear not. There are no image: big cats.png[] around here."),
    content="Fear not. There are no image: big cats.png[] around here.",
  )
  let b2 = block_from_string(
    "Fear not. There are no image:big cats.png [] around here.",
  )
  inspect(
    b2.sub_macros("Fear not. There are no image:big cats.png [] around here."),
    content="Fear not. There are no image:big cats.png [] around here.",
  )
}

///|
test "Macros: should not detect a block image macro found inline" {
  let b1 = block_from_string("Not an inline image macro image::tiger.png[].")
  inspect(
    b1.sub_macros("Not an inline image macro image::tiger.png[]."),
    content="Not an inline image macro image::tiger.png[].",
  )
}

///|
test "Macros: an icon macro should be interpreted as an icon if icons are enabled" {
  let b1 = block_from_string("icon:github[]", attributes=[("icons", Str(""))])
  inspect(
    b1.sub_macros("icon:github[]"),
    content="<span class=\"icon\"><img src=\"./images/icons/github.png\" alt=\"github\"></span>",
  )
}

///|
test "Macros: an icon macro should be interpreted as alt text if icons are disabled" {
  let b1 = block_from_string("icon:github[]")
  inspect(
    b1.sub_macros("icon:github[]"),
    content="<span class=\"icon\">[github&#93;</span>",
  )
}

///|
test "Macros: should not mangle icon with link if icons are disabled" {
  let b1 = block_from_string("icon:github[link=https://github.com]")
  inspect(
    b1.sub_macros("icon:github[link=https://github.com]"),
    content="<span class=\"icon\"><a class=\"image\" href=\"https://github.com\">[github&#93;</a></span>",
  )
}

///|
test "Macros: should not mangle icon inside link if icons are disabled" {
  let b1 = block_from_string("https://github.com[icon:github[] GitHub]")
  inspect(
    b1.sub_macros("https://github.com[icon:github[] GitHub]"),
    content="<a href=\"https://github.com\"><span class=\"icon\">[github&#93;</span> GitHub</a>",
  )
}

///|
test "Macros: an icon macro should output alt text if icons are disabled and alt is given" {
  let b1 = block_from_string("icon:github[alt=\"GitHub\"]")
  inspect(
    b1.sub_macros("icon:github[alt=\"GitHub\"]"),
    content="<span class=\"icon\">[GitHub&#93;</span>",
  )
}

///|
test "Macros: an icon macro should be interpreted as a font-based icon when icons=font" {
  let b1 = block_from_string("icon:github[]", attributes=[
    ("icons", Str("font")),
  ])
  inspect(
    b1.sub_macros("icon:github[]"),
    content="<span class=\"icon\"><i class=\"fa fa-github\"></i></span>",
  )
}

///|
test "Macros: an icon macro with a size should be interpreted as a font-based icon with a size when icons=font" {
  let b1 = block_from_string("icon:github[4x]", attributes=[
    ("icons", Str("font")),
  ])
  inspect(
    b1.sub_macros("icon:github[4x]"),
    content="<span class=\"icon\"><i class=\"fa fa-github fa-4x\"></i></span>",
  )
}

///|
test "Macros: an icon macro with flip should be interpreted as a flipped font-based icon when icons=font" {
  let b1 = block_from_string("icon:shield[fw,flip=horizontal]", attributes=[
    ("icons", Str("font")),
  ])
  inspect(
    b1.sub_macros("icon:shield[fw,flip=horizontal]"),
    content="<span class=\"icon\"><i class=\"fa fa-shield fa-fw fa-flip-horizontal\"></i></span>",
  )
}

///|
test "Macros: an icon macro with rotate should be interpreted as a rotated font-based icon when icons=font" {
  let b1 = block_from_string("icon:shield[fw,rotate=90]", attributes=[
    ("icons", Str("font")),
  ])
  inspect(
    b1.sub_macros("icon:shield[fw,rotate=90]"),
    content="<span class=\"icon\"><i class=\"fa fa-shield fa-fw fa-rotate-90\"></i></span>",
  )
}

///|
test "Macros: an icon macro with a role and title should be interpreted as a font-based icon with a class and title when icons=font" {
  let b1 = block_from_string("icon:heart[role=\"red\", title=\"Heart me\"]", attributes=[
    ("icons", Str("font")),
  ])
  inspect(
    b1.sub_macros("icon:heart[role=\"red\", title=\"Heart me\"]"),
    content="<span class=\"icon red\"><i class=\"fa fa-heart\" title=\"Heart me\"></i></span>",
  )
}

///|
test "Macros: a single-line footnote macro should be registered and output as a footnote" {
  let b1 = block_from_string("Sentence text footnote:[An example footnote.].")
  inspect(
    b1.sub_macros("Sentence text footnote:[An example footnote.]."),
    content="Sentence text <sup class=\"footnote\">[<a id=\"_footnoteref_1\" class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>.",
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, nil, \"An example footnote.\"]]",
  )
}

///|
test "Macros: a multi-line footnote macro should be registered and output as a footnote without newline" {
  let b1 = block_from_string(
    (
      #|Sentence text footnote:[An example footnote
      #|with wrapped text.].
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|Sentence text footnote:[An example footnote
        #|with wrapped text.].
      ),
    ),
    content="Sentence text <sup class=\"footnote\">[<a id=\"_footnoteref_1\" class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>.",
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, nil, \"An example footnote with wrapped text.\"]]",
  )
}

///|
test "Macros: an escaped closing square bracket in a footnote should be unescaped when converted" {
  let b1 = block_from_string("footnote:[a \\] b].")
  inspect(
    b1.sub_macros("footnote:[a \\] b]."),
    content="<sup class=\"footnote\">[<a id=\"_footnoteref_1\" class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>.",
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, nil, \"a ] b\"]]",
  )
}

///|
test "Macros: a footnote macro can be directly adjacent to preceding word" {
  let b1 = block_from_string("Sentence textfootnote:[An example footnote.].")
  inspect(
    b1.sub_macros("Sentence textfootnote:[An example footnote.]."),
    content="Sentence text<sup class=\"footnote\">[<a id=\"_footnoteref_1\" class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>.",
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, nil, \"An example footnote.\"]]",
  )
}

///|
test "Macros: a footnote macro may contain an escaped backslash" {
  let b1 = block_from_string(
    (
      #|footnote:[\]]
      #|footnote:[a \] b]
      #|footnote:[a \]\] b]
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|footnote:[\]]
        #|footnote:[a \] b]
        #|footnote:[a \]\] b]
      ),
    ),
    content=(
      #|<sup class="footnote">[<a id="_footnoteref_1" class="footnote" href="#_footnotedef_1" title="View footnote.">1</a>]</sup>
      #|<sup class="footnote">[<a id="_footnoteref_2" class="footnote" href="#_footnotedef_2" title="View footnote.">2</a>]</sup>
      #|<sup class="footnote">[<a id="_footnoteref_3" class="footnote" href="#_footnotedef_3" title="View footnote.">3</a>]</sup>
    ),
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, nil, \"]\"], [2, nil, \"a ] b\"], [3, nil, \"a ]] b\"]]",
  )
}

///|
test "Macros: a footnote macro may contain a link macro" {
  let b1 = block_from_string(
    "Share your code. footnote:[https://github.com[GitHub]]",
  )
  inspect(
    b1.sub_macros("Share your code. footnote:[https://github.com[GitHub]]"),
    content="Share your code. <sup class=\"footnote\">[<a id=\"_footnoteref_1\" class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>",
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, nil, \"<a href=\\\"https://github.com\\\">GitHub</a>\"]]",
  )
}

///|
test "Macros: a footnote macro may contain a plain URL" {
  let b1 = block_from_string(
    (
      #|the JLine footnote:[https://github.com/jline/jline2]
      #|library.
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|the JLine footnote:[https://github.com/jline/jline2]
        #|library.
      ),
    ),
    content=(
      #|the JLine <sup class="footnote">[<a id="_footnoteref_1" class="footnote" href="#_footnotedef_1" title="View footnote.">1</a>]</sup>
      #|library.
    ),
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, nil, \"<a href=\\\"https://github.com/jline/jline2\\\" class=\\\"bare\\\">https://github.com/jline/jline2</a>\"]]",
  )
}

///|
test "Macros: a footnote macro followed by a semi-colon may contain a plain URL" {
  let b1 = block_from_string(
    (
      #|the JLine footnote:[https://github.com/jline/jline2];
      #|library.
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|the JLine footnote:[https://github.com/jline/jline2];
        #|library.
      ),
    ),
    content=(
      #|the JLine <sup class="footnote">[<a id="_footnoteref_1" class="footnote" href="#_footnotedef_1" title="View footnote.">1</a>]</sup>;
      #|library.
    ),
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, nil, \"<a href=\\\"https://github.com/jline/jline2\\\" class=\\\"bare\\\">https://github.com/jline/jline2</a>\"]]",
  )
}

///|
test "Macros: a footnote macro may contain a shorthand xref" {
  let b1 = block_from_string("text footnote:[&lt;&lt;_install,install&gt;&gt;]")
  inspect(
    b1.sub_macros("text footnote:[&lt;&lt;_install,install&gt;&gt;]"),
    content="text <sup class=\"footnote\">[<a id=\"_footnoteref_1\" class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>",
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, nil, \"<a href=\\\"#_install\\\">install</a>\"]]",
  )
}

///|
test "Macros: a footnote macro may contain an xref macro" {
  let b1 = block_from_string("text footnote:[xref:_install[install]]")
  inspect(
    b1.sub_macros("text footnote:[xref:_install[install]]"),
    content="text <sup class=\"footnote\">[<a id=\"_footnoteref_1\" class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>",
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, nil, \"<a href=\\\"#_install\\\">install</a>\"]]",
  )
}

///|
test "Macros: a footnote macro may contain an anchor macro" {
  let b1 = block_from_string("text footnote:[a [[b]] [[c\\]\\] d]")
  inspect(
    b1.sub_macros("text footnote:[a [[b]] [[c\\]\\] d]"),
    content="text <sup class=\"footnote\">[<a id=\"_footnoteref_1\" class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>",
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, nil, \"a <a id=\\\"b\\\"></a> [[c]] d\"]]",
  )
}

///|
test "Macros: should increment index of subsequent footnote macros" {
  let b1 = block_from_string(
    "Sentence text footnote:[An example footnote.]. Sentence text footnote:[Another footnote.].",
  )
  inspect(
    b1.sub_macros(
      "Sentence text footnote:[An example footnote.]. Sentence text footnote:[Another footnote.].",
    ),
    content="Sentence text <sup class=\"footnote\">[<a id=\"_footnoteref_1\" class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>. Sentence text <sup class=\"footnote\">[<a id=\"_footnoteref_2\" class=\"footnote\" href=\"#_footnotedef_2\" title=\"View footnote.\">2</a>]</sup>.",
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, nil, \"An example footnote.\"], [2, nil, \"Another footnote.\"]]",
  )
}

///|
test "Macros: a footnoteref macro with id and single-line text should be registered and output as a footnote" {
  let b1 = block_from_string(
    "Sentence text footnoteref:[ex1, An example footnote.].",
    attributes=[("compat-mode", Str(""))],
  )
  inspect(
    b1.sub_macros("Sentence text footnoteref:[ex1, An example footnote.]."),
    content="Sentence text <sup class=\"footnote\" id=\"_footnote_ex1\">[<a id=\"_footnoteref_1\" class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>.",
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, \"ex1\", \"An example footnote.\"]]",
  )
}

///|
test "Macros: a footnoteref macro with id and multi-line text should be registered and output as a footnote without newlines" {
  let b1 = block_from_string(
    (
      #|Sentence text footnoteref:[ex1, An example footnote
      #|with wrapped text.].
    ),
    attributes=[("compat-mode", Str(""))],
  )
  inspect(
    b1.sub_macros(
      (
        #|Sentence text footnoteref:[ex1, An example footnote
        #|with wrapped text.].
      ),
    ),
    content="Sentence text <sup class=\"footnote\" id=\"_footnote_ex1\">[<a id=\"_footnoteref_1\" class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>.",
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, \"ex1\", \"An example footnote with wrapped text.\"]]",
  )
}

///|
test "Macros: a footnoteref macro with id should refer to footnoteref with same id" {
  let b1 = block_from_string(
    "Sentence text footnoteref:[ex1, An example footnote.]. Sentence text footnoteref:[ex1].",
    attributes=[("compat-mode", Str(""))],
  )
  inspect(
    b1.sub_macros(
      "Sentence text footnoteref:[ex1, An example footnote.]. Sentence text footnoteref:[ex1].",
    ),
    content="Sentence text <sup class=\"footnote\" id=\"_footnote_ex1\">[<a id=\"_footnoteref_1\" class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>. Sentence text <sup class=\"footnoteref\">[<a class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>.",
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, \"ex1\", \"An example footnote.\"]]",
  )
}

///|
test "Macros: an unresolved footnote reference should produce a warning message and output fallback text in red" {
  let b1 = block_from_string("Sentence text.footnote:ex1[]")
  let (r, logs) = @core.with_memory_logger(() => {
    b1.sub_macros("Sentence text.footnote:ex1[]")
  })
  inspect(
    r,
    content="Sentence text.<sup class=\"footnoteref red\" title=\"Unresolved footnote reference.\">[ex1]</sup>",
  )
  inspect(
    log_lines(logs, min_level=2),
    content="WARN: invalid footnote reference: ex1",
  )
}

///|
test "Macros: using a footnoteref macro should generate a warning when compat mode is not enabled" {
  let b1 = block_from_string(
    "Sentence text.footnoteref:[fn1,Commentary on this sentence.]",
  )
  let (r, logs) = @core.with_memory_logger(() => {
    b1.sub_macros(
      "Sentence text.footnoteref:[fn1,Commentary on this sentence.]",
    )
  })
  inspect(
    r,
    content="Sentence text.<sup class=\"footnote\" id=\"_footnote_fn1\">[<a id=\"_footnoteref_1\" class=\"footnote\" href=\"#_footnotedef_1\" title=\"View footnote.\">1</a>]</sup>",
  )
  inspect(
    log_lines(logs, min_level=2),
    content="WARN: found deprecated footnoteref macro: footnoteref:[fn1,Commentary on this sentence.]; use footnote macro with target instead",
  )
  inspect(
    rb_inspect_footnotes(b1.document().footnotes()),
    content="[[1, \"fn1\", \"Commentary on this sentence.\"]]",
  )
}

///|
test "Macros: a single-line index term macro with a primary term should be registered as an index reference" {
  let b1 = block_from_string(
    (
      #|The tiger (Panthera tigris) is the largest cat species.
      #|indexterm:[Tigers]
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|The tiger (Panthera tigris) is the largest cat species.
        #|indexterm:[Tigers]
      ),
    ),
    content=(
      #|The tiger (Panthera tigris) is the largest cat species.
      #|
    ),
  )
  let b2 = block_from_string(
    (
      #|The tiger (Panthera tigris) is the largest cat species.
      #|(((Tigers)))
    ),
  )
  inspect(
    b2.sub_macros(
      (
        #|The tiger (Panthera tigris) is the largest cat species.
        #|(((Tigers)))
      ),
    ),
    content=(
      #|The tiger (Panthera tigris) is the largest cat species.
      #|
    ),
  )
}

///|
test "Macros: a single-line index term macro with primary and secondary terms should be registered as an index reference" {
  let b1 = block_from_string(
    (
      #|The tiger (Panthera tigris) is the largest cat species.
      #|indexterm:[Big cats, Tigers]
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|The tiger (Panthera tigris) is the largest cat species.
        #|indexterm:[Big cats, Tigers]
      ),
    ),
    content=(
      #|The tiger (Panthera tigris) is the largest cat species.
      #|
    ),
  )
  let b2 = block_from_string(
    (
      #|The tiger (Panthera tigris) is the largest cat species.
      #|(((Big cats, Tigers)))
    ),
  )
  inspect(
    b2.sub_macros(
      (
        #|The tiger (Panthera tigris) is the largest cat species.
        #|(((Big cats, Tigers)))
      ),
    ),
    content=(
      #|The tiger (Panthera tigris) is the largest cat species.
      #|
    ),
  )
}

///|
test "Macros: a single-line index term macro with primary, secondary and tertiary terms should be registered as an index reference" {
  let b1 = block_from_string(
    (
      #|The tiger (Panthera tigris) is the largest cat species.
      #|indexterm:[Big cats,Tigers , Panthera tigris]
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|The tiger (Panthera tigris) is the largest cat species.
        #|indexterm:[Big cats,Tigers , Panthera tigris]
      ),
    ),
    content=(
      #|The tiger (Panthera tigris) is the largest cat species.
      #|
    ),
  )
  let b2 = block_from_string(
    (
      #|The tiger (Panthera tigris) is the largest cat species.
      #|(((Big cats,Tigers , Panthera tigris)))
    ),
  )
  inspect(
    b2.sub_macros(
      (
        #|The tiger (Panthera tigris) is the largest cat species.
        #|(((Big cats,Tigers , Panthera tigris)))
      ),
    ),
    content=(
      #|The tiger (Panthera tigris) is the largest cat species.
      #|
    ),
  )
}

///|
test "Macros: a multi-line index term macro should be compacted and registered as an index reference" {
  let b1 = block_from_string(
    (
      #|The tiger (Panthera tigris) is the largest cat species.
      #|indexterm:[Panthera
      #|tigris]
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|The tiger (Panthera tigris) is the largest cat species.
        #|indexterm:[Panthera
        #|tigris]
      ),
    ),
    content=(
      #|The tiger (Panthera tigris) is the largest cat species.
      #|
    ),
  )
  let b2 = block_from_string(
    (
      #|The tiger (Panthera tigris) is the largest cat species.
      #|(((Panthera
      #|tigris)))
    ),
  )
  inspect(
    b2.sub_macros(
      (
        #|The tiger (Panthera tigris) is the largest cat species.
        #|(((Panthera
        #|tigris)))
      ),
    ),
    content=(
      #|The tiger (Panthera tigris) is the largest cat species.
      #|
    ),
  )
}

///|
test "Macros: should not split index terms on commas inside of quoted terms" {
  let b1 = block_from_string(
    (
      #|Tigers are big, scary cats.
      #|indexterm:[Tigers, "[Big\],
      #|scary cats"]
      #|
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|Tigers are big, scary cats.
        #|indexterm:[Tigers, "[Big\],
        #|scary cats"]
      ),
    ),
    content=(
      #|Tigers are big, scary cats.
      #|
    ),
  )
  let b2 = block_from_string(
    (
      #|Tigers are big, scary cats.
      #|(((Tigers, "[Big],
      #|scary cats")))
      #|
    ),
  )
  inspect(
    b2.sub_macros(
      (
        #|Tigers are big, scary cats.
        #|(((Tigers, "[Big],
        #|scary cats")))
      ),
    ),
    content=(
      #|Tigers are big, scary cats.
      #|
    ),
  )
}

///|
test "Macros: normal substitutions are performed on an index term macro" {
  let b1 = block_from_string(
    (
      #|The tiger (Panthera tigris) is the largest cat species.
      #|indexterm:[*Tigers*]
    ),
  )
  inspect(
    b1.apply_subs(
      (
        #|The tiger (Panthera tigris) is the largest cat species.
        #|indexterm:[*Tigers*]
      ),
      @core.normal_subs,
    ),
    content=(
      #|The tiger (Panthera tigris) is the largest cat species.
      #|
    ),
  )
  let b2 = block_from_string(
    (
      #|The tiger (Panthera tigris) is the largest cat species.
      #|(((*Tigers*)))
    ),
  )
  inspect(
    b2.apply_subs(
      (
        #|The tiger (Panthera tigris) is the largest cat species.
        #|(((*Tigers*)))
      ),
      @core.normal_subs,
    ),
    content=(
      #|The tiger (Panthera tigris) is the largest cat species.
      #|
    ),
  )
}

///|
test "Macros: registers multiple index term macros" {
  let b1 = block_from_string(
    (
      #|The tiger (Panthera tigris) is the largest cat species.
      #|(((Tigers)))
      #|(((Animals,Cats)))
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|The tiger (Panthera tigris) is the largest cat species.
        #|(((Tigers)))
        #|(((Animals,Cats)))
      ),
    ),
    content=(
      #|The tiger (Panthera tigris) is the largest cat species.
      #|
      #|
    ),
  )
}

///|
test "Macros: an index term macro with round bracket syntax may contain round brackets in term" {
  let b1 = block_from_string(
    (
      #|The tiger (Panthera tigris) is the largest cat species.
      #|(((Tiger (Panthera tigris))))
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|The tiger (Panthera tigris) is the largest cat species.
        #|(((Tiger (Panthera tigris))))
      ),
    ),
    content=(
      #|The tiger (Panthera tigris) is the largest cat species.
      #|
    ),
  )
}

///|
test "Macros: visible shorthand index term macro should not consume trailing round bracket" {
  let b1 = block_from_string("(text with ((index term)))", backend="docbook")
  inspect(
    b1.sub_macros("(text with ((index term)))"),
    content=(
      #|(text with <indexterm>
      #|<primary>index term</primary>
      #|</indexterm>index term)
    ),
  )
}

///|
test "Macros: visible shorthand index term macro should not consume leading round bracket" {
  let b1 = block_from_string("(((index term)) for text)", backend="docbook")
  inspect(
    b1.sub_macros("(((index term)) for text)"),
    content=(
      #|(<indexterm>
      #|<primary>index term</primary>
      #|</indexterm>index term for text)
    ),
  )
}

///|
test "Macros: an index term macro with square bracket syntax may contain square brackets in term" {
  let b1 = block_from_string(
    (
      #|The tiger (Panthera tigris) is the largest cat species.
      #|indexterm:[Tiger [Panthera tigris\]]
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|The tiger (Panthera tigris) is the largest cat species.
        #|indexterm:[Tiger [Panthera tigris\]]
      ),
    ),
    content=(
      #|The tiger (Panthera tigris) is the largest cat species.
      #|
    ),
  )
}

///|
test "Macros: a single-line index term 2 macro should be registered as an index reference and retain term inline" {
  let b1 = block_from_string(
    "The indexterm2:[tiger] (Panthera tigris) is the largest cat species.",
  )
  inspect(
    b1.sub_macros(
      "The indexterm2:[tiger] (Panthera tigris) is the largest cat species.",
    ),
    content="The tiger (Panthera tigris) is the largest cat species.",
  )
  let b2 = block_from_string(
    "The ((tiger)) (Panthera tigris) is the largest cat species.",
  )
  inspect(
    b2.sub_macros("The ((tiger)) (Panthera tigris) is the largest cat species."),
    content="The tiger (Panthera tigris) is the largest cat species.",
  )
}

///|
test "Macros: a multi-line index term 2 macro should be compacted and registered as an index reference and retain term inline" {
  let b1 = block_from_string(
    (
      #|The indexterm2:[ panthera
      #|tigris ] is the largest cat species.
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|The indexterm2:[ panthera
        #|tigris ] is the largest cat species.
      ),
    ),
    content="The panthera tigris is the largest cat species.",
  )
  let b2 = block_from_string(
    (
      #|The (( panthera
      #|tigris )) is the largest cat species.
    ),
  )
  inspect(
    b2.sub_macros(
      (
        #|The (( panthera
        #|tigris )) is the largest cat species.
      ),
    ),
    content="The panthera tigris is the largest cat species.",
  )
}

///|
test "Macros: registers multiple index term 2 macros" {
  let b1 = block_from_string(
    "The ((tiger)) (Panthera tigris) is the largest ((cat)) species.",
  )
  inspect(
    b1.sub_macros(
      "The ((tiger)) (Panthera tigris) is the largest ((cat)) species.",
    ),
    content="The tiger (Panthera tigris) is the largest cat species.",
  )
}

///|
test "Macros: should escape visible index term if preceded by a backslash" {
  let b1 = block_from_string(
    "The \\((tiger)) (Panthera tigris) is the largest \\((cat)) species.",
  )
  inspect(
    b1.sub_macros(
      "The \\((tiger)) (Panthera tigris) is the largest \\((cat)) species.",
    ),
    content="The ((tiger)) (Panthera tigris) is the largest ((cat)) species.",
  )
}

///|
test "Macros: normal substitutions are performed on an index term 2 macro" {
  let b1 = block_from_string(
    "The ((*tiger*)) (Panthera tigris) is the largest cat species.",
  )
  inspect(
    b1.apply_subs(
      "The ((*tiger*)) (Panthera tigris) is the largest cat species.", @core.normal_subs,
    ),
    content="The <strong>tiger</strong> (Panthera tigris) is the largest cat species.",
  )
}

///|
test "Macros: index term 2 macro with round bracket syntax should not interfere with index term macro with round bracket syntax" {
  let b1 = block_from_string(
    (
      #|The ((panthera tigris)) is the largest cat species.
      #|(((Big cats,Tigers)))
    ),
  )
  inspect(
    b1.sub_macros(
      (
        #|The ((panthera tigris)) is the largest cat species.
        #|(((Big cats,Tigers)))
      ),
    ),
    content=(
      #|The panthera tigris is the largest cat species.
      #|
    ),
  )
}

///|
test "Macros: should honor secondary and tertiary index terms when primary index term is quoted and contains equals sign" {
  let b1 = block_from_string(
    "Assigning variables.indexterm:[\"name=value\",variable,assignment]",
    backend="docbook",
  )
  inspect(
    b1.sub_macros(
      "Assigning variables.indexterm:[\"name=value\",variable,assignment]",
    ),
    content=(
      #|Assigning variables.<indexterm>
      #|<primary>name=value</primary><secondary>variable</secondary><tertiary>assignment</tertiary>
      #|</indexterm>
    ),
  )
  let b2 = block_from_string(
    "Assigning variables.(((name=value,variable,assignment)))",
    backend="docbook",
  )
  inspect(
    b2.sub_macros("Assigning variables.(((name=value,variable,assignment)))"),
    content=(
      #|Assigning variables.<indexterm>
      #|<primary>name=value</primary><secondary>variable</secondary><tertiary>assignment</tertiary>
      #|</indexterm>
    ),
  )
}

