///|
test "Passthroughs: should allow inline double plus passthrough to be escaped using backslash" {
  let b1 = block_from_string(
    "you need to replace `int a = n\\++;` with `int a = ++n;`!",
  )
  inspect(
    b1.apply_subs(
      "you need to replace `int a = n\\++;` with `int a = ++n;`!", @core.normal_subs,
    ),
    content="you need to replace <code>int a = n++;</code> with <code>int a = ++n;</code>!",
  )
}

///|
test "Passthroughs: should allow inline double plus passthrough with attributes to be escaped using backslash" {
  let b1 = block_from_string("=[attrs]\\\\++text++")
  inspect(
    b1.apply_subs("=[attrs]\\\\++text++", @core.normal_subs),
    content="=[attrs]++text++",
  )
}

///|
test "Replacements: unescapes XML entities" {
  let b1 = block_from_string("< &quot; &there4; &#34; &#x22; >")
  inspect(
    b1.apply_subs("< &quot; &there4; &#34; &#x22; >", @core.normal_subs),
    content="&lt; &quot; &there4; &#34; &#x22; &gt;",
  )
}

///|
test "Replacements: replaces arrows" {
  let b1 = block_from_string("<- -> <= => \\<- \\-> \\<= \\=>")
  inspect(
    b1.apply_subs("<- -> <= => \\<- \\-> \\<= \\=>", @core.normal_subs),
    content="&#8592; &#8594; &#8656; &#8658; &lt;- -&gt; &lt;= =&gt;",
  )
}

///|
test "Replacements: replaces dashes" {
  let b1 = block_from_string(
    (
      #|-- foo foo--bar foo\--bar foo -- bar foo \-- bar
      #|stuff in between
      #|-- foo
      #|stuff in between
      #|foo --
      #|stuff in between
      #|foo --
      #|
    ),
  )
  inspect(
    b1.sub_replacements(
      (
        #|-- foo foo--bar foo\--bar foo -- bar foo \-- bar
        #|stuff in between
        #|-- foo
        #|stuff in between
        #|foo --
        #|stuff in between
        #|foo --
      ),
    ),
    content=(
      #|&#8201;&#8212;&#8201;foo foo&#8212;&#8203;bar foo--bar foo&#8201;&#8212;&#8201;bar foo -- bar
      #|stuff in between&#8201;&#8212;&#8201;foo
      #|stuff in between
      #|foo&#8201;&#8212;&#8201;stuff in between
      #|foo&#8201;&#8212;&#8201;
    ),
  )
}

///|
test "Replacements: replaces dashes between multibyte word characters" {
  let b1 = block_from_string("富--巴")
  inspect(b1.sub_replacements("富--巴"), content="富&#8212;&#8203;巴")
}

///|
test "Replacements: replaces marks" {
  let b1 = block_from_string("(C) (R) (TM) \\(C) \\(R) \\(TM)")
  inspect(
    b1.sub_replacements("(C) (R) (TM) \\(C) \\(R) \\(TM)"),
    content="&#169; &#174; &#8482; (C) (R) (TM)",
  )
}

///|
test "Replacements: replaces punctuation" {
  let b1 = block_from_string(
    "John's Hideout is the Whites`' place... foo\\'bar",
  )
  inspect(
    b1.sub_replacements("John's Hideout is the Whites`' place... foo\\'bar"),
    content="John&#8217;s Hideout is the Whites&#8217; place&#8230;&#8203; foo'bar",
  )
}

///|
test "Replacements: should replace right single quote marks" {
  let b1 = block_from_string("`'Twas the night")
  inspect(
    b1.sub_replacements("`'Twas the night"),
    content="&#8217;Twas the night",
  )
  let b2 = block_from_string("a `'57 Chevy!")
  inspect(b2.sub_replacements("a `'57 Chevy!"), content="a &#8217;57 Chevy!")
  let b3 = block_from_string("the whites`' place")
  inspect(
    b3.sub_replacements("the whites`' place"),
    content="the whites&#8217; place",
  )
  let b4 = block_from_string("the whites`'.")
  inspect(b4.sub_replacements("the whites`'."), content="the whites&#8217;.")
  let b5 = block_from_string("the whites`'--where the wild things are")
  inspect(
    b5.sub_replacements("the whites`'--where the wild things are"),
    content="the whites&#8217;--where the wild things are",
  )
  let b6 = block_from_string(
    (
      #|the whites`'
      #|have
    ),
  )
  inspect(
    b6.sub_replacements(
      (
        #|the whites`'
        #|have
      ),
    ),
    content=(
      #|the whites&#8217;
      #|have
    ),
  )
  let b7 = block_from_string("It's Mary`'s little lamb.")
  inspect(
    b7.sub_replacements("It's Mary`'s little lamb."),
    content="It&#8217;s Mary&#8217;s little lamb.",
  )
  let b8 = block_from_string("consecutive single quotes '' are not modified")
  inspect(
    b8.sub_replacements("consecutive single quotes '' are not modified"),
    content="consecutive single quotes '' are not modified",
  )
  let b9 = block_from_string("he is 6' tall")
  inspect(b9.sub_replacements("he is 6' tall"), content="he is 6' tall")
  let b10 = block_from_string("\\`'")
  inspect(b10.sub_replacements("\\`'"), content="`'")
}

///|
test "Post replacements: line break inserted after line with line break character" {
  let b1 = block_from_string(
    (
      #|First line +
      #|Second line
    ),
  )
  inspect(
    rb_inspect_subs(b1.expand_subs("post_replacements")),
    content="[:post_replacements]",
  )
  inspect(
    rb_inspect_lines(
      b1.apply_subs_lines(["First line +", "Second line"], [PostReplacements]),
    ),
    content="[\"First line<br>\", \"Second line\"]",
  )
}

///|
test "Post replacements: line break inserted after line wrap with hardbreaks enabled" {
  let b1 = block_from_string(
    (
      #|First line
      #|Second line
    ),
    attributes=[("hardbreaks", Str(""))],
  )
  inspect(
    rb_inspect_subs(b1.expand_subs("post_replacements")),
    content="[:post_replacements]",
  )
  inspect(
    rb_inspect_lines(
      b1.apply_subs_lines(["First line", "Second line"], [PostReplacements]),
    ),
    content="[\"First line<br>\", \"Second line\"]",
  )
}

///|
test "Post replacements: line break character stripped from end of line with hardbreaks enabled" {
  let b1 = block_from_string(
    (
      #|First line +
      #|Second line
    ),
    attributes=[("hardbreaks", Str(""))],
  )
  inspect(
    rb_inspect_subs(b1.expand_subs("post_replacements")),
    content="[:post_replacements]",
  )
  inspect(
    rb_inspect_lines(
      b1.apply_subs_lines(["First line +", "Second line"], [PostReplacements]),
    ),
    content="[\"First line<br>\", \"Second line\"]",
  )
}

///|
test "Post replacements: line break not inserted for single line with hardbreaks enabled" {
  let b1 = block_from_string("First line", attributes=[("hardbreaks", Str(""))])
  inspect(
    rb_inspect_subs(b1.expand_subs("post_replacements")),
    content="[:post_replacements]",
  )
  inspect(
    rb_inspect_lines(b1.apply_subs_lines(["First line"], [PostReplacements])),
    content="[\"First line\"]",
  )
}

// ---------------------------------------------------------------------------
// Hand-ported tests. Restores that need the HTML converter are checked via
// `apply_subs(text, [Macros])`, which is exactly extract_passthroughs ->
// sub_macros (a no-op on the placeholder) -> restore_passthroughs. The log
// assertions matter because the golden fixtures do not compare log messages.
// Ruby's MemoryLogger has level UNKNOWN (so info?/debug? are false), hence
// `min_level=2` when comparing with an `assert_empty logger` / assert_message.

///|
test "Passthroughs: resolves sub shorthands on inline pass macro (restore)" {
  let para = block_from_string("pass:q,a[*<{backend}>*]")
  inspect(
    para.apply_subs("pass:q,a[*<{backend}>*]", [Macros]),
    content="<strong><html5></strong>",
  )
}

///|
test "Passthroughs: inline pass macro supports incremental subs (restore)" {
  let para = block_from_string("pass:n,-a[<{backend}>]")
  inspect(
    para.apply_subs("pass:n,-a[<{backend}>]", [Macros]),
    content="&lt;{backend}&gt;",
  )
}

///|
test "Passthroughs: should allow content of inline pass macro to be empty (restore)" {
  let para = block_from_string("pass:[]")
  inspect(para.apply_subs("pass:[]", [Macros]), content="")
}

///|
test "Passthroughs: should warn if substitutions on pass macro are invalid" {
  let (content, logs) = @core.with_memory_logger(() => {
    block_from_string("pass:bogus[++]", attributes=[("stem", Str("asciimath"))]).content()
  })
  inspect(content, content="++")
  inspect(
    log_lines(logs, min_level=2),
    content="WARN: invalid substitution type for passthrough macro: bogus",
  )
}

///|
test "Math macros: should warn if substitutions on stem macro are invalid" {
  let (content, logs) = @core.with_memory_logger(() => {
    block_from_string("stem:bogus[x^2]", attributes=[("stem", Str("asciimath"))]).content()
  })
  inspect(content, content="\\$x^2\\$")
  inspect(
    log_lines(logs, min_level=2),
    content="WARN: invalid substitution type for stem macro: bogus",
  )
}

///|
test "Math macros: should passthrough text in asciimath macro and surround with AsciiMath delimiters" {
  let (content, logs) = @core.with_memory_logger(() => {
    block_from_string(
      "asciimath:[x/x={(1,if x!=0),(text{undefined},if x=0):}]",
      attributes=[("attribute-missing", Str("warn"))],
    ).content()
  })
  inspect(content, content="\\$x/x={(1,if x!=0),(text{undefined},if x=0):}\\$")
  inspect(log_lines(logs, min_level=2), content="")
}

///|
test "Math macros: should passthrough text in stem macro and surround with AsciiMath delimiters if stem attribute is asciimath, empty, or not set" {
  let variants : Array[Array[(String, @core.AttrVal)]] = [
    [],
    [("stem", Str(""))],
    [("stem", Str("asciimath"))],
    [("stem", Str("bogus"))],
  ]
  for attributes in variants {
    let (content, logs) = @core.with_memory_logger(() => {
      block_from_string(
        "stem:[x/x={(1,if x!=0),(text{undefined},if x=0):}]",
        attributes=attributes + [("attribute-missing", Str("warn"))],
      ).content()
    })
    assert_eq(content, "\\$x/x={(1,if x!=0),(text{undefined},if x=0):}\\$")
    assert_eq(log_lines(logs, min_level=2), "")
  }
}

///|
test "Macros: inline footnote macro can be used to define and reference a footnote reference" {
  let input =
    #|You can download the software from the product page.footnote:sub[Option only available if you have an active subscription.]
    #|
    #|You can also file a support request.footnote:sub[]
    #|
    #|If all else fails, you can give us a call.footnoteref:[sub]
    #|
  let (output, logs) = @core.with_memory_logger(() => {
    @asciidoctor.convert(
      input,
      options=@core.Options::new(standalone=false, attributes=[
        ("compat-mode", Str("")),
      ]),
    )
  })
  // one footnote definition referenced three times
  inspect(output.split("_footnotedef_1").count() - 1, content="4")
  inspect(log_lines(logs, min_level=2), content="")
}

///|
test "Macros: should substitute attributes in target of inline image in section title" {
  let (sect, logs) = @core.with_memory_logger(() => {
    block_from_string(
      "== image:{iconsdir}/dot.gif[dot] Title",
      attributes=[
        ("data-uri", Str("")),
        ("iconsdir", Str("fixtures")),
        ("docdir", Str("/test")),
      ],
      safe=@core.SAFE_SERVER,
      catalog_assets=true,
      vfs=fixture_vfs(),
    )
  })
  debug_inspect(
    sect.document().catalog().images,
    content=(
      #|[{ target: "fixtures/dot.gif", imagesdir: None }]
    ),
  )
  inspect(log_lines(logs, min_level=2), content="")
}

///|
// Not in substitutions_test.rb: the info message guarded by `logger.info?`
// (Ruby substitutors.rb#sub_macros, xref handling), verified with Ruby using a
// MemoryLogger whose level is INFO.
test "Macros: unresolved xref logs possible invalid reference at info level (extra)" {
  let para = block_from_string("<<missing>>")
  let (result, logs) = @core.with_memory_logger(() => {
    para.sub_macros("&lt;&lt;missing&gt;&gt;")
  })
  inspect(result, content="<a href=\"#missing\">[missing]</a>")
  inspect(log_lines(logs), content="INFO: possible invalid reference: missing")
}
