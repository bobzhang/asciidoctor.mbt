// Direct-API tests ported from test/substitutions_test.rb.
//
// These were generated by replaying the Ruby test file with its substitution
// methods instrumented: every sub_* / apply_subs / expand_subs call made
// directly by a test is reproduced here with the argument Ruby received, the
// document/block attribute changes the test made before the call, and the
// result Ruby returned (and the footnotes / log messages it produced, where
// the test asserted them). Ruby `apply_subs(text, nil)` maps to an empty subs
// list; symbol arrays passed to `expand_subs` map to the comma-joined string
// form the port accepts. Tests exercising extract_passthroughs /
// restore_passthroughs (private in the port) live in
// substitutions_api_wbtest.mbt; hand-ported tests follow the generated ones
// at the end of this file.

///|
test "Dispatcher: apply normal substitutions" {
  let b1 = block_from_string(
    (
      #|[blue]_http://asciidoc.org[AsciiDoc]_ & [red]*Ruby*
      #|&#167; Making +++<u>documentation</u>+++ together +
      #|since (C) {inception_year}.
    ),
  )
  b1.document().attributes.set("inception_year", Str("2012"))
  inspect(
    b1.apply_subs(
      (
        #|[blue]_http://asciidoc.org[AsciiDoc]_ & [red]*Ruby*
        #|&#167; Making +++<u>documentation</u>+++ together +
        #|since (C) {inception_year}.
      ),
      @core.normal_subs,
    ),
    content=(
      #|<em class="blue"><a href="http://asciidoc.org">AsciiDoc</a></em> &amp; <strong class="red">Ruby</strong>
      #|&#167; Making <u>documentation</u> together<br>
      #|since &#169; 2012.
    ),
  )
}

///|
test "Dispatcher: apply_subs should not modify string directly" {
  let b1 = block_from_string("<html> -- the root of all web")
  inspect(
    b1.apply_subs("<html> -- the root of all web", @core.normal_subs),
    content="&lt;html&gt;&#8201;&#8212;&#8201;the root of all web",
  )
}

///|
test "Dispatcher: should not drop trailing blank lines when performing substitutions" {
  let b1 = block_from_string(
    (
      #|[%hardbreaks]
      #|this
      #|is
      #|-> {program}
    ),
  )
  b1.document().attributes.set("program", Str("Asciidoctor"))
  inspect(
    rb_inspect_lines(
      b1.apply_subs_lines(
        ["this", "is", "-> {program}", "", ""],
        @core.normal_subs,
      ),
    ),
    content="[\"this<br>\", \"is<br>\", \"&#8594; Asciidoctor<br>\", \"<br>\", \"\"]",
  )
  inspect(
    b1.apply_subs(
      (
        #|this
        #|is
        #|-> {program}
        #|
        #|
      ),
      @core.normal_subs,
    ),
    content=(
      #|this<br>
      #|is<br>
      #|&#8594; Asciidoctor<br>
      #|<br>
      #|
    ),
  )
}

///|
test "Dispatcher: should expand subs passed to expand_subs" {
  let b1 = block_from_string(
    (
      #|{program}
      #|*bold*
      #|2 > 1
    ),
  )
  b1.document().attributes.set("program", Str("Asciidoctor"))
  inspect(
    rb_inspect_subs(b1.expand_subs("specialchars")),
    content="[:specialcharacters]",
  )
  inspect(rb_inspect_subs(b1.expand_subs("none")), content="nil")
  inspect(
    rb_inspect_subs(b1.expand_subs("normal")),
    content="[:specialcharacters, :quotes, :attributes, :replacements, :macros, :post_replacements]",
  )
}

///|
test "Dispatcher: apply_subs should allow the subs argument to be nil" {
  let b1 = block_from_string(
    (
      #|[pass]
      #|*raw*
    ),
  )
  inspect(b1.apply_subs("*raw*", []), content="*raw*")
}

///|
test "Quotes: single-line double-quoted string" {
  let b1 = block_from_string("``a few quoted words''", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.sub_quotes("``a few quoted words''"),
    content="&#8220;a few quoted words&#8221;",
  )
  let b2 = block_from_string("\"`a few quoted words`\"")
  inspect(
    b2.sub_quotes("\"`a few quoted words`\""),
    content="&#8220;a few quoted words&#8221;",
  )
  let b3 = block_from_string("\"`a few quoted words`\"", backend="docbook")
  inspect(
    b3.sub_quotes("\"`a few quoted words`\""),
    content="<quote role=\"double\">a few quoted words</quote>",
  )
}

///|
test "Quotes: escaped single-line double-quoted string" {
  let b1 = block_from_string("\\``a few quoted words''", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.sub_quotes("\\``a few quoted words''"),
    content="&#8216;`a few quoted words&#8217;'",
  )
  let b2 = block_from_string("\\\\``a few quoted words''", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b2.sub_quotes("\\\\``a few quoted words''"),
    content="``a few quoted words''",
  )
  let b3 = block_from_string("\\\"`a few quoted words`\"")
  inspect(
    b3.sub_quotes("\\\"`a few quoted words`\""),
    content="\"`a few quoted words`\"",
  )
  let b4 = block_from_string("\\\\\"`a few quoted words`\"")
  inspect(
    b4.sub_quotes("\\\\\"`a few quoted words`\""),
    content="\\\"`a few quoted words`\"",
  )
}

///|
test "Quotes: multi-line double-quoted string" {
  let b1 = block_from_string(
    (
      #|``a few
      #|quoted words''
    ),
    attributes=[("compat-mode", Str(""))],
  )
  inspect(
    b1.sub_quotes(
      (
        #|``a few
        #|quoted words''
      ),
    ),
    content=(
      #|&#8220;a few
      #|quoted words&#8221;
    ),
  )
  let b2 = block_from_string(
    (
      #|"`a few
      #|quoted words`"
    ),
  )
  inspect(
    b2.sub_quotes(
      (
        #|"`a few
        #|quoted words`"
      ),
    ),
    content=(
      #|&#8220;a few
      #|quoted words&#8221;
    ),
  )
}

///|
test "Quotes: double-quoted string with inline single quote" {
  let b1 = block_from_string("``Here's Johnny!''", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.sub_quotes("``Here's Johnny!''"),
    content="&#8220;Here's Johnny!&#8221;",
  )
  let b2 = block_from_string("\"`Here's Johnny!`\"")
  inspect(
    b2.sub_quotes("\"`Here's Johnny!`\""),
    content="&#8220;Here's Johnny!&#8221;",
  )
}

///|
test "Quotes: double-quoted string with inline backquote" {
  let b1 = block_from_string("``Here`s Johnny!''", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.sub_quotes("``Here`s Johnny!''"),
    content="&#8220;Here`s Johnny!&#8221;",
  )
  let b2 = block_from_string("\"`Here`s Johnny!`\"")
  inspect(
    b2.sub_quotes("\"`Here`s Johnny!`\""),
    content="&#8220;Here`s Johnny!&#8221;",
  )
}

///|
test "Quotes: double-quoted string around monospaced text" {
  let b1 = block_from_string("\"``E=mc^2^` is the solution!`\"")
  inspect(
    b1.apply_subs("\"``E=mc^2^` is the solution!`\"", @core.normal_subs),
    content="&#8220;`E=mc<sup>2</sup>` is the solution!&#8221;",
  )
  let b2 = block_from_string("\"```E=mc^2^`` is the solution!`\"")
  inspect(
    b2.apply_subs("\"```E=mc^2^`` is the solution!`\"", @core.normal_subs),
    content="&#8220;<code>E=mc<sup>2</sup></code> is the solution!&#8221;",
  )
}

///|
test "Quotes: single-line single-quoted string" {
  let b1 = block_from_string("`a few quoted words'", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.sub_quotes("`a few quoted words'"),
    content="&#8216;a few quoted words&#8217;",
  )
  let b2 = block_from_string("'`a few quoted words`'")
  inspect(
    b2.sub_quotes("'`a few quoted words`'"),
    content="&#8216;a few quoted words&#8217;",
  )
  let b3 = block_from_string("'`a few quoted words`'", backend="docbook")
  inspect(
    b3.sub_quotes("'`a few quoted words`'"),
    content="<quote role=\"single\">a few quoted words</quote>",
  )
}

///|
test "Quotes: escaped single-line single-quoted string" {
  let b1 = block_from_string("\\`a few quoted words'", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.sub_quotes("\\`a few quoted words'"),
    content="`a few quoted words'",
  )
  let b2 = block_from_string("\\'`a few quoted words`'")
  inspect(
    b2.sub_quotes("\\'`a few quoted words`'"),
    content="'`a few quoted words`'",
  )
}

