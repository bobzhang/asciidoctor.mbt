///|
test "Quotes: single-line constrained marked string" {
  let b1 = block_from_string("#a few words#")
  inspect(b1.sub_quotes("#a few words#"), content="<mark>a few words</mark>")
}

///|
test "Quotes: escaped single-line constrained marked string" {
  let b1 = block_from_string("\\#a few words#")
  inspect(b1.sub_quotes("\\#a few words#"), content="#a few words#")
}

///|
test "Quotes: multi-line constrained marked string" {
  let b1 = block_from_string(
    (
      #|#a few
      #|words#
    ),
  )
  inspect(
    b1.sub_quotes(
      (
        #|#a few
        #|words#
      ),
    ),
    content=(
      #|<mark>a few
      #|words</mark>
    ),
  )
}

///|
test "Quotes: constrained marked string should not match entity references" {
  let b1 = block_from_string("111 #mark a# 222 \"`quote a`\" 333 #mark b# 444")
  inspect(
    b1.sub_quotes("111 #mark a# 222 \"`quote a`\" 333 #mark b# 444"),
    content="111 <mark>mark a</mark> 222 &#8220;quote a&#8221; 333 <mark>mark b</mark> 444",
  )
}

///|
test "Quotes: single-line unconstrained marked string" {
  let b1 = block_from_string("##--anything goes ##")
  inspect(
    b1.sub_quotes("##--anything goes ##"),
    content="<mark>--anything goes </mark>",
  )
}

///|
test "Quotes: escaped single-line unconstrained marked string" {
  let b1 = block_from_string("\\\\##--anything goes ##")
  inspect(
    b1.sub_quotes("\\\\##--anything goes ##"),
    content="##--anything goes ##",
  )
}

///|
test "Quotes: multi-line unconstrained marked string" {
  let b1 = block_from_string(
    (
      #|##--anything
      #|goes ##
    ),
  )
  inspect(
    b1.sub_quotes(
      (
        #|##--anything
        #|goes ##
      ),
    ),
    content=(
      #|<mark>--anything
      #|goes </mark>
    ),
  )
}

///|
test "Quotes: single-line constrained marked string with role" {
  let b1 = block_from_string("[statement]#a few words#")
  inspect(
    b1.sub_quotes("[statement]#a few words#"),
    content="<span class=\"statement\">a few words</span>",
  )
}

///|
test "Quotes: does not recognize attribute list with left square bracket on formatted text" {
  let b1 = block_from_string("key: [ *before [.redacted]#redacted# after* ]")
  inspect(
    b1.sub_quotes("key: [ *before [.redacted]#redacted# after* ]"),
    content="key: [ <strong>before <span class=\"redacted\">redacted</span> after</strong> ]",
  )
}

///|
test "Quotes: single-line constrained strong string" {
  let b1 = block_from_string("*a few strong words*")
  inspect(
    b1.sub_quotes("*a few strong words*"),
    content="<strong>a few strong words</strong>",
  )
}

///|
test "Quotes: escaped single-line constrained strong string" {
  let b1 = block_from_string("\\*a few strong words*")
  inspect(
    b1.sub_quotes("\\*a few strong words*"),
    content="*a few strong words*",
  )
}

///|
test "Quotes: multi-line constrained strong string" {
  let b1 = block_from_string(
    (
      #|*a few
      #|strong words*
    ),
  )
  inspect(
    b1.sub_quotes(
      (
        #|*a few
        #|strong words*
      ),
    ),
    content=(
      #|<strong>a few
      #|strong words</strong>
    ),
  )
}

///|
test "Quotes: constrained strong string containing an asterisk" {
  let b1 = block_from_string("*bl*ck*-eye")
  inspect(b1.sub_quotes("*bl*ck*-eye"), content="<strong>bl*ck</strong>-eye")
}

///|
test "Quotes: constrained strong string containing an asterisk and multibyte word chars" {
  let b1 = block_from_string("*黑*眼圈*")
  inspect(b1.sub_quotes("*黑*眼圈*"), content="<strong>黑*眼圈</strong>")
}

///|
test "Quotes: single-line constrained quote variation emphasized string" {
  let b1 = block_from_string("_a few emphasized words_")
  inspect(
    b1.sub_quotes("_a few emphasized words_"),
    content="<em>a few emphasized words</em>",
  )
}

///|
test "Quotes: escaped single-line constrained quote variation emphasized string" {
  let b1 = block_from_string("\\_a few emphasized words_")
  inspect(
    b1.sub_quotes("\\_a few emphasized words_"),
    content="_a few emphasized words_",
  )
}

///|
test "Quotes: escaped single quoted string" {
  let b1 = block_from_string("\\'a few emphasized words'")
  inspect(
    b1.sub_quotes("\\'a few emphasized words'"),
    content="\\'a few emphasized words'",
  )
}

///|
test "Quotes: multi-line constrained emphasized quote variation string" {
  let b1 = block_from_string(
    (
      #|_a few
      #|emphasized words_
    ),
  )
  inspect(
    b1.sub_quotes(
      (
        #|_a few
        #|emphasized words_
      ),
    ),
    content=(
      #|<em>a few
      #|emphasized words</em>
    ),
  )
}

///|
test "Quotes: single-quoted string containing an emphasized phrase" {
  let b1 = block_from_string("`I told him, 'Just go for it!''", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.sub_quotes("`I told him, 'Just go for it!''"),
    content="&#8216;I told him, <em>Just go for it!</em>&#8217;",
  )
  let b2 = block_from_string("'`I told him, 'Just go for it!'`'")
  inspect(
    b2.sub_quotes("'`I told him, 'Just go for it!'`'"),
    content="&#8216;I told him, 'Just go for it!'&#8217;",
  )
}

///|
test "Quotes: escaped single-quotes inside emphasized words are restored" {
  let b1 = block_from_string("'Here\\'s Johnny!'", attributes=[
    ("compat-mode", Str("")),
  ])
  inspect(
    b1.apply_subs("'Here\\'s Johnny!'", @core.normal_subs),
    content="<em>Here's Johnny!</em>",
  )
  let b2 = block_from_string("'Here\\'s Johnny!'")
  inspect(
    b2.apply_subs("'Here\\'s Johnny!'", @core.normal_subs),
    content="'Here's Johnny!'",
  )
}

///|
test "Quotes: single-line constrained emphasized underline variation string" {
  let b1 = block_from_string("_a few emphasized words_")
  inspect(
    b1.sub_quotes("_a few emphasized words_"),
    content="<em>a few emphasized words</em>",
  )
}

///|
test "Quotes: escaped single-line constrained emphasized underline variation string" {
  let b1 = block_from_string("\\_a few emphasized words_")
  inspect(
    b1.sub_quotes("\\_a few emphasized words_"),
    content="_a few emphasized words_",
  )
}

///|
test "Quotes: multi-line constrained emphasized underline variation string" {
  let b1 = block_from_string(
    (
      #|_a few
      #|emphasized words_
    ),
  )
  inspect(
    b1.sub_quotes(
      (
        #|_a few
        #|emphasized words_
      ),
    ),
    content=(
      #|<em>a few
      #|emphasized words</em>
