    "unconstrained",
    @regex.re("\\\\?(?:\\[([^\\[\\]]+)\\])?~(\\S+?)~"),
  ),
]

///|
let replacements : Array[(@regex.Regex, String, String)] = [
  (@regex.re("\\\\?\\(C\\)"), "&#169;", "none"),
  (@regex.re("\\\\?\\(R\\)"), "&#174;", "none"),
  (@regex.re("\\\\?\\(TM\\)"), "&#8482;", "none"),
  (@regex.re("(?: |\\n|^|\\\\)--(?: |\\n|$)"), "&#8201;&#8212;&#8201;", "none"),
  (@regex.re("(\\p{Word})\\\\?--(?=\\p{Word})"), "&#8212;&#8203;", "leading"),
  (@regex.re("\\\\?\\.\\.\\."), "&#8230;&#8203;", "none"),
  (@regex.re("\\\\?`'"), "&#8217;", "none"),
  (@regex.re("(\\p{Alnum})\\\\?'(?=\\p{Alpha})"), "&#8217;", "leading"),
  (@regex.re("\\\\?-&gt;"), "&#8594;", "none"),
  (@regex.re("\\\\?=&gt;"), "&#8658;", "none"),
  (@regex.re("\\\\?&lt;-"), "&#8592;", "none"),
  (@regex.re("\\\\?&lt;="), "&#8656;", "none"),
  (
    @regex.re(
      "\\\\?(&)amp;((?:[a-zA-Z][a-zA-Z]+\\d{0,2}|#\\d\\d\\d{0,4}|#x[\\da-fA-F][\\da-fA-F][\\da-fA-F]{0,3});)",
    ),
    "",
    "bounding",
  ),
]

///|
let inline_pass_rx_false : (String, String?, @regex.Regex) = (
  "+",
  Some("-]"),
  @regex.re(
    "((?:^|[^\\p{Word};:\\\\])(?=(\\[)|\\+)|\\\\(?=\\[)|(?=\\\\\\+))(?:\\2(x-|[^\\[\\]]+ x-)\\]|(?:\\[([^\\[\\]]+)\\])?(?=(\\\\)?\\+))(\\5?(\\+|`)(\\S|\\S.*?\\S)\\7)(?!\\p{Word})",
    flags="m",
  ),
)

///|
let inline_pass_rx_true : (String, String?, @regex.Regex) = (
  "`",
  None,
  @regex.re(
    "(^|[^`\\p{Word}])(?:(\\Z)()|\\[([^\\[\\]]+)\\](?=(\\\\))?)?(\\5?(`)([^`\\s]|[^`\\s].*?\\S)\\7)(?![`\\p{Word}])",
    flags="m",
  ),
)
