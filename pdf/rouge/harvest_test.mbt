  check_lex(
    "yaml", "---\none: Mark McGwire\ntwo: Sammy Sosa\nthree: Ken Griffey\n", "nn:3 :1 na:3 pi:1 :1 s:12 :1 na:3 pi:1 :1 s:10 :1 na:5 pi:1 :1 s:11 :1",
  )
}

