///|
test "rouge: erb: visual sample" {
  check_lex(
    "erb", "<h3>List</h3>\n<% if !@list || @list.empty? %>\n<p>not found.</p>\n<% else %>\n<table>\n  <tbody>\n    <% @list.each_with_index do |item, i| %>\n    <tr bgcolor=\"<%= i%2 == 0 ? '#FFCCCC' : '#CCCCFF' %>\">\n      <td><%= item %></td>\n    </tr>\n    <% end %>\n  </tbody>\n</table>\n<% end %>\n\n<%# Sometimes you just need to use a variable or two %>\n<% header_tag = 'h1' %>\n\n<<%= header_tag %>>\n  it's a header!\n</<%= header_tag %>>\n\n<p>\n  Some text\n</p>\n<script>\n  var foo = 1;\n  var bar = <%= bar %>;\n  var baz = {\n    a: 1,\n    b: 2\n  };\n</script>\n<style>\n.foo {\n  line-height: <%= @line_height %>\n}\n</style>\n<p>\n  Some another text\n</p>\nthumbsup 0\n",
    "nt:4 :4 nt:5 :1 cp:2 :1 k:2 :1 o:1 vi:5 :1 o:2 :1 vi:5 p:1 nf:6 :1 cp:2 :1 nt:3 :10 nt:4 :1 cp:2 :1 k:4 :1 cp:2 :1 nt:7 :3 nt:7 :5 cp:2 :1 vi:5 p:1 nf:15 :1 k:2 :1 o:1 n:4 p:1 :1 n:1 o:1 :1 cp:2 :5 nt:3 :1 na:8 s:1 cp:3 :1 n:1 o:1 mi:1 :1 o:2 :1 mi:1 :1 p:1 :1 s1:9 :1 p:1 :1 s1:9 :1 cp:2 s:1 nt:1 :7 nt:4 cp:3 :1 n:4 :1 cp:2 nt:5 :5 nt:5 :5 cp:2 :1 k:3 :1 cp:2 :3 nt:8 :1 nt:8 :1 cp:2 :1 k:3 :1 cp:2 :2 c:55 :1 cp:2 :1 n:10 :1 o:1 :1 s1:4 :1 cp:2 :2 nt:1 cp:3 :1 n:10 :1 cp:2 nt:1 :18 nt:2 cp:3 :1 n:10 :1 cp:2 nt:1 :2 nt:3 :13 nt:4 :1 nt:8 :3 kd:3 :1 nx:3 :1 o:1 :1 mi:1 p:1 :3 kd:3 :1 nx:3 :1 o:1 :1 cp:3 :1 n:3 :1 cp:2 p:1 :3 kd:3 :1 nx:3 :1 o:1 :1 p:1 :5 na:1 p:1 :1 mi:1 p:1 :5 na:1 p:1 :1 mi:1 :3 p:2 :1 nt:9 :1 nt:7 :1 nc:4 :1 p:1 :3 nl:11 p:1 :1 cp:3 :1 vi:12 :1 cp:2 :1 p:1 :1 nt:8 :1 nt:3 :21 nt:4 :12",
  )
}

