///|
test "rouge: css: visual sample" {
  check_lex(
    "css", "body {\n    font-size: 12pt;\n    background   : #fff url(temp.png) top left no-repeat;\n    width: 75%;\n}\n\n* html body {\n    font-size: 14pt;\n}\n\n#nav .new {\n    display: block;\n}\n\nul#nav li.new {\n    font-weight: bold;\n}\n\n:link {\n    color: #f00;\n}\n\n:link:hover {\n    color: #0f0;\n}\n\n*::before {\n  content: \"text\";\n}\n\n:first-child::after {\n  display: none;\n}\n\n.class:first-child:focus::after {\n  display: none;\n}\n\n#thing {\n  font: normal 400 12px/35px Helvetica, Arial, sans-serif;\n}\n\n@media screen {\n  body {\n    background: #ccc;\n  }\n}\n\n@namespace \"http://www.w3.org/1999/xhtml\";\n\n@import url(\"mystyle.css\");\n\n@charset \"ISO-8859-1\";\n\n@font-face { font-family: \"Example Font\"; src: url(\"http://www.example.com/fonts/example\"); }\n\n@media screen { body { font-size: 16px } } @media print { body { font-size: 12pt } }\n\n\n@page { body { margin: 1in 1.5in; } }\n\n@page linke-seite:left { body { margin:20mm; margin-right:25mm; } }\n\n@-moz-document url-prefix(http://pygments.org) {  a {font-style: normal !important;} }\n\n#foo {\n  unrecognized-prop: 1;\n  -moz-prefixed-prop: 2;\n  font-size: 29px ! important;\n}\n\na[target=\"_blank\"] {\n    background-color: yellow;\n}\n\n/* Unicode example */\nœuvre 书名[语言=\"français\"] {\n  color: blue;\n}\n",
    "nt:4 :1 p:1 :5 nl:9 p:1 :1 m:4 p:1 :5 nl:10 :3 p:1 :1 m:4 :1 sx:13 :1 nb:3 :1 nb:4 :1 nb:9 p:1 :5 nl:5 p:1 :1 m:3 p:1 :1 p:1 :2 o:1 :1 nt:4 :1 nt:4 :1 p:1 :5 nl:9 p:1 :1 m:4 p:1 :1 p:1 :2 nf:4 :1 nc:4 :1 p:1 :5 nl:7 p:1 :1 nb:5 p:1 :1 p:1 :2 nt:2 nf:4 :1 nt:2 nc:4 :1 p:1 :5 nl:11 p:1 :1 nb:4 p:1 :1 p:1 :2 nd:5 :1 p:1 :5 nl:5 p:1 :1 m:4 p:1 :1 p:1 :2 nd:11 :1 p:1 :5 nl:5 p:1 :1 m:4 p:1 :1 p:1 :2 o:1 nd:8 :1 p:1 :3 nl:7 p:1 :1 s1:6 p:1 :1 p:1 :2 nd:19 :1 p:1 :3 nl:7 p:1 :1 nb:4 p:1 :1 p:1 :2 nc:6 nd:25 :1 p:1 :3 nl:7 p:1 :1 nb:4 p:1 :1 p:1 :2 nf:6 :1 p:1 :3 nl:4 p:1 :1 nb:6 :1 m:3 :1 m:4 p:1 m:4 :1 n:9 p:1 :1 n:5 p:1 :1 nb:10 p:1 :1 p:1 :2 k:6 :1 n:6 :1 p:1 :3 nt:4 :1 p:1 :5 nl:10 p:1 :1 m:4 p:1 :3 p:1 :1 p:1 :2 k:10 :1 s1:30 p:1 :2 k:7 :1 sx:18 p:1 :2 k:8 :1 s1:12 p:1 :2 k:10 :1 p:1 :1 nl:11 p:1 :1 s1:14 p:1 :1 nl:3 p:1 :1 sx:43 p:1 :1 p:1 :2 k:6 :1 n:6 :1 p:1 :1 nt:4 :1 p:1 :1 nl:9 p:1 :1 m:4 :1 p:1 :1 p:1 :1 k:6 :1 n:5 :1 p:1 :1 nt:4 :1 p:1 :1 nl:9 p:1 :1 m:4 :1 p:1 :1 p:1 :3 k:5 :1 p:1 :1 nt:4 :1 p:1 :1 nl:6 p:1 :1 m:3 :1 m:5 p:1 :1 p:1 :1 p:1 :2 k:5 :1 n:11 p:1 nb:4 :1 p:1 :1 nt:4 :1 p:1 :1 nl:6 p:1 m:4 p:1 :1 nl:12 p:1 m:4 p:1 :1 p:1 :1 p:1 :2 k:14 :1 n:10 p:1 n:4 p:3 n:8 p:1 n:3 p:1 :1 p:1 :2 nt:1 :1 p:1 nl:10 p:1 :1 nb:6 :1 cp:10 p:2 :1 p:1 :2 nf:4 :1 p:1 :3 py:17 p:1 :1 m:1 p:1 :3 nl:18 p:1 :1 m:1 p:1 :3 nl:9 p:1 :1 m:4 :1 cp:11 p:1 :1 p:1 :2 nt:1 o:1 nt:6 o:1 s1:8 o:1 :1 p:1 :5 nl:16 p:1 :1 no:6 p:1 :1 p:1 :2 c:21 :1 nt:5 :1 nt:2 o:1 nt:2 o:1 s1:10 o:1 :1 p:1 :3 nl:5 p:1 :1 no:4 p:1 :1 p:1 :1",
