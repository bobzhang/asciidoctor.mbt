test "rouge: html: visual sample" {
  check_lex(
    "html", "<!DOCTYPE html>\n<html>\n<head>\n<script>\n    function initCodeBlock(id); {\n        var el = document.getElementById(id);\n    }\n</script>\n<script> \"hello < world\" </script>\n<style>\n/* comment */\n.syntax { color: #60a0b0; font-style: italic; }\n</style>\n<link rel=\"stylesheet\" href=\"/assets/css/style.css?v=1\">\n<script src=\"//html5shiv.googlecode.com/svn/trunk/html5.js\"></script>\n</head>\n<body>\n  <h1>Hello world!</h1>\n\n  <h2 class=\"outer\">\n    <span class=\"inner\">Goodbye world!</span>\n  </h2>\n\n  <pre id = \"code-block\" class=\"syntax\">\n    <span class=\"cm\"># -*- coding: utf-8 -*-</span>\n    <span class=\"st st-db\">&quot;&quot;&quot;</span><span class=\"st\">\n      hello.world.goodbye.world\n    </span>\n  </pre>\n</body>\n</html>\n\n<!-- free-floating tags -->\n<strong>Hello free-floating world!</strong>\n\n<!-- different attribute styles -->\n<span id=unquoted>Hello unquoted attribute world!</span>\n<span id='single'>Hello single-quoted attribute world!</span>\n<span id=\"double\">Hello double-quoted attribute world!</span>\n<span id = spaced>Hello spaced attribute world!</span>\n\n<!-- broken tags -->\n<\\div>Hello broken world!</div>\n<div>Hello broken world!<div\\>\n\n<!-- nested tags -->\n<table><tr><td>Hello nested world!</td></tr></table>\n\n<!-- no tags -->\nHello tagless world!\n\n<!-- custom Angular 2-style tags -->\n<custom-element *ng-structural-directive></custom-element>\n<custom-element #ref></custom-element>\n<custom-element [target]=\"expression\"></custom-element>\n<custom-element (target)=\"expression\"></custom-element>\n\n<!-- Unicode example -->\n<œuvre>\n\t<书名 语言=\"français\">Les Misérables</书名>\n</œuvre>\n",
    "cp:15 :1 nt:6 :1 nt:6 :1 nt:8 :5 kd:8 :1 nx:13 p:1 nx:2 p:2 :1 p:1 :9 kd:3 :1 nx:2 :1 o:1 :1 nb:8 p:1 nx:14 p:1 nx:2 p:2 :5 p:1 :1 nt:9 :1 nt:8 :1 dl:1 s2:13 dl:1 :1 nt:9 :1 nt:7 :1 c:13 :1 nc:7 :1 p:1 :1 nl:5 p:1 :1 m:7 p:1 :1 nl:10 p:1 :1 nb:6 p:1 :1 p:1 :1 nt:8 :1 nt:5 :1 na:4 s:12 :1 na:5 s:27 nt:1 :1 nt:8 na:4 s:47 nt:10 :1 nt:7 :1 nt:6 :3 nt:4 :12 nt:5 :4 nt:3 :1 na:6 s:7 nt:1 :5 nt:5 :1 na:6 s:7 nt:1 :14 nt:7 :3 nt:5 :4 nt:4 :1 na:5 s:12 :1 na:6 s:8 nt:1 :5 nt:5 :1 na:6 s:4 nt:1 :23 nt:7 :5 nt:5 :1 na:6 s:10 nt:1 ni:18 nt:12 :1 na:6 s:4 nt:1 :37 nt:7 :3 nt:6 :1 nt:7 :1 nt:7 :2 c:27 :1 nt:8 :26 nt:9 :2 c:35 :1 nt:5 :1 na:3 s:8 nt:1 :31 nt:7 :1 nt:5 :1 na:3 s:8 nt:1 :36 nt:7 :1 nt:5 :1 na:3 s:8 nt:1 :36 nt:7 :1 nt:5 :1 na:5 s:6 nt:1 :29 nt:7 :2 c:20 :1 nt:1 err:1 na:3 nt:1 :19 nt:6 :1 nt:5 :19 nt:4 err:1 nt:1 :2 c:20 :1 nt:15 :19 nt:18 :2 c:16 :23 c:36 :1 nt:15 :1 na:24 nt:18 :1 nt:15 :1 na:4 nt:18 :1 nt:15 :1 na:9 s:12 nt:18 :1 nt:15 :1 na:9 s:12 nt:18 :2 c:24 :1 nt:7 :2 nt:3 :1 na:3 s:10 nt:1 :14 nt:5 :1 nt:8 :1",
