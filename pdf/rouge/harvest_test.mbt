test "rouge: typescript: demo" {
  check_lex(
    "typescript", "$(document).ready(function() { alert('ready!'); });\n", "nx:1 p:1 nb:8 p:2 nx:5 p:1 kd:8 p:2 :1 p:1 :1 nx:5 p:1 dl:1 s1:6 dl:1 p:2 :1 p:3 :1",
  )
}

