test "rouge: vue: visual sample" {
  check_lex(
    "vue", "<template lang=\"jade\">\ndiv\n  p {{ greeting }} World!\n  other-component\n</template>\n\n<script>\nimport OtherComponent from './OtherComponent.vue'\n\nexport default {\n  data () {\n    return {\n      greeting: 'Hello'\n    }\n  },\n  components: {\n    OtherComponent\n  }\n}\n</script>\n\n<style lang=\"scss\">\n  .vue-carousel {\n    overflow: hidden;\n\n    &:hover {\n      display: none;\n      .next {\n        display: block;\n      }\n    }\n  }\n</style>\n\n<style lang=\"stylus\" scoped>\np\n  font-size 2em\n  text-align center\n</style>\n\n\n\n<template>\n  <p>{{ greeting }} World!</p>\n  {{ message | filterA('arg1', arg2) }}\n</template>\n\n<script>\nmodule.exports = {\n  data: function () {\n    return {\n      greeting: 'Hello'\n    }\n  }\n}\n</script>\n\n<style scoped>\np {\n  font-size: 2em;\n  text-align: center;\n}\n</style>\n\n<script lang=coffee>\n  module.exports = { data: -> { greeting: 'Hello' } }\n</script>\n\n<script lang='coffee'>\n  module.exports = { data: -> { greeting: 'Hello' } }\n</script>\n\n<script lang=\"coffee\">\n  module.exports = { data: -> { greeting: 'Hello' } }\n</script>\n\n<!-- Slot Shorthand -->\n<current-user v-slot:default=\"{ user }\">\n  {{ user.firstName }}\n</current-user>\n<current-user #default=\"{ user }\">\n  {{ user.firstName }}\n</current-user>\n",
    "nt:1 k:8 :1 na:5 s:6 nt:1 :9 si:2 :1 nx:8 :1 si:2 :26 nt:2 k:8 nt:1 :2 nt:1 k:6 nt:1 :1 k:6 :1 nx:14 :1 k:4 :1 dl:1 s1:20 dl:1 :2 k:6 :1 k:7 :1 p:1 :3 nx:4 :1 p:2 :1 p:1 :5 k:6 :1 p:1 :7 na:8 p:1 :1 dl:1 s1:5 dl:1 :5 p:1 :3 p:2 :3 na:10 p:1 :1 p:1 :5 nx:14 :3 p:1 :1 p:1 :1 nt:2 k:6 nt:1 :2 nt:1 k:5 :1 na:5 s:6 nt:1 :3 nc:13 :1 p:1 :5 nl:8 p:1 :1 nb:6 p:1 :6 k:1 nd:6 :1 p:1 :7 nl:7 p:1 :1 nb:4 p:1 :7 nc:5 :1 p:1 :9 nl:7 p:1 :1 nb:5 p:1 :7 p:1 :5 p:1 :3 p:1 :1 nt:2 k:5 nt:1 :2 nt:1 k:5 :1 na:5 s:8 :1 na:6 nt:1 :39 nt:2 k:5 nt:1 :4 nt:1 k:8 nt:1 :3 nt:3 si:2 :1 nx:8 :1 si:2 :7 nt:4 :3 si:2 :1 nx:7 :1 o:1 :1 nx:7 p:1 dl:1 s1:4 dl:1 p:1 :1 nx:4 p:1 :1 si:2 :1 nt:2 k:8 nt:1 :2 nt:1 k:6 nt:1 :1 nx:6 p:1 nx:7 :1 o:1 :1 p:1 :3 na:4 p:1 :1 kd:8 :1 p:2 :1 p:1 :5 k:6 :1 p:1 :7 na:8 p:1 :1 dl:1 s1:5 dl:1 :5 p:1 :3 p:1 :1 p:1 :1 nt:2 k:6 nt:1 :2 nt:1 k:5 :1 na:6 nt:1 :1 nt:1 :1 p:1 :3 nl:9 p:1 :1 m:3 p:1 :3 nl:10 p:1 :1 nb:6 p:1 :1 p:1 :1 nt:2 k:5 nt:1 :2 nt:1 k:6 :1 na:5 s:6 nt:1 :3 nx:6 p:1 nx:7 :1 o:1 :1 p:1 :1 na:4 p:1 :1 o:2 :1 p:1 :1 na:8 p:1 :1 dl:1 s1:5 dl:1 :1 p:1 :1 p:1 :1 nt:2 k:6 nt:1 :2 nt:1 k:6 :1 na:5 s:8 nt:1 :3 nx:6 p:1 nx:7 :1 o:1 :1 p:1 :1 na:4 p:1 :1 o:2 :1 p:1 :1 na:8 p:1 :1 dl:1 s1:5 dl:1 :1 p:1 :1 p:1 :1 nt:2 k:6 nt:1 :2 nt:1 k:6 :1 na:5 s:8 nt:1 :3 nx:6 p:1 nx:7 :1 o:1 :1 p:1 :1 na:4 p:1 :1 o:2 :1 p:1 :1 na:8 p:1 :1 dl:1 s1:5 dl:1 :1 p:1 :1 p:1 :1 nt:2 k:6 nt:1 :2 c:23 :1 nt:13 :1 na:15 s:10 nt:1 :24 nt:15 :1 nt:13 :1 na:9 s:10 nt:1 :24 nt:15 :1",
