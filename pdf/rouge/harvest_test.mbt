///|
test "rouge: css: demo" {
  check_lex(
    "css", "body {\n    font-size: 12pt;\n    background: #fff url(temp.png) top left no-repeat;\n}\n",
    "nt:4 :1 p:1 :5 nl:9 p:1 :1 m:4 p:1 :5 nl:10 p:1 :1 m:4 :1 sx:13 :1 nb:3 :1 nb:4 :1 nb:9 p:1 :1 p:1 :1",
  )
}

///|
test "rouge: css: visual sample" {
  check_lex(
    "css", "body {\n    font-size: 12pt;\n    background   : #fff url(temp.png) top left no-repeat;\n    width: 75%;\n}\n\n* html body {\n    font-size: 14pt;\n}\n\n#nav .new {\n    display: block;\n}\n\nul#nav li.new {\n    font-weight: bold;\n}\n\n:link {\n    color: #f00;\n}\n\n:link:hover {\n    color: #0f0;\n}\n\n*::before {\n  content: \"text\";\n}\n\n:first-child::after {\n  display: none;\n}\n\n.class:first-child:focus::after {\n  display: none;\n}\n\n#thing {\n  font: normal 400 12px/35px Helvetica, Arial, sans-serif;\n}\n\n@media screen {\n  body {\n    background: #ccc;\n  }\n}\n\n@namespace \"http://www.w3.org/1999/xhtml\";\n\n@import url(\"mystyle.css\");\n\n@charset \"ISO-8859-1\";\n\n@font-face { font-family: \"Example Font\"; src: url(\"http://www.example.com/fonts/example\"); }\n\n@media screen { body { font-size: 16px } } @media print { body { font-size: 12pt } }\n\n\n@page { body { margin: 1in 1.5in; } }\n\n@page linke-seite:left { body { margin:20mm; margin-right:25mm; } }\n\n@-moz-document url-prefix(http://pygments.org) {  a {font-style: normal !important;} }\n\n#foo {\n  unrecognized-prop: 1;\n  -moz-prefixed-prop: 2;\n  font-size: 29px ! important;\n}\n\na[target=\"_blank\"] {\n    background-color: yellow;\n}\n\n/* Unicode example */\nœuvre 书名[语言=\"français\"] {\n  color: blue;\n}\n",
