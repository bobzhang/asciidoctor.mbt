test "rouge: go: demo" {
  check_lex(
    "go", "package main\n\nimport \"fmt\"\n\nfunc main() {\n\tfmt.Println(\"Hello, 世界\")\n}\n",
    "k:7 :1 n:4 :2 k:6 :1 s:5 :2 k:4 :1 n:4 p:2 :1 p:1 :2 n:3 o:1 n:7 p:1 s:11 p:1 :1 p:1 :1",
  )
}

