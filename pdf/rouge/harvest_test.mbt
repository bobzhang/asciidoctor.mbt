    "n:5 :1 nl:7 :1 s1:6 :2 k:12 :1 o:1 :3 n:7 o:2 :1 o:1 :2 k:12 :1 o:1 :3 n:7 :1 s1:31 :3 n:7 :1 s1:47 :1 o:1 :1",
  )
