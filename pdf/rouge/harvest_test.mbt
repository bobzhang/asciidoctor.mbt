///|
test "rouge: tsx: visual sample" {
  check_lex(
    "tsx", "import * as React from 'react';\nimport * as ReactDOM from 'react-dom';\n\nconst myDivElement = <div className=\"foo\" />;\nReactDOM.render(myDivElement, document.getElementById('example'));\n\nclass MyComponent extends React.Component<{someProperty?: any, thing?: any}, void> {\n    static staticThing;\n}\n\nlet myElement: React.ReactElement<MyComponent>;\nmyElement = <MyComponent someProperty={true} />;\nReactDOM.render(myElement, document.getElementById('example'));\n\nmyElement = <MyComponent someProperty={{a:true}.a} />;\nmyElement = <MyComponent someProperty={function() {\n  var x = { a: true };\n  return x.a;\n}} />\n\nconst thing = {otherThing: 0};\n\nthing.otherThing<MyComponent.staticThing // comment - this is comparison\nmyElement = (\n  <MyComponent thing={thing.otherThing>2}>\n    hello, world!\n  </MyComponent>\n);\n\nclass Container extends React.Component<void, void> {}\nclass Nav extends React.Component<void, void> {}\nclass Login extends React.Component<void, void> {}\nclass Person extends React.Component<{name: string}, void> {}\nvar content = <Container>{window.isLoggedIn ? <Nav /> : <Login />}</Container>;\n\n// These two are equivalent in JSX for disabling a button\n<input type=\"button\" disabled />;\n<input type=\"button\" disabled={true} />;\n\n// And these two are equivalent in JSX for not disabling a button\n<input type=\"button\" />;\n<input type=\"button\" disabled={false} />;\n\nvar content = (\n  <Nav>\n    {/* child comment, put {} around */}\n    a slash-star that isn't a comment because this is html: /*\n    <Person\n      /* multi\n         line\n         comment */\n      name={window.isLoggedIn ? window.name : ''} // end of line comment\n    />\n  </Nav>\n);\n\nclass A extends React.Component<{b: void}, void> {}\nclass D extends React.Component<{e: boolean}, void> {}\n<A b={function() { var c = <D e={true}>&quot;</D>; }()}/>\n\nclass LikeButton extends React.Component<void, {liked: boolean}> {\n  public state = {\n    liked: false,\n  }\n\n  private handleClick = () => {\n    this.setState({liked: !this.state.liked});\n  }\n\n  public render() {\n    const text = this.state.liked ? 'liked' : 'haven\\'t liked';\n    return (\n      <div onClick={this.handleClick}>\n        You {text} this. Click to toggle.\n      </div>\n    );\n  }\n}\n\nReactDOM.render(\n  <LikeButton />,\n  document.getElementById('example')\n);\n\nconst withAuthRedirect = (route: string, redirectIfAuthed: boolean) => <P,>(\n  Page: NextComponentType<NextPageContext, {}, P>\n) => {\n  return class extends React.Component<P> {\n    static async getInitialProps(ctx: NextPageContext) {\n      const shouldContinue = await redirectBasedOnLogin(\n        ctx,\n        route,\n        redirectIfAuthed\n      );\n      if (!shouldContinue) {\n        return {};\n      }\n      if (Page.getInitialProps) {\n        return Page.getInitialProps(ctx);\n      }\n    }\n\n    render() {\n      return <Page {...this.props} />;\n    }\n  };\n};\n\nexport const withLoginRedirect = withAuthRedirect('/login', false);\nexport const withDashboardRedirect = withAuthRedirect('/dashboard', true);\n",
    "k:6 :1 o:1 :1 k:2 :1 nx:5 :1 k:4 :1 dl:1 s1:5 dl:1 p:1 :1 k:6 :1 o:1 :1 k:2 :1 nx:8 :1 k:4 :1 dl:1 s1:9 dl:1 p:1 :2 kd:5 :1 nx:12 :1 o:1 :1 p:1 nt:3 :1 na:9 p:1 s:5 :1 p:3 :1 nx:8 p:1 nx:6 p:1 nx:12 p:1 :1 nb:8 p:1 nx:14 p:1 dl:1 s1:7 dl:1 p:3 :2 kd:5 :1 nx:11 :1 kd:7 :1 nx:5 p:1 nx:9 o:1 p:1 nx:12 p:2 :1 kr:3 p:1 :1 nx:5 p:2 :1 kr:3 p:2 :1 k:4 o:1 :1 p:1 :5 k:6 :1 nx:11 p:1 :1 p:1 :2 kd:3 :1 nx:9 p:1 :1 nx:5 p:1 nx:12 o:1 nx:11 o:1 p:1 :1 nx:9 :1 o:1 :1 p:1 nc:11 :1 na:12 p:1 si:1 kc:4 si:1 :1 p:3 :1 nx:8 p:1 nx:6 p:1 nx:9 p:1 :1 nb:8 p:1 nx:14 p:1 dl:1 s1:7 dl:1 p:3 :2 nx:9 :1 o:1 :1 p:1 nc:11 :1 na:12 p:1 si:1 p:1 na:1 p:1 kc:4 p:2 nx:1 si:1 :1 p:3 :1 nx:9 :1 o:1 :1 p:1 nc:11 :1 na:12 p:1 si:1 kd:8 p:2 :1 p:1 :3 kd:3 :1 nx:1 :1 o:1 :1 p:1 :1 na:1 p:1 :1 kc:4 :1 p:2 :3 k:6 :1 nx:1 p:1 nx:1 p:1 :1 p:1 si:1 :1 p:2 :2 kd:5 :1 nx:5 :1 o:1 :1 p:1 na:10 p:1 :1 mi:1 p:2 :2 nx:5 p:1 nx:10 o:1 nx:11 p:1 nx:11 :1 c1:31 :1 nx:9 :1 o:1 :1 p:1 :3 p:1 nc:11 :1 na:5 p:1 si:1 nx:5 p:1 nx:10 o:1 mi:1 si:1 p:1 :21 p:2 nc:11 p:1 :1 p:2 :2 kd:5 :1 nx:9 :1 kd:7 :1 nx:5 p:1 nx:9 o:1 k:4 p:1 :1 k:4 o:1 :1 p:2 :1 kd:5 :1 nx:3 :1 kd:7 :1 nx:5 p:1 nx:9 o:1 k:4 p:1 :1 k:4 o:1 :1 p:2 :1 kd:5 :1 nx:5 :1 kd:7 :1 nx:5 p:1 nx:9 o:1 k:4 p:1 :1 k:4 o:1 :1 p:2 :1 kd:5 :1 nx:6 :1 kd:7 :1 nx:5 p:1 nx:9 o:1 p:1 na:4 p:1 :1 kr:6 p:2 :1 k:4 o:1 :1 p:2 :1 kd:3 :1 nx:7 :1 o:1 :1 p:1 nc:9 p:1 si:1 nb:6 p:1 nx:10 :1 p:1 :1 p:1 nc:3 :1 p:2 :1 p:1 :1 p:1 nc:5 :1 p:2 si:1 p:2 nc:9 p:2 :2 c1:57 :1 p:1 nt:5 :1 na:4 p:1 s:8 :1 na:8 :1 p:3 :1 p:1 nt:5 :1 na:4 p:1 s:8 :1 na:8 p:1 si:1 kc:4 si:1 :1 p:3 :2 c1:65 :1 p:1 nt:5 :1 na:4 p:1 s:8 :1 p:3 :1 p:1 nt:5 :1 na:4 p:1 s:8 :1 na:8 p:1 si:1 kc:5 si:1 :1 p:3 :2 kd:3 :1 nx:7 :1 o:1 :1 p:1 :3 p:1 nc:3 p:1 :5 si:1 cm:34 si:1 :68 p:1 nc:6 :7 cm:42 :7 na:4 p:1 si:1 nb:6 p:1 nx:10 :1 p:1 :1 nb:6 p:1 nx:4 :1 p:1 :1 dl:2 si:1 :1 c1:22 :5 p:2 :3 p:2 nc:3 p:1 :1 p:2 :2 kd:5 :1 nx:1 :1 kd:7 :1 nx:5 p:1 nx:9 o:1 p:1 na:1 p:1 :1 k:4 p:2 :1 k:4 o:1 :1 p:2 :1 kd:5 :1 nx:1 :1 kd