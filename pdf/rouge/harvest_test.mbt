  check_lex(
    "ruby", "# Matches a hex color value like #FF0000\nif /^#[a-fA-F0-9]{6}$/.match? color\n  puts 'hex color'\nend",
    "c1:40 :1 k:2 :1 sr:19 p:1 nf:6 :1 n:5 :3 nb:4 :1 s1:11 :1 k:3",
  )
}

