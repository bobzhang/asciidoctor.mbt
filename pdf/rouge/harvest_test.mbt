c1:32 :1 k:6 :1 nb:4 p:1 nx:5 p:2 nx:3 :1 o:1 :1 nx:3 p:1 :1 o:1 :1 mi:3 p:1 o:1 mi:3 p:1 :2 c1:12 :1 kd:8 o:1 :1 nx:5 p:1 k:4 p:1 :1 nx:2 p:1 :1 p:1 :3 nx:2 o:2 p:1 :3 k:5 :1 p:1 k:4 :1 o:1 :1 nx:2 p:1 :1 p:1 :5 k:5 :1 k:4 o:2 p:1 :3 p:1 :1 p:1 :2 cm:25 :2 kr:7 :1 k:9 :1 nx:3 :1 p:1 :5 kr:9 :1 nx:9 :1 p:1 :9 nx:8 p:3 :1 kr:6 p:1 :6 p:1 :1 p:1 :2 kr:7 :1 kd:3 :1 nx:3 p:1 :1 nx:3 p:1 :1 k:6 :1 o:1 :1 nx:3 p:1 :1 k:6 :1 p:1 :1 nx:3 :1 k:2 :1 k:7 :1 p:1 :2 kr:7 :1 kr:6 :1 dl:1 s2:3 dl:1 :1 p:1 :5 k:6 :1 kr:9 :1 nx:4 :1 p:1 :9 nl:9 p:1 :1 kr:3 p:1 :9 nl:5 p:1 :1 kr:6 p:1 :9 nl:7 p:2 :1 kr:6 p:1 :5 p:1 :1 p:1 :2 k:6 :1 k:7 :1 kd:8 :1 kd:5 :1 nx:8 :1 kd:7 :1 nx:3 o:1 nx:1 o:1 :1 p:1 :5 kd:11 p:2 :1 p:1 :9 k:5 p:3 :5 p:1 :6 k:8 :1 na:3 p:1 :1 kr:6 :1 o:1 :1 mi:2 p:1 :1 p:1 :2 k:5 :1 kd:8 :1 nx:8 p:2 :1 p:1 :5 kd:3 :1 nx:6 :1 o:1 :1 k:5 :1 nx:8 p:3 :1 p:1 :2 k:6 :1 p:1 :1 nx:9 :1 p:1 :1 k:4 :1 dl:1 s1:13 dl:1 p:1 :2 p:1 nd:9 p:2 :3 na:8 p:1 :1 dl:1 s1:6 dl:1 p:1 :3 na:8 p:1 :1 dl:1 s1:29 dl:1 :1 p:2 :1 k:6 :1 kd:5 :1 nx:12 :1 p:1 :1 p:1 :2 c1:15 :1 kr:7 :1 kr:6 :1 dl:1 s2:3 dl:1 :1 p:1 :3 k:6 :1 kd:4 :1 nx:11 :1 o:1 :1 nb:7 o:1 nx:4 o:1 :3 k:6 :1 kr:9 :1 nx:12 :1 p:1 :5 p:1 nx:1 :1 k:2 :1 kr:5 :1 nx:4 p:3 :1 nx:4 p:1 nx:1 p:1 :3 p:1 :1 p:1 :2 c1:19 :1 kd:5 :1 nx:1 :1 o:1 :1 s2:13 p:2 nx:1 p:1 nx:1 p:1 s2:1 p:1 :1 kd:5 :1 nx:1 :1 o:1 :1 s2:13 p:2 nx:1 p:2 nx:1 p:1 s2:1 p:1 :1 kd:5 :1 nx:1 :1 o:1 :1 s2:13 p:1 :2 c1:41 :1 kd:5 :1 nx:7 :1 o:1 :1 s2:10 p:2 nx:5 :1 o:2 :1 dl:1 s1:7 dl:1 p:1 s2:1 p:1 :1 kd:5 :1 nx:11 :1 o:1 :1 dl:1 s2:30 dl:1 p:1 :1",
