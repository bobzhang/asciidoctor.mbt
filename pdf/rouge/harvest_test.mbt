///|
test "rouge: console?prompt=%24&prompt=%3E: repeated options" {
  check_lex(
    "console?prompt=%24&prompt=%3E", "$ ls\n> echo hi\n% not a prompt\nout\n", "gp:1 w:1 nb:2 :1 gp:1 w:1 nb:5 :3 go:19",
  )
}

///|
test "rouge: console?prompt=%25,%3E&prompt=%24&lang=shell: repeated options" {
  check_lex(
    "console?prompt=%25,%3E&prompt=%24&lang=shell", "$ ls\n% echo hi\n> x\nout\n",
    "gp:1 w:1 nb:2 :1 gp:1 w:1 nb:5 :3 gp:1 w:1 :2 go:4",
  )
}

///|
test "rouge: php?start_inline=0&start_inline=1: repeated options" {
  check_lex(
    "php?start_inline=0&start_inline=1", "echo \"hi\"; ?>\n<b>x</b>\n", "k:4 :1 s2:4 p:1 :1 cp:2 :1 nt:3 :1 nt:4 :1",
  )
}

///|
test "rouge: erb?parent=json: targeted" {
  check_lex(
    "erb?parent=json", "{\"a\": <%= @x %>, \"b\": [1, 2]}\n", "p:1 nl:3 p:1 w:1 cp:3 :1 vi:2 :1 cp:2 p:1 w:1 nl:3 p:1 w:1 p:1 mi:1 p:1 w:1 mi:1 p:2 w:1",
  )
}

///|
test "rouge: erb?parent=xml: targeted" {
  check_lex(
    "erb?parent=xml", "<a href=\"<%= url %>\">\n  <% if x %>y<% end %>\n</a>\n",
    "nt:2 :1 na:5 s:1 cp:3 :1 n:3 :1 cp:2 err:1 nt:1 :3 cp:2 :1 k:2 :1 n:1 :1 cp:2 :1 cp:2 :1 k:3 :1 cp:2 :1 nt:4 :1",
  )
}

///|
test "rouge: vue: targeted" {
  check_lex(
    "vue", "<template>\n  <p :id=\"x\">{{ msg }}</p>\n</template>\n<script>\nexport default { data() { return { msg: 'hi' } } }\n</script>\n<style scoped>\np { color: red; }\n</style>\n",
    "nt:1 k:8 nt:1 :3 nt:2 :1 na:4 s:3 nt:1 si:2 :1 nx:3 :1 si:2 nt:4 :1 nt:2 k:8 nt:1 :1 nt:1 k:6 nt:1 :1 k:6 :1 k:7 :1 p:1 :1 nx:4 p:2 :1 p:1 :1 k:6 :1 p:1 :1 na:3 p:1 :1 dl:1 s1:2 dl:1 :1 p:1 :1 p:1 :1 p:1 :1 nt:2 k:6 nt:1 :1 nt:1 k:5 :1 na:6 nt:1 :1 nt:1 :1 p:1 :1 nl:5 p:1 :1 no:3 p:1 :1 p:1 :1 nt:2 k:5 nt:1 :1",
  )
}

///|
test "rouge: console?comments=true: targeted" {
  check_lex(
    "console?comments=true", "# a comment\n$ ls -l\ntotal 0\n", "c:12 gp:1 w:1 nb:2 :1 nt:2 :1 go:8",
  )
}

///|
test "rouge: console?error=error:,fatal:&output=yaml: targeted" {
  check_lex(
    "console?error=error:,fatal:&output=yaml", "$ make\nerror: no rule\nkey: value\nfatal: stop\n",
    "gp:1 w:1 :5 gr:15 na:3 pi:1 :1 s:5 :1 gr:12",
  )
}

///|
test "rouge: console?lang=ruby&prompt=%3E%3E: targeted" {
  check_lex(
    "console?lang=ruby&prompt=%3E%3E", ">> puts 1 + 2\n3\n", "gp:2 w:1 nb:4 :1 mi:1 :1 o:1 :1 mi:1 :1 go:2",
  )
}

///|
test "rouge: yaml: targeted" {
  check_lex(
    "yaml", "a: &anchör x\nb: *anchör\nc: &é_1 [1, 2]\nd: *é_1\n", "na:1 pi:1 :1 nl:7 :1 s:1 :1 na:1 pi:1 :1 nv:7 :1 na:1 pi:1 :1 nl:4 :1 pi:1 nv:1 pi:1 :1 nv:1 pi:1 :1 na:1 pi:1 :1 nv:4 :1",
  )
}

///|
test "rouge: d: targeted" {
  check_lex(
    "d", "auto s = q\"[a[b]c]\";\nauto t = q{ int x = 1; };\n/+ outer /+ inner +/ still +/\nauto u = q\"EOS\nline\nEOS\";\n",
    "k:4 :1 n:1 :1 p:1 :1 s:10 p:1 :1 k:4 :1 n:1 :1 p:1 :1 s:2 :1 kt:3 :1 n:1 :1 p:1 :1 mi:1 p:1 :1 s:1 p:1 :1 cm:29 :1 k:4 :1 n:1 :1 p:1 :1 s:15 p:1 :1",
  )
}

///|
test "rouge: csharp: targeted" {
  check_lex(
    "csharp", "var s = $\"x {1} y {name,10:F2}\";\nvar v = $@\"c:\\{dir}\";\n", "kt:3 :1 n:1 :1 p:1 :1 s:4 p:1 m:1 p:1 s:3 p:1 n:4 p:1 m:2 p:1 n:2 p:1 s:1 p:1 :1 kt:3 :1 n:1 :1 p:1 :1 s:6 p:1 n:3 p:1 s:1 p:1 :1",
  )
}

///|
test "rouge: rust: targeted" {
  check_lex(
    "rust", "/** /* nested */ */\nfn main() { let r = r#\"raw \"str\"\"#; }\n", "cd:19 :1 k:2 :1 nf:4 p:2 :1 p:1 :1 k:3 :1 n:1 :1 o:1 :1 s:14 p:1 :1 p:1 :1",
  )
}

///|
test "rouge: markdown: targeted" {
  check_lex(
    "markdown", "```\n<?php echo 1; ?>\n```\n```\n#!/usr/bin/env python\nprint(1)\n```\n```\n# vim: ft=ruby\nputs 1\n```\n```\nplain words\n```\n",
    "p:3 nl:1 cp:5 :1 k:4 :1 mi:1 p:1 :1 cp:2 :1 p:3 :1 p:3 nl:1 c1:22 k:5 p:1 mi:1 p:1 :1 p:3 :1 p:3 nl:1 c1:14 :1 nb:4 :1 mi:1 :1 p:3 :1 p:3 nl:1 :12 p:3 :1",
  )
}

///|
test "rouge: markdown?disabledmodules=String&disabledmodules=Math: targeted" {
  check_lex(
    "markdown?disabledmodules=String&disabledmodules=Math", "```php?disabledmodules=Date%2FTime\nstrlen('x'); abs(1); date('Y');\n```\n",
    "p:3 nl:32 nb:6 p:1 s1:3 p:2 :1 nb:3 p:1 mi:1 p:2 :1 nf:4 p:1 s1:3 p:2 :1 p:3 :1",
  )
}

