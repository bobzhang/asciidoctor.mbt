  check_lex(
    "json", "{ \"one\": 1, \"two\": 2, \"null\": null, \"simple\": true }\n", "p:1 w:1 nl:5 p:1 w:1 mi:1 p:1 w:1 nl:5 p:1 w:1 mi:1 p:1 w:1 nl:6 p:1 w:1 kc:4 p:1 w:1 nl:8 p:1 w:1 kc:4 w:1 p:1 w:1",
  )
}

