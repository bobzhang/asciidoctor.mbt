    "k:4 w:1 s:11 w:1 k:2 w:1 s:7 :1 k:10 s:13 :2 k:4 nb:4 :1 se:2 :6 nv:4 :1 c:9 :1 k:7 w:1 k:3 s:11 :1 k:12 nb:4 :1 se:2 :6 nv:4 :1 k:3 s:10 :1",
