    "kd:6 :1 kd:9 :1 nc:6 :1 o:1 :3 nc:6 :1 nf:7 o:3 :1 c1:9 :3 nc:6 :1 nf:6 o:3 :3 kt:3 :1 nf:6 o:3 :1 c1:12 :1 o:1",
  )
}

