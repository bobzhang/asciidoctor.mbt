import {
  "bobzhang/asciidoctor-pdf/theme",
  "bobzhang/asciidoctor-pdf/fonts" @bundled,
  "bobzhang/asciidoctor/core",
  "bobzhang/asciidoctor/regex",
  "bobzhang/asciidoctor-pdf/rouge",
  "moonbitlang/pagelayout",
  "bobzhang/prawn",
  "bobzhang/prawn/svg",
  "bobzhang/prawn/table",
  "moonbitlang/pagelayout/pdf",
  "moonbitlang/pdflite",
  "moonbitlang/core/string",
  "moonbitlang/core/cmp",
  "moonbitlang/core/math",
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "native+wasm"

import {
  "bobzhang/asciidoctor",
  "moonbitlang/pagelayout/fontoutlines",
  "moonbitlang/pdflite",
  "bobzhang/asciidoctor-pdf/fonts/icons",
  "moonbitlang/pdflite/core" @pdfcore,
} for "wbtest"

import {
  "bobzhang/asciidoctor-pdf" @asciidoctor_pdf,
  "bobzhang/asciidoctor",
  "bobzhang/asciidoctor/core",
  "bobzhang/asciidoctor-pdf/fonts" @bundled,
  "bobzhang/asciidoctor-pdf/fonts/sans",
} for "test"
