///|
test "ruby: should load extended themes relative to theme file if they start with ./ #1" {
  check_case(
    "load_theme",
    [Some("/tmp-themes/tmp-0-28-theme.yml"), Some("/fixtures")],
    [
      (
        "/tmp-themes/tmp-0-28-theme.yml", "extends:\n- ./tmp-0-26-theme.yml\n- ./tmp-0-27-theme.yml\nbase:\n  text-align: justify\n",
      ),
      ("/tmp-themes/tmp-0-26-theme.yml", "base:\n  font-family: Times-Roman\n"),
      ("/tmp-themes/tmp-0-27-theme.yml", "base:\n  font-color: ff0000\n"),
    ],
    Some(
      "base_font_size: 12\nbase_font_family: \"Times-Roman\"\nbase_font_color: hex\"FF0000\"\nbase_text_align: \"justify\"\nbase_line_height: 1\ncode_font_family: \"Courier\"\nconum_font_family: \"Courier\"\n__dir__: \"/fixtures\"",
    ),
    [],
  )
}

