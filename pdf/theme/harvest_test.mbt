    [
      Some(
        "# ThemeLoader#evaluate_math and the measurement units\nbase:\n  font_size: 10.5\n  line_height_length: 12\n  line_height: $base_line_height_length / 10.5\n  font_size_large: round($base_font_size * 1.25)\n  font_size_small: round($base-font-size * 0.85)\n  font_size_min: $base_font_size * 0.75\nmath:\n  add: 1 + 2\n  sub: 10 - 2.5\n  mul: 3 * 4\n  div: 1 / 3\n  pow: 2 ^ 10\n  precedence: 2 + 3 * 4\n  left_to_right: 12 / 2 * 3\n  chain: 1 + 2 + 3 - 4\n  neg: -$base_font_size\n  neg_expr: -$base_font_size / 2\n  neg_operand: 10 - -2\n  unspaced: 1+2\n  one_space_missing: 1 +2\n  many_spaces: 1   +   2\n  floor: floor($base_font_size * 2.6)\n  ceil: ceil($base_font_size)\n  round_half: round(2.5)\n  round_neg: round(-2.5)\n  round_inner: round(1 + 1.5)\n  not_outer: 1 + round(2.5)\n  whole_float: 1.5 * 2\n  float_result: 0.1 + 0.2\n  big: 100000000 * 100000000\n  tiny: 1 / 100000\n  divzero: 1 / 0\n  text_with_numbers: 3 apples + 2 pears\n  trailing: 2 * 3 px\n  interp: $base_font_size * 2 of $base_line_height_length\n  array: [$base_font_size / 2, 0.5in, $base_line_height_length * 2]\n  nested_parens: (1 + 2) * 3\n  percent: 50%\n  vw: 100vw\n  em: 1.2em\n  rem: 0.8rem\nunits:\n  in: 0.5in\n  mm: 10mm\n  cm: 2.54cm\n  px: 100px\n  pc: 2pc\n  pt: 12pt\n  neg_in: -1in\n  in_expr: 0.5in + 12\n  in_paren: round(0.5in)\n  inset: 1in 2in\n  glued: 1in2in\n  margin: [0.5in, 0.67in, 0.67in, 0.67in]\n  bad_unit: 5xx\nvars:\n  lone: $base_font_size\n  lone_dash: $base-line-height-length\n  unknown: $no_such_key\n  unknown_interp: a $no_such_key b\n  interp_float: size $base_font_size\n  interp_array: $units_margin and more\n  content: $math_add\n  color_var: $link_font_color\nlink:\n  font_color: 428BCA\ntext:\n  from_color: $link_font_color\n  prefix_content: before $base_font_size after\n",
      ),
    ],
    [],
    Some(
      "base_font_size: f10.5\nbase_line_height_length: 12\nbase_line_height: f1.1428571428571428\nbase_font_size_large: 13\nbase_font_size_small: 9\nbase_font_size_min: f7.875\nmath_add: 3\nmath_sub: f7.5\nmath_mul: 12\nmath_div: f0.3333333333333333\nmath_pow: 1024\nmath_precedence: 14\nmath_left_to_right: 18\nmath_chain: 2\nmath_neg: f-10.5\nmath_neg_expr: f-5.25\nmath_neg_operand: 12\nmath_unspaced: \"1+2\"\nmath_one_space_missing: \"1 +2\"\nmath_many_spaces: 3\nmath_floor: 27\nmath_ceil: 11\nmath_round_half: 3\nmath_round_neg: -3\nmath_round_inner: 3\nmath_not_outer: \"1 + round(2.5)\"\nmath_whole_float: 3\nmath_float_result: f0.30000000000000004\nmath_big: f1.0e+16\nmath_tiny: f1.0e-05\nmath_divzero: 0\nmath_text_with_numbers: \"3 apples + 2 pears\"\nmath_trailing: 6\nmath_interp: 21\nmath_array: [f5.25, 36, 24]\nmath_nested_parens: 0\nmath_percent: \"50%\"\nmath_vw: \"100vw\"\nmath_em: \"1.2em\"\nmath_rem: \"0.8rem\"\nunits_in: 36\nunits_mm: f28.34645669291339\nunits_cm: f72.00000000000001\nunits_px: 75\nunits_pc: 24\nunits_pt: 12\nunits_neg_in: -72\nunits_in_expr: 48\nunits_in_paren: 36\nunits_inset: 72\nunits_glued: \"1in2in\"\nunits_margin: [36, f48.24, f48.24, f48.24]\nunits_bad_unit: \"5xx\"\nvars_lone: f10.5\nvars_lone_dash: 12\nvars_unknown: \"$no_such_key\"\nvars_unknown_interp: \"a $no_such_key b\"\nvars_interp_float: \"size 10.5\"\nvars_interp_array: \"[36, 48.24, 48.24, 48.24] and more\"\nvars_content: \"3\"\nvars_color_var: \"$link_font_color\"\nlink_font_color: hex\"428BCA\"\ntext_from_color: hex\"428BCA\"\ntext_prefix_content: \"before 10.5 after\"",
