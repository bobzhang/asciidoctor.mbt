///|
test "ruby: should not fail if theme data is empty #1" {
  check_case("load", [Some("")], [], Some(""), [])
}

///|
test "ruby: should not fail if theme data is falsy #1" {
  check_case("load", [Some("false")], [], Some(""), [])
}

///|
test "ruby: should store flattened keys in Asciidoctor::PDF::ThemeData #1" {
  check_case(
    "load",
    [
      Some(
        "page:\n  size: A4\nbase:\n  font:\n    family: Times-Roman\n  border_width: 0.5\nadmonition:\n  label:\n    font_style: bold\n",
      ),
    ],
    [],
    Some(
      "page_size: \"A4\"\nbase_font_family: \"Times-Roman\"\nbase_border_width: f0.5\nadmonition_label_font_style: \"bold\"",
    ),
    [],
  )
}

///|
test "ruby: should not flatten admonition icon keys #1" {
  check_case(
    "load",
    [
      Some(
        "admonition:\n  icon:\n    tip:\n      name: far-lightbulb\n      stroke_color: ffff00\n      size: 24\n    note:\n      name: far-sticky-note\n      stroke_color: 0000ff\n      size: 24\n",
      ),
    ],
    [],
    Some(
      "admonition_icon_tip: {:name => \"far-lightbulb\", :stroke_color => hex\"FFFF00\", :size => 24}\nadmonition_icon_note: {:name => \"far-sticky-note\", :stroke_color => hex\"0000FF\", :size => 24}",
    ),
    [],
  )
}

