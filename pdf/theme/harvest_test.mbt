test "ruby: extra add-running-content-3-theme.yml (text)" {
  check_case(
    "load",
    [
      Some(
        "extends: default\nfooter:\n  columns: =100%\n  recto:\n    center:\n      content: '{page-number}'\n  verso:\n    center:\n      content: '{page-number}'\n",
      ),
    ],
    [],
    Some(
      "extends: \"default\"\nfooter_columns: \"=100%\"\nfooter_recto_center_content: \"{page-number}\"\nfooter_verso_center_content: \"{page-number}\"",
    ),
    [],
  )
}

