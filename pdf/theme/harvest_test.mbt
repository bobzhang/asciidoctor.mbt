///|
test "ruby: should look for file ending in -theme.yml when resolving custom theme #1" {
  check_case(
    "load_theme",
    [Some("custom"), Some("/fixtures")],
    [("/fixtures/custom-theme.yml", "base:\n  font-family: Times-Roman\n")],
    Some(
      "base_font_size: 12\nbase_font_family: \"Times-Roman\"\nbase_text_align: \"left\"\nbase_line_height: 1\nbase_font_color: \"000000\"\ncode_font_family: \"Courier\"\nconum_font_family: \"Courier\"\n__dir__: \"/fixtures\"",
    ),
    [],
  )
}

