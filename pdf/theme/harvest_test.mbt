test "ruby: should replace hyphens in key names with underscores #1" {
  check_case(
    "load",
    [
      Some(
        "page-size: A4\nbase:\n  font-family: Times-Roman\nabstract:\n  title-font-size: 20\nadmonition:\n  icon:\n    tip:\n      stroke-color: FFFF00\n",
      ),
    ],
    [],
    Some(
      "page_size: \"A4\"\nbase_font_family: \"Times-Roman\"\nabstract_title_font_size: 20\nadmonition_icon_tip: {:stroke_color => hex\"FFFF00\"}",
