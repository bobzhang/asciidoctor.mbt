///|
test "ruby: should load and extend themes specified by extends array #1" {
  check_case(
    "load_file",
    [Some("/tmp-themes/tmp-0-3-theme.yml"), Some("/tmp-themes")],
    [
      (
        "/tmp-themes/tmp-0-3-theme.yml", "extends:\n- tmp-0-1-theme.yml\n- ./tmp-0-2-theme.yml\nbase:\n  text-align: justify\n",
      ),
      ("/tmp-themes/tmp-0-1-theme.yml", "base:\n  font-family: Times-Roman\n"),
      ("/tmp-themes/tmp-0-2-theme.yml", "base:\n  font-color: ff0000\n"),
    ],
    Some(
      "base_font_family: \"Times-Roman\"\nbase_font_color: hex\"FF0000\"\nbase_text_align: \"justify\"",
    ),
    [],
  )
}

///|
test "ruby: should be able to extend them from absolute path #1" {
  check_case(
    "load_file",
    [Some("/tmp-themes/tmp-0-4-theme.yml"), None],
    [
      (
        "/tmp-themes/tmp-0-4-theme.yml", "extends:\n- /fixtures/custom-theme.yml\nbase:\n  text-align: justify\n",
      ),
      ("/fixtures/custom-theme.yml", "base:\n  font-family: Times-Roman\n"),
    ],
    Some("base_font_family: \"Times-Roman\"\nbase_text_align: \"justify\""),
    [],
  )
}

