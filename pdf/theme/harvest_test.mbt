///|
test "ruby: should wrap cmyk color values in color type if key ends with _color #1" {
  check_case(
    "load",
    [
      Some(
        "page:\n  background_color: [0, 0, 0, 0]\nbase:\n  font_color: [100, 100, 100, 100]\nheading:\n  font-color: [0, 0, 0, 0.92]\nlink:\n  font-color: [67.33%, 31.19%, 0, 20.78%]\ncodespan:\n  font-color: [0%, 0%, 0%, 0.87]\ntable:\n  grid-color: [0, 0, 0, 27]\n",
      ),
    ],
    [],
    Some(
      "page_background_color: hex\"FFFFFF\"\nbase_font_color: hex\"000000\"\nheading_font_color: cmyk[0, 0, 0, 92]\nlink_font_color: cmyk[f67.33, f31.19, 0, f20.78]\ncodespan_font_color: cmyk[0, 0, 0, 87]\ntable_grid_color: cmyk[0, 0, 0, 27]",
    ),
    [],
  )
}

///|
test "ruby: should wrap hex color values in color type if key ends with _color #1" {
  check_case(
    "load",
    [
      Some(
        "page:\n  background_color: 'ffffff'\nbase:\n  font_color: '000000'\nheading:\n  font-color: 333333\nlink:\n  font-color: 428bca\ncodespan:\n  font-color: 222\n",
      ),
    ],
    [],
    Some(
      "page_background_color: hex\"FFFFFF\"\nbase_font_color: hex\"000000\"\nheading_font_color: hex\"333333\"\nlink_font_color: hex\"428BCA\"\ncodespan_font_color: hex\"222222\"",
    ),
    [],
  )
}

///|
test "ruby: should coerce rgb color values to hex and wrap in color type if key ends with _color #1" {
  check_case(
    "load",
    [
      Some(
        "page:\n  background_color: [255, 255, 255]\nbase:\n  font_color: [0, 0, 0]\nheading:\n  font-color: [51, 51, 51]\nlink:\n  font-color: [66, 139, 202]\ncodespan:\n  font-color: ['34', '34', '34']\ntable:\n  grid-color: [187, 187, 187]\n",
      ),
    ],
    [],
    Some(
      "page_background_color: hex\"FFFFFF\"\nbase_font_color: hex\"000000\"\nheading_font_color: hex\"333333\"\nlink_font_color: hex\"428BCA\"\ncodespan_font_color: hex\"222222\"\ntable_grid_color: hex\"BBBBBB\"",
    ),
    [],
  )
}

///|
test "ruby: should coerce rgb color values for each axis of table grid #1" {
  check_case(
    "load",
    [Some("table:\n  grid-color: [[255, 0, 0], [0, 255, 0]]\n")],
    [],
    Some("table_grid_color: [hex\"FF0000\", hex\"00FF00\"]"),
    [],
  )
}

///|
test "ruby: should coerce cmyk color values for each axis of table grid #1" {
  check_case(
    "load",
    [Some("table:\n  grid-color: [[0, 1, 1, 0], [1, 0, 1, 0]]\n")],
    [],
    Some("table_grid_color: [cmyk[0, 100, 100, 0], cmyk[100, 0, 100, 0]]"),
    [],
  )
}

///|
test "ruby: should flatten array color value of unsupported length to string if key ends with _color #1" {
  check_case(
    "load",
    [
      Some(
        "page:\n  background_color: ['fff', 'fff']\nbase:\n  font_color: [0, 0, 0, 0, 0, 0]\n",
      ),
    ],
    [],
    Some("page_background_color: hex\"FFFFFF\"\nbase_font_color: hex\"000000\""),
    [],
  )
}

///|
test "ruby: should not wrap value in color type if key does not end with _color #1" {
  check_case(
    "load",
    [Some("menu:\n  caret:\n    content: 4a4a4a\n")],
    [],
    Some("menu_caret_content: \"4a4a4a\""),
    [],
  )
}

///|
test "ruby: should allow hex color values to be prefixed with # for any key #1" {
  check_case(
    "load_theme",
    [Some("hex-color-shorthand"), Some("/fixtures")],
    [
      (
        "/fixtures/hex-color-shorthand-theme.yml", "# this is a line comment\nbrand:\n  primary: #428bca\nbase: # this is a trailing line comment\n  font_color: #222\n  border_color: #DDDDDD\npage:\n  background:\n    color: '#fefefe'\nlink:\n  font_color: $brand_primary\ncodespan:\n  font_color: \"#a00\"\nfooter:\n  background_color: null\n  font-color: 009\n",
      ),
    ],
    Some(
      "base_font_size: 12\nbrand_primary: \"428bca\"\nbase_font_color: hex\"222222\"\nbase_border_color: hex\"DDDDDD\"\npage_background_color: hex\"FEFEFE\"\nlink_font_color: hex\"428BCA\"\ncodespan_font_color: hex\"AA0000\"\nfooter_background_color: nil\nfooter_font_color: hex\"000099\"\nbase_text_align: \"left\"\nbase_line_height: 1\ncode_font_family: \"Courier\"\nconum_font_family: \"Courier\"\n__dir__: \"/fixtures\"",
    ),
    [],
  )
}

///|
test "ruby: should not coerce color-like values to string if key does not end with color #1" {
  check_case(
    "load_theme",
    [Some("color-like-value"), Some("/fixtures")],
    [("/fixtures/color-like-value-theme.yml", "footer:\n  height: 100\n")],
    Some(
      "base_font_size: 12\nfooter_height: 100\nbase_text_align: \"left\"\nbase_line_height: 1\nbase_font_color: \"000000\"\ncode_font_family: \"Courier\"\nconum_font_family: \"Courier\"\n__dir__: \"/fixtures\"",
    ),
    [],
  )
}

///|
test "ruby: should coerce content key to a string #1" {
  check_case(
    "load",
    [
      Some(
        "vars:\n  foo: bar\nfooter:\n  recto:\n    left:\n      content: $vars_foo\n    right:\n      content: 10\n",
      ),
    ],
    [],
