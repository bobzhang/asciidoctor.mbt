///|
test "ruby: should not inherit from base theme when loading custom theme #1" {
  check_case(
    "load_theme",
    [Some("/fixtures/empty-theme.yml"), None],
    [("/fixtures/empty-theme.yml", "")],
    Some(
      "base_font_size: 12\nbase_text_align: \"left\"\nbase_line_height: 1\nbase_font_color: \"000000\"\ncode_font_family: \"Courier\"\nconum_font_family: \"Courier\"\n__dir__: \"/fixtures\"",
    ),
    [],
  )
}

///|
test "ruby: should not inherit from base theme if custom theme extends nothing #1" {
  check_case(
    "load_theme",
    [Some("/fixtures/bare-theme.yml"), None],
    [("/fixtures/bare-theme.yml", "extends: ~\n")],
    Some(
      "base_font_size: 12\nbase_text_align: \"left\"\nbase_line_height: 1\nbase_font_color: \"000000\"\ncode_font_family: \"Courier\"\nconum_font_family: \"Courier\"\n__dir__: \"/fixtures\"",
    ),
    [],
  )
}

