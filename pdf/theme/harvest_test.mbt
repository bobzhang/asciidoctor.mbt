///|
test "ruby: extra syntax-theme.yml #1" {
  check_case(
    "load_theme",
    [Some("syntax-theme.yml"), Some("/extra")],
    [
      (
        "/extra/syntax-theme.yml", "%YAML 1.1\n---\n# YAML syntax a theme may use\nquoting:\n  dq_escapes: \"tab\\there\\nnew \\\"q\\\" \\\\ \\x41 é \\U0001F600 \\_ \\N \\e\"\n  dq_fold: \"one\n    two\n\n    three\"\n  dq_escaped_break: \"one \\\n    two\"\n  sq_fold: 'one\n    two'\n  sq_quote: 'a''b'\n  empty_dq: \"\"\n  empty_sq: ''\n  hash_not_comment: a#b # but this is\n  colon_space_quoted: \"a: b\"\n  braces: \"{page-number}\"\n  unquoted_braces_later: page {page-number}\nblock:\n  literal_strip: |-\n    keep\n    no final newline\n  literal_keep: |+\n    keep\n\n  literal_indent: |2\n      two extra spaces\n    base\n  folded_lines: >\n    one\n    two\n\n    para\n      more indented\n    back\n  folded_strip: >-\n    x\n    y\n  after: 1\nflow:\n  nested: {a: [1, {b: c}], 'q k': \"v\", d: }\n  empty_seq: []\n  empty_map: {}\n  trailing_comma: [1, 2, ]\n  multiline: [\n    one,\n    two\n  ]\n  seq_of_maps:\n  - name: a\n    size: 1\n  - {name: b, size: 2}\n  - - nested\n    - seq\n\"quoted key\": 1\n'single key': 2\nkey with spaces: 3\n? explicit\n: value\ntagged:\n  str: !!str 123\n  float: !!float 3\n  str_bool: !!str yes\nanchored:\n  scalar: &s shared value\n  ref: *s\n  seq: &q\n  - x\n  - y\n  ref_seq: *q\ncomments: # a comment\n  # a comment line\n  a: 1 # trailing\n  b: 'x' # trailing\n...\n",
      ),
    ],
    Some(
      "base_font_size: 12\nquoting_dq_escapes: \"tab\\u0009here\\u000anew \\\"q\\\" \\\\ A é 😀    \\u001b\"\nquoting_dq_fold: \"one two\\u000athree\"\nquoting_dq_escaped_break: \"one two\"\nquoting_sq_fold: \"one two\"\nquoting_sq_quote: \"a'b\"\nquoting_empty_dq: \"\"\nquoting_empty_sq: \"\"\nquoting_hash_not_comment: \"a#b\"\nquoting_colon_space_quoted: \"a: b\"\nquoting_braces: \"{page-number}\"\nquoting_unquoted_braces_later: \"page {page-number}\"\nblock_literal_strip: \"keep\\u000ano final newline\"\nblock_literal_keep: \"keep\\u000a\\u000a\"\nblock_literal_indent: \"  two extra spaces\\u000abase\\u000a\"\nblock_folded_lines: \"one two\\u000apara\\u000a  more indented\\u000aback\\u000a\"\nblock_folded_strip: \"x y\"\nblock_after: 1\nflow_nested_a: [1, {\"b\" => \"c\"}]\nflow_nested_q k: \"v\"\nflow_nested_d: nil\nflow_empty_seq: []\nflow_trailing_comma: [1, 2]\nflow_multiline: [\"one\", \"two\"]\nflow_seq_of_maps: [{\"name\" => \"a\", \"size\" => 1}, {\"name\" => \"b\", \"size\" => 2}, [\"nested\", \"seq\"]]\nquoted key: 1\nsingle key: 2\nkey with spaces: 3\nexplicit: \"value\"\ntagged_str: \"123\"\ntagged_float: f3.0\ntagged_str_bool: \"yes\"\nanchored_scalar: \"shared value\"\nanchored_ref: \"shared value\"\nanchored_seq: [\"x\", \"y\"]\nanchored_ref_seq: [\"x\", \"y\"]\ncomments_a: 1\ncomments_b: \"x\"\nbase_text_align: \"left\"\nbase_line_height: 1\nbase_font_color: \"000000\"\ncode_font_family: \"Courier\"\nconum_font_family: \"Courier\"\n__dir__: \"/extra\"",
    ),
    [],
  )
}

///|
test "ruby: extra extends-theme.yml #1" {
  check_case(
    "load_theme",
    [Some("extends-theme.yml"), Some("/extra")],
    [
      (
        "/extra/extends-theme.yml", "# extends: bundled themes, relative paths, base, !important, duplicates\nextends:\n- default-sans\n- ./parent-theme.yml\n- parent-theme.yml\n- base\n- default !important\nbase:\n  font_color: $heading_font_color\n  font_size: $base_font_size + 1\nfooter:\n  recto:\n    left:\n      content: '{page-number} of {page-count}'\nfont:\n  catalog:\n    merge: true\n    Custom:\n      '*': GEM_FONTS_DIR/custom.ttf\n      bold: $parent_font_dir/custom-bold.ttf\n  fallbacks:\n  - Custom\n  - $parent_fallback\n",
      ),
      (
