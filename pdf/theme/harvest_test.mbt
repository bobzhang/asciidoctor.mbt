///|
test "ruby: should resolve null color value as nil #1" {
  check_case(
    "load",
    [Some("page:\n  background_color: null\n")],
    [],
    Some("page_background_color: nil"),
    [],
  )
}

///|
test "ruby: should resolve transparent color value #1" {
  check_case(
    "load",
    [Some("sidebar:\n  background_color: transparent\n")],
    [],
    Some("sidebar_background_color: transparent"),
    [],
  )
}

///|
test "ruby: should expand color value to 6 hexadecimal digits #1" {
  check_case(
    "load",
    [Some("page:\n  background_color: 0\n")],
    [],
    Some("page_background_color: hex\"000000\""),
    [],
  )
}

