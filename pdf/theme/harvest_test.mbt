    [
      (
        "/extra/colors-theme.yml", "# colors, and the hex color protection applied to a theme outside the\n# bundled themes before YAML reads it\ncolor:\n  hash_six: #FF0000\n  hash_three: #f00\n  hash_quoted: '#00ff00'\n  hash_dquoted: \"#0000ff\"\n  hash_comment: #abcdef # a comment\n  plain_six: 336699\n  plain_zeros: 000000\n  plain_digits: 123456\n  plain_three: 123\n  plain_mixed: 5C6266\n  quoted_three: 'abc'\n  four: 1234\n  two: ff\n  eight: 11223344\n  transparent_color: transparent\n  null_color: null\n  tilde_color: ~\n  rgb_color: [255, 128, 0]\n  rgb_float_color: [255.0, 1.5, 0]\n  cmyk_color: [0, 0.5, 1, 1]\n  cmyk_pct_color: ['50%', '0%', 100, 25]\n  cmyk_zero_color: [0, 0, 0, 0]\n  cmyk_full_color: [1, 1, 1, 1]\n  nonsense_color: [1, 2]\n  bool_color: true\n  float_color: 1.5\n  var_color: $color_plain_six\n  interp_color: 'ab$color_two'\nnot_color:\n  size: 123\n  quoted_size: '123'\n  hash_size: #123\n  word: abcdef\ntable:\n  border_color: [DDDDDD, 'EEEEEE', 333]\n  grid_color: [DDDDDD, 'CCCCCC']\n  grid_single_color: DDDDDD\nrole:\n  red:\n    font_color: #ff0000\n    align: center\n  blue:\n    font-color: 0000ff\n    text-align: right\n  my-role:\n    font-color: 123456\n    background_color: FFFFFF\nadmonition:\n  icon:\n    tip:\n      name: far-lightbulb\n      stroke-color: ffff00\n      size: 24 * 2\n    note:\n      name: $admonition_icon_tip\n    caution: ~\n",
      ),
