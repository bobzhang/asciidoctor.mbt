///|
test "ruby: extra extends-theme.yml (text)" {
  check_case(
    "load",
    [
      Some(
        "# extends: bundled themes, relative paths, base, !important, duplicates\nextends:\n- default-sans\n- ./parent-theme.yml\n- parent-theme.yml\n- base\n- default !important\nbase:\n  font_color: $heading_font_color\n  font_size: $base_font_size + 1\nfooter:\n  recto:\n    left:\n      content: '{page-number} of {page-count}'\nfont:\n  catalog:\n    merge: true\n    Custom:\n      '*': GEM_FONTS_DIR/custom.ttf\n      bold: $parent_font_dir/custom-bold.ttf\n  fallbacks:\n  - Custom\n  - $parent_fallback\n",
      ),
    ],
    [],
    Some(
      "extends: [\"default-sans\", \"./parent-theme.yml\", \"parent-theme.yml\", \"base\", \"default !important\"]\nbase_font_color: hex\"$HEADI\"\nbase_font_size: \"$base_font_size + 1\"\nfooter_recto_left_content: \"{page-number} of {page-count}\"\nfont_catalog: {\"Custom\" => {\"normal\" => \"/asciidoctor-pdf/data/fonts/custom.ttf\", \"bold\" => \"$parent_font_dir/custom-bold.ttf\", \"italic\" => \"/asciidoctor-pdf/data/fonts/custom.ttf\", \"bold_italic\" => \"/asciidoctor-pdf/data/fonts/custom.ttf\"}}\nfont_fallbacks: [\"Custom\", \"$parent_fallback\"]",
    ),
    [
      "WARN: unknown variable reference in PDF theme: $heading_font_color", "WARN: unknown variable reference in PDF theme: $base_font_size",
      "WARN: unknown variable reference in PDF theme: $parent_font_dir", "WARN: unknown variable reference in PDF theme: $parent_fallback",
    ],
  )
}

///|
test "ruby: extra scalars-theme.yml #1" {
  check_case(
    "load_theme",
    [Some("scalars-theme.yml"), Some("/extra")],
    [
      (
        "/extra/scalars-theme.yml", "# Psych's resolution of plain scalars (YAML 1.1 rules, as Ruby reads them)\nscalar:\n  bool_yes: yes\n  bool_no: No\n  bool_on: ON\n  bool_off: off\n  bool_true: True\n  bool_false: FALSE\n  word_y: y\n  word_n: n\n  null_tilde: ~\n  null_word: Null\n  null_empty:\n  int: 42\n  int_plus: +12\n  int_neg: -7\n  int_octal: 0777\n  int_zero_octal: 00\n  int_hex: 0x1F\n  int_bin: 0b101\n  int_underscore: 1_000\n  int_comma: 1,000\n  not_octal: 09\n  sexagesimal: 1:30\n  sexagesimal_neg: -1:30\n  sexagesimal3: 1:02:03\n  sexagesimal_float: 1:30.5\n  not_sexagesimal: 1.5:30\n  float: 10.5\n  float_dot: 1.\n  float_lead: .5\n  float_exp: 1.0e+5\n  float_exp_nodot: 1e5\n  float_exp_nosign: 1.0e5\n  float_dotexp: 1.e+5\n  float_under: 1_000.5\n  float_inf: .inf\n  float_neginf: -.Inf\n  dot: .\n  minus_dot: -.\n  hexish: 5C6266\n  hexish2: 1E1E1E\n  hexish3: 428BCA\n  digits6: 999999\n  zeros6: 000000\n  mixed_zero: 0000FF\n  word: hello world\n  short_word: abc\n  dollar: $foo\n  quoted_int: '12'\n  dquoted: \"a\\tbé\"\n  single: 'it''s'\n  literal: |\n    line one\n    line two\n  folded: >\n    folded\n    text\n  flow_seq: [1, two, 3.5, ~]\n  flow_map: {a: 1, b: [x, y]}\n  multi_plain: this is\n    continued\n  colon_in: a:b\n  hash_in: a#b\n  url: http://example.org/x?y=1\n  percent: 50%\n  unicode: Ünïcödé\n  emoji: \"\\U0001F600\"\n  tabbed: \"a\tb\"\nanchors:\n  base: &base\n    font_color: 333333\n    font_size: 12\n  derived:\n    <<: *base\n    font_size: 14\n  list: &list [1, 2]\n  again: *list\n  multi:\n    <<: [*base, {font_style: bold, font_size: 9}]\nduplicate: 1\nother: 2\nduplicate: 3\n",
      ),
    ],
    Some(
      "base_font_size: 12\nscalar_bool_yes: true\nscalar_bool_no: false\nscalar_bool_on: true\nscalar_bool_off: false\nscalar_bool_true: true\nscalar_bool_false: false\nscalar_word_y: \"y\"\nscalar_word_n: \"n\"\nscalar_null_tilde: nil\nscalar_null_word: nil\nscalar_null_empty: nil\nscalar_int: 42\nscalar_int_plus: 12\nscalar_int_neg: -7\nscalar_int_octal: 511\nscalar_int_zero_octal: 0\nscalar_int_hex: 31\nscalar_int_bin: 5\nscalar_int_underscore: 1000\nscalar_int_comma: 1000\nscalar_not_octal: \"09\"\nscalar_sexagesimal: 5400\nscalar_sexagesimal_neg: -1800\nscalar_sexagesimal3: 3723\nscalar_sexagesimal_float: f5430.0\nscalar_not_sexagesimal: \"1.5:30\"\nscalar_float: f10.5\nscalar_float_dot: f1.0\nscalar_float_lead: f0.5\nscalar_float_exp: f100000.0\nscalar_float_exp_nodot: \"1e5\"\nscalar_float_exp_nosign: \"1.0e5\"\nscalar_float_dotexp: f100000.0\nscalar_float_under: f1000.5\nscalar_float_inf: fInfinity\nscalar_float_neginf: f-Infinity\nscalar_dot: \".\"\nscalar_minus_dot: \"-.\"\nscalar_hexish: \"5C6266\"\nscalar_hexish2: \"1E1E1E\"\nscalar_hexish3: \"428BCA\"\nscalar_digits6: 999999\nscalar_zeros6: 0\nscalar_mixed_zero: \"0000FF\"\nscalar_word: \"hello world\"\nscalar_short_word: \"abc\"\nscalar_dollar: \"$foo\"\nscalar_quoted_int: \"12\"\nscalar_dquoted: \"a\\u0009bé\"\nscalar_single: \"it's\"\nscalar_literal: \"line one\\u000aline two\\u000a\"\nscalar_folded: \"folded text\\u000a\"\nscalar_flow_seq: [1, \"two\", f3.5, nil]\nscalar_flow_map_a: 1\nscalar_flow_map_b: [\"x\", \"y\"]\nscalar_multi_plain: \"this is continued\"\nscalar_colon_in: \"a:b\"\nscalar_hash_in: \"a#b\"\nscalar_url: \"http://example.org/x?y=1\"\nscalar_percent: \"50%\"\nscalar_unicode: \"Ünïcödé\"\nscalar_emoji: \"😀\"\nscalar_tabbed: \"a\\u0009b\"\nanchors_base_font_color: hex\"333333\"\nanchors_base_font_size: 12\nanchors_derived_font_color: hex\"333333\"\nanchors_derived_font_size: 14\nanchors_list: [1, 2]\nanchors_again: [1, 2]\nanchors_multi_font_style: \"bold\"\nanchors_multi_font_size: 12\nanchors_multi_font_color: hex\"333333\"\nduplicate: 3\nother: 2\nbase_text_align: \"left\"\nbase_line_height: 1\nbase_font_color: \"000000\"\ncode_font_family: \"Courier\"\nconum_font_family: \"Courier\"\n__dir__: \"/extra\"",
    ),
    ["WARN: unknown variable reference in PDF theme: $foo"],
  )
}

