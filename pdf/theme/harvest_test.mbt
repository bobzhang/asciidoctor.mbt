///|
test "ruby: should not inherit from base theme if custom theme extends nil #1" {
  check_case(
    "load_theme",
    [Some("tmp-0-23-theme.yml"), Some("/tmp-themes")],
    [
      (
        "/tmp-themes/tmp-0-23-theme.yml", "extends: tmp-0-22-theme.yml\nheading:\n  font-family: $base-font-family\n",
      ),
      (
        "/tmp-themes/tmp-0-22-theme.yml", "extends: ~\nbase:\n  font-family: Times-Roman\n",
      ),
    ],
    Some(
      "base_font_size: 12\nbase_font_family: \"Times-Roman\"\nheading_font_family: \"Times-Roman\"\nbase_text_align: \"left\"\nbase_line_height: 1\nbase_font_color: \"000000\"\ncode_font_family: \"Courier\"\nconum_font_family: \"Courier\"\nabstract_title_font_family: \"Times-Roman\"\nsidebar_title_font_family: \"Times-Roman\"\n__dir__: \"/tmp-themes\"",
    ),
    [],
  )
}

