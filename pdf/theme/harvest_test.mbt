d\"\nadmonition_label_text_transform: \"uppercase\"\nquote_border_left_width: 4\nquote_padding: [3, 12, 3, 14]\nverse_border_left_width: 4\nverse_padding: 5\ncode_font_family: \"Courier\"\ncode_font_size: f10.8\ncode_line_height: f1.2\ncode_padding: 9\ncode_border_width: f0.5\nconum_line_height: f1.15\nconum_glyphs: \"circled\"\nexample_background_color: \"FFFFFF\"\nexample_border_width: f0.5\nexample_padding: [12, 12, 12]\nimage_align: \"left\"\nprose_margin_bottom: 12\nsidebar_background_color: \"EEEEEE\"\nsidebar_border_width: f0.5\nsidebar_padding: [12, nil, 12]\nsidebar_title_align: \"center\"\nsidebar_title_font_style: \"bold\"\ntable_border_style: \"solid\"\ntable_border_width: f0.5\ntable_cell_padding: 2\ntable_head_font_style: \"bold\"\ntable_head_border_bottom_width: f1.25\ntable_body_stripe_background_color: \"EEEEEE\"\nthematic_break_border_style: \"solid\"\nthematic_break_border_width: f0.5\nthematic_break_padding: 0\ntoc_indent: 15\ntoc_line_height: f1.4\nfootnotes_font_size: 9\nfootnotes_item_spacing: 3\nfooter_border_width: f0.5\nfooter_font_size: 10\nfooter_height: 30\nfooter_recto_right_content: \"{page-number}\"\nfooter_verso_left_content: \"{page-number}\"\n__dir__: \"/extra\"\nparent_font_dir: \"/opt/fonts\"\nparent_fallback: \"Noto Emoji\"\nheading_font_color: hex\"222222\"\nheading_h2_text_align: \"center\"\nquote_font_color: hex\"555555\"\nkbd_border_color: hex\"CCCCCC\"\ntable_caption_end: \"top\"\nconum_font_family: hex\"CCCCCC\"",
