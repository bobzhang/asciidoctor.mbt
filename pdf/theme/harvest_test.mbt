///|
test "ruby: should not fail to merge font catalog if inherited theme does not define a font catalog #1" {
  check_case(
    "load_file",
    [Some("/tmp-themes/tmp-0-20-theme.yml"), Some("/tmp-themes")],
    [
      (
        "/tmp-themes/tmp-0-20-theme.yml", "extends: tmp-0-19-theme.yml\nfont:\n  catalog:\n    merge: true\n    M+ 1p:\n      normal: /path/to/mplus1p-regular.ttf\n    VLGothic:\n      normal: &VLGothic /path/to/vlgothic-regular.ttf\n      bold: *VLGothic\n      italic: *VLGothic\n      bold_italic: *VLGothic\n  fallbacks:\n  - VLGothic\nbase:\n  font_family: M+ 1p\n",
      ),
      (
        "/tmp-themes/tmp-0-19-theme.yml", "extends: ~\nbase:\n  font_family: Times-Roman\n",
      ),
    ],
    Some(
      "base_font_family: \"M+ 1p\"\nfont_catalog: {\"M+ 1p\" => {\"normal\" => \"/path/to/mplus1p-regular.ttf\"}, \"VLGothic\" => {\"normal\" => \"/path/to/vlgothic-regular.ttf\", \"bold\" => \"/path/to/vlgothic-regular.ttf\", \"italic\" => \"/path/to/vlgothic-regular.ttf\", \"bold_italic\" => \"/path/to/vlgothic-regular.ttf\"}}\nfont_fallbacks: [\"VLGothic\"]",
    ),
    [],
  )
}

