      "base_font_size: 12\ncolor_hash_six: \"FF0000\"\ncolor_hash_three: \"f00\"\ncolor_hash_quoted: \"00ff00\"\ncolor_hash_dquoted: \"0000ff\"\ncolor_hash_comment: \"abcdef\"\ncolor_plain_six: 336699\ncolor_plain_zeros: 0\ncolor_plain_digits: 123456\ncolor_plain_three: 123\ncolor_plain_mixed: \"5C6266\"\ncolor_quoted_three: \"abc\"\ncolor_four: 1234\ncolor_two: \"ff\"\ncolor_eight: 11223344\ncolor_transparent_color: transparent\ncolor_null_color: nil\ncolor_tilde_color: nil\ncolor_rgb_color: hex\"FF8000\"\ncolor_rgb_float_color: hex\"FF0100\"\ncolor_cmyk_color: cmyk[0, 50, 100, 100]\ncolor_cmyk_pct_color: cmyk[50, 0, 100, 25]\ncolor_cmyk_zero_color: hex\"FFFFFF\"\ncolor_cmyk_full_color: hex\"000000\"\ncolor_nonsense_color: hex\"000012\"\ncolor_bool_color: hex\"00TRUE\"\ncolor_float_color: hex\"11..55\"\ncolor_var_color: hex\"336699\"\ncolor_interp_color: hex\"00ABFF\"\nnot_color_size: 123\nnot_color_quoted_size: 123\nnot_color_hash_size: \"123\"\nnot_color_word: \"abcdef\"\ntable_border_color: [hex\"DDDDDD\", hex\"EEEEEE\", hex\"333333\"]\ntable_grid_color: [hex\"DDDDDD\", hex\"CCCCCC\"]\ntable_grid_single_color: hex\"DDDDDD\"\nrole_red_font_color: hex\"FF0000\"\nrole_red_text_align: \"center\"\nrole_blue_font_color: hex\"0000FF\"\nrole_blue_text_align: \"right\"\nrole_my-role_font_color: hex\"123456\"\nrole_my-role_background_color: hex\"FFFFFF\"\nadmonition_icon_tip: {:name => \"far-lightbulb\", :stroke_color => hex\"FFFF00\", :size => 48}\nadmonition_icon_note: {:name => {:name => \"far-lightbulb\", :stroke_color => hex\"FFFF00\", :size => 48}}\nbase_text_align: \"left\"\nbase_line_height: 1\nbase_font_color: \"000000\"\ncode_font_family: \"Courier\"\nconum_font_family: \"Courier\"\n__dir__: \"/extra\"",
